@model ECCSA.BackOffice.Server.WebApp.Areas.Membership.Model.IndividualViewModel

<link href="~/vendor/combotree/style.css" rel="stylesheet" />
<div class="modal-header">
    <h5 class="modal-title"> "Record Payment"  </h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <form data-parsley-validate novalidate method="post" enctype="multipart/form-data"
          asp-action="Payment" asp-antiforgery="true">
        <input type="hidden" asp-for="Payment.Id" />
        <input type="hidden" asp-for="Payment.InvoiceId" />
        <input type="hidden" asp-for="TheModel.Id" />
        
        
        

        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Receipt No
            </label>
            <input type="text" maxlength="50" class="form-control col-sm-8 col-md-9" asp-for="Payment.ReceiptNo" required />
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Amount Paid
            </label>
            <input type="number"  min="1" class="form-control col-sm-8 col-md-9" asp-for="Payment.AmountPaid" required />
        </div>

        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Remark
            </label>
            <input type="text" maxlength="200" class="form-control col-sm-8 col-md-9" asp-for="Payment.Remark" />
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Payment Method
            </label>
            <select class="custom-select col-sm-8 col-md-9"
                    asp-for="Payment.PaymentMethod" asp-items="@(Html.GetEnumSelectList<ECCSA.BackOffice.Server.Model.Common.PaymentMethodEnum>())"  required>
               
            </select>
        </div>

        



        <div class="row form-group">
            <div class="col-sm-12">
                <input type="submit" value="Save"
                       class="btn btn-primary">

            </div>
        </div>
    </form>


    
</div>
