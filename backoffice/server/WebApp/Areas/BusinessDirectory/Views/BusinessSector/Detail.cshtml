@model ECCSA.BackOffice.Server.WebApp.Areas.BusinessDirectory.Model.BusinessSectorViewModel

@{
    ViewData["Title"] = "Business Sector Companies";
    Layout = "~/Views/Shared/_MembershipLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-6">
            <h4>@Model.Name : <small>@Model.TheModel.Name</small></h4>
        </div>
        <div class="col-6">
            <div class="d-sm-flex align-items-center justify-content-between mb-4 float-right">
                <a href="@Url.Action("Index","BusinessSector",new { Area ="BusinessDirectory", id=@Model.TheModel.ParentId})" class="btn btn-outline-info"><i class="fa fa-angle-double-left" aria-hidden="true"></i>back</a>
            </div>
        </div>
    </div>





    <div class="row">
        <div class="col-6">
            <div class="row d-sm-flex align-items-center justify-content-between" style="margin-left:15px;margin-bottom:2px;">
                <div class="btn-group" role="group" aria-label="Basic example">
                    <button class="d-none d-sm-inline-block btn btn-sm btn-outline-primary shadow-sm"
                            data-toggle="modal"
                            data-target="#theModal"
                            title="Import Individuals">
                        <i class="fa fa-file-excel-o"></i> Import From Excel
                    </button>
                    <a class="btn btn-sm btn-outline-info" asp-action="DownLoadCompanyImportTemplate">Download Template</a>
                </div>
            </div>
            <div class="card shadow mb-4">
                <div class="card-header">
                    Temporary Import List <br />  Map by:

                    <input type="radio" id="radTel" name="match_by" value="Telephone" />  <label for="radTel">Telephone</label>
                    <input type="radio" id="radMob" name="match_by" value="Mobile" checked />  <label for="radMob">Mobile</label>
                </div>
                <div class="card-body">
                    <form data-parsley-validate novalidate method="post" enctype="multipart/form-data"
                          asp-action="MoveTempCompany" asp-antiforgery="true">
                        <input type="hidden" name="sectorId" value="@Model.TheModel.Id" />
                        <div class="table-responsive">
                            <table class="table table-bordered" id="dataTable1" width="100%" cellpadding="0">
                                <thead>
                                    <tr>
                                        <th><input type="checkbox" id="select-all" /> All </th>
                                        <th> Name</th>
                                        <th>Telephone</th>
                                        <th>Mobile</th>

                                        <th>
                                            <div class="btn-group" role="group" aria-label="Basic example">
                                                <input type="submit" value="Move >>" class="btn btn-sm btn-outline-primary shadow-sm"
                                                       title="Move Data" />

                                            </div>
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var item in Model.TheModel.TempCompanies)
                                    {
                                        var c = item;
                                        c.NewId = c.Id;
                                        var ckName = "CK" + Model.Guid2String(c.Id);
                                        var selectName = "S" + Model.Guid2String(c.Id);
                                        <tr>
                                            <td><input type="checkbox" id="@ckName" value="@c.NewId" name="@ckName" /> </td>
                                            <td>


                                                @Html.DisplayFor(modelItem => c.Name)


                                            </td>
                                            <td>@c.Telephone</td>
                                            <td>@c.Mobile</td>
                                            <td>
                                                <div class="btn-group" role="group" aria-label="Basic example">
                                                    @if (c.TempList.Count > 0)
                                                    {
                                                        <select class="custom-select " id="@selectName" name="@selectName"
                                                        asp-items="@(new SelectList(c.TempList,"Id", "Name"))" onchange="associate('@ckName', this);">
                                                            <option value="00000000-0000-0000-0000-000000000000"></option>
                                                        </select>
                                                    }


                                                </div>


                                            </td>
                                        </tr>
                                    }

                                </tbody>
                            </table>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-6">

            <div class="row d-sm-flex align-items-center justify-content-between" style="margin-left:15px;margin-bottom:2px;">
                <div class=" btn-group" role="group" aria-label="Basic example">



                    <button class="d-none d-sm-inline-block btn btn-sm btn-outline-primary shadow-sm"
                            data-toggle="modal"
                            data-target="#AddCompanyModal"
                            title="Add New Company">
                        <i class="fas fa-plus fa-sm text-white-50"></i> Add New Company
                    </button>
                </div>
            </div>
            <div class="card shadow mb-4">
                <div class="card-header">Companies</div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="dataTable" width="100%" cellpadding="0">
                            <thead>
                                <tr>
                                    <th> Name</th>
                                    <th>Telephone</th>
                                    <th>Mobile</th>

                                    <th></th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th> Name</th>
                                    <th>Telephone</th>
                                    <th>Mobile</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                            <tbody>
                                @foreach (var item in Model.TheModel.BusinessSectors)
                                {
                                    var c = item.Company;

                                    <tr>
                                        <td>

                                            <a asp-controller="BusinessSector" asp-action="CompanyDetail" asp-route-id="@c.Id" class="title ">
                                                @Html.DisplayFor(modelItem => c.Name)
                                            </a>

                                        </td>
                                        <td>@c.Telephone</td>
                                        <td>@c.Mobile</td>
                                        <td>
                                            <div class="btn-group" role="group" aria-label="Basic example">
                                                <a onclick="return confirmDelete($('#deleteCompanySector@(Model.Guid2String(item.Id))')[0]);"
                                               class=" btn btn-sm btn-outline-danger">
                                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                                </a>
                                                <form data-parsley-validate novalidate method="post"
                                                  id="deleteCompanySector@(Model.Guid2String(item.Id))"
                                                  asp-action="DeleteMembership" asp-antiforgery="true">
                                                    <input type="hidden" name="sectorId" value="@item.SectorId" />
                                                    <input type="hidden" name="companyId" value="@item.CompanyId" />
                                                    <input type="hidden" name="fromCompany" value="false" />

                                                </form>
                                                <a class=" btn btn-sm  btn-outline-info" asp-controller="BusinessSector" asp-action="CompanyDetail" asp-route-id="@c.Id"
                                               asp-route-sectorid="@Model.SectorId">
                                                    <i class="fa fa-info" aria-hidden="true"></i>
                                                </a>

                                            </div>


                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>



</div>

<div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="AddBusinessSectorModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New @Model.Name Business Sector </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form data-parsley-validate novalidate method="post" enctype="multipart/form-data"
                      asp-action="SaveSector" asp-antiforgery="true">
                    <input type="hidden" asp-for="TheModel.Id" />
                    <input type="hidden" asp-for="TheModel.ParentId" value="@Model.SectorId" />


                    <div class="row form-group">
                        <label class="col-sm-2 col-md-1 col-form-label">
                            Name
                        </label>
                        <input type="text" maxlength="100" class="form-control col-sm-9 col-md-10" asp-for="TheModel.Name" />
                    </div>





                    <div class="row form-group">
                        <div class="col-sm-12">
                            <input type="submit" value="Save"
                                   class="btn btn-primary">

                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="theModal">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="idTitle"> Import Data    </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form data-parsley-validate novalidate method="post" enctype="multipart/form-data"
                      asp-action="ImportCompanies" asp-antiforgery="true">
                    <input type="hidden" name="sectorId" value="@Model.TheModel.Id" />





                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">Excel</label>
                        <input type="file" name="file" placeholder="Import companies" class="form-control-file form-control col-sm-8 col-md-8" />
                    </div>



                    <div class="row form-group">
                        <div class="col-sm-12">
                            <input type="submit" value="Save"
                                   class="btn btn-primary">

                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="AddCompanyModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Company in @Model.TheModel.Name  </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form data-parsley-validate novalidate method="post" enctype="multipart/form-data"
                      asp-action="SaveCompany" asp-antiforgery="true">
                    <input type="hidden" name="Id" value="@Guid.Empty" />
                    <input type="hidden" name="sectorId" value="@Model.TheModel.Id" />
                    <div class="row form-group">
                        <label class="col-sm-2 col-md-3 col-form-label">
                            Name
                        </label>
                        <input type="text" maxlength="100" name="Name" class="form-control col-sm-9 col-md-9" />
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Telephone
                        </label>
                        <input type="text" maxlength="100" name="Telephone" class="form-control col-sm-8 col-md-9" />
                    </div>

                    <div class="row form-group">
                        <label class="col-sm-2 col-md-3 col-form-label">
                            Mobile
                        </label>
                        <input type="text" maxlength="100" class="form-control col-sm-9 col-md-9" name="Mobile" />
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Fax
                        </label>
                        <input type="text" maxlength="100" name="Fax" class="form-control col-sm-8 col-md-9" />
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Email
                        </label>
                        <input type="email" maxlength="100" name="Email" id="labelRequirement" class="form-control col-sm-8 col-md-9" />
                    </div>

                    <div class="row form-group">
                        <label class="col-sm-2 col-md-3 col-form-label">
                            PoBox
                        </label>
                        <input type="text" maxlength="100" class="form-control col-sm-9 col-md-9" name="PoBox" />
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Web
                        </label>
                        <input type="text" maxlength="100" name="Web" class="form-control col-sm-8 col-md-9" />
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Logo
                        </label>
                        <input type="file" name="logo" class="form-control col-sm-8 col-md-9" />
                    </div>
                    <div class="row form-group">
                        <div class="col-sm-12">
                            <input type="submit" value="Save"
                                   class="btn btn-primary">

                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
@section script {

<script src="/js/comboTreePlugin.js" type="text/javascript"></script>
<script>

     function confirmDelete(form) {
        $.confirm({
            icon: 'fa fa-exclamation-triangle',
            title: 'Confirm!',
            content: 'Are you sure want to Delete ?',
            buttons: {
                yes: function () {
                    form.submit();
                },
                no: function () {
                }
            }
        });
        return false;
    }
</script>
<script>

            document.getElementById('select-all').onclick = function() {
        var checkboxes = document.querySelectorAll('input[type="checkbox"]');
        for (var checkbox of checkboxes) {
            checkbox.checked = this.checked;
        }
    }
            function associate(chkId, e){

                const chkBox = document.getElementById(chkId);
                chkBox.value = e.value;

            }
</script>
}