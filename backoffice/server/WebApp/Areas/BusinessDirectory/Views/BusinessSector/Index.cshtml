@model ECCSA.BackOffice.Server.WebApp.Areas.BusinessDirectory.Model.BusinessSectorViewModel

@{
    ViewData["Title"] = "Business Sectors";
    Layout = "~/Views/Shared/_MembershipLayout.cshtml";
    var root = Model.SectorId == Guid.Empty;
    var countName = root ? "Sub Sectors" : "Companies";
}

<div class="container-fluid">

    <div class="row d-sm-flex align-items-center justify-content-between " style="margin-top:4px;margin-left:15px;margin-bottom:4px;margin-right:15px;">

        Sectors @if (Model.SectorId != Guid.Empty)
        {
           <strong>@Model.Name </strong> 
           <a asp-controller="BusinessSector" asp-action="Index" asp-route-id="@Guid.Empty" class="btn small btn-outline-secondary">
                                                    &lt;&lt; Back
                                                </a>
            
        }

    </div>
    <div class="row d-sm-flex align-items-center justify-content-between" style="margin-left:15px;margin-bottom:2px;">
        <div class=" btn-group" role="group" aria-label="Basic example">



            <button class="d-none d-sm-inline-block btn btn-sm btn-outline-primary shadow-sm"
                    data-toggle="modal"
                    data-target="#AddBusinessSectorModal"
                    title="Add New Business Sector">
                <i class="fas fa-plus fa-sm text-white-50"></i> Add New
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-12">

            <div class="card shadow mb-4">

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="dataTable" width="100%" cellpadding="0">
                            <thead>
                                <tr>
                                    <th> Name</th>
                                    <th> @countName</th>


                                    <th></th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th> Name</th>
                                    <th>@countName</th>

                                    <th></th>
                                </tr>
                            </tfoot>
                            <tbody>
                                @foreach (var item in Model.TheList)
                                {


                                    <tr>
                                        <td>
                                            @if (root)
                                            {
                                                <a asp-controller="BusinessSector" asp-action="Index" asp-route-id="@item.Id" class="title ">
                                                    @Html.DisplayFor(modelItem => item.Name)
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-controller="BusinessSector" asp-action="Detail" asp-route-id="@item.Id" class="title ">
                                                    @Html.DisplayFor(modelItem => item.Name)
                                                </a>
                                            }
                                        </td>
                                        <td>@(root? item.SubSectors.Count: item.BusinessSectors.Count) </td>

                                        <td>
                                            <div class="btn-group" role="group" aria-label="Basic example">
                                                @if (root)
                                                {
                                                    if (item.SubSectors.Count == 0)
                                                    {
                                                        <a onclick="return confirmDelete($('#deleteSector@(Model.Guid2String(item.Id))')[0]);"
                                               class=" btn btn-sm btn-outline-danger">
                                                            <i class="fa fa-trash" aria-hidden="true"></i>
                                                        </a>
                                                        <form data-parsley-validate novalidate method="post" id="deleteSector@(Model.Guid2String(item.Id))"
                                                  asp-action="DeleteSector" asp-antiforgery="true">
                                                            <input type="hidden" name="sectorId" value="@item.Id" />

                                                        </form>
                                                    }
                                                  

                                                }
                                                else
                                                {
                                                    if (item.BusinessSectors.Count == 0)
                                                    {
                                                        <a onclick="return confirmDelete($('#deleteSector@(Model.Guid2String(item.Id))')[0]);"
                                               class=" btn btn-sm btn-outline-danger">
                                                            <i class="fa fa-trash" aria-hidden="true"></i>
                                                        </a>
                                                        <form data-parsley-validate novalidate method="post" id="deleteSector@(Model.Guid2String(item.Id))"
                                                  asp-action="DeleteSector" asp-antiforgery="true">
                                                            <input type="hidden" name="sectorId" value="@item.Id" />

                                                        </form>
                                                    }
                                                   
                                                }




                                            </div>


                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>



</div>
<div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="AddBusinessSectorModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New @Model.Name Business Sector </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form data-parsley-validate novalidate method="post" enctype="multipart/form-data"
                      asp-action="SaveSector" asp-antiforgery="true">
                    <input type="hidden" name="Id" value="@Guid.Empty" />
                    <input type="hidden" name="ParentId" value="@Model.SectorId" />


                    <div class="row form-group">
                        <label class="col-sm-2 col-md-1 col-form-label">
                            Name
                        </label>
                        <input type="text" maxlength="100" class="form-control col-sm-9 col-md-10" name="Name" />
                    </div>





                    <div class="row form-group">
                        <div class="col-sm-12">
                            <input type="submit" value="Save"
                                   class="btn btn-primary">

                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section script {


<script>



    function confirmDelete(form) {
        $.confirm({
            icon: 'fa fa-exclamation-triangle',
            title: 'Confirm!',
            content: 'Are you sure want to Delete ?',
            buttons: {
                yes: function () {
                    form.submit();
                },
                no: function () {
                }
            }
        });
        return false;
    }
</script>
}