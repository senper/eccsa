@model ECCSA.BackOffice.Server.WebApp.Areas.Academy.Model.AcademyDashboardViewModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AcademyLayout.cshtml";
}

<link rel="stylesheet" type="text/css" href="~/css/nv-d3/nv.d3.css" />

<style>
    #piechartdiv {
        width: 100%;
        height: 250px;
    }

    #chartdiv {
        width: 100%;
        height: 500px;
    }
</style>

<div class="container-fluid">

    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Dashboard</h1>
    </div>

    <!-- Content Row -->


    <div class="row">

        <!-- Earnings (Monthly) Card Example -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Topic Categories
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@(Model.CategoriesCount)</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-bars fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Earnings (Monthly) Card Example -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Topics
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@(Model.TopicsCount)</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-book fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Earnings (Monthly) Card Example -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Active Trainings
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@(Model.TrainingsCount)</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-book-reader fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Requests Card Example -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Total Registrations
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@(Model.RegistrationsCount)</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Row -->

    <div class="row">

        <!-- Area Chart -->
        <div class="col-xl-8 col-lg-7">
            <div class="card shadow mb-4">
                <!-- Card Header - Dropdown -->
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary"> Trainings by @Model.Summary.L1Label > @Model.Summary.L2Label > @Model.Summary.L3Label</h6>
                    @*<div class="dropdown no-arrow">
                            <a class="dropdown-toggle" href="#" role="button" id="dropdownMenuLink"
                               data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fas fa-ellipsis-v fa-sm fa-fw text-gray-400"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-right shadow animated--fade-in"
                                 aria-labelledby="dropdownMenuLink">
                                <div class="dropdown-header">Dropdown Header:</div>
                                <a class="dropdown-item" href="#">Action</a>
                                <a class="dropdown-item" href="#">Another action</a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="#">Something else here</a>
                            </div>
                        </div>*@
                </div>
                <!-- Card Body -->
                <div class="card-body">
                    <div class="card-body d-none" id="empPiechartdiv">

                    </div>
                    <div class="card-body" id="pieChart">
                        <svg></svg>
                    </div>
                    <div class=" panel-footer">
                        <strong><label id="pieChartNav"></label></strong>
                    </div>
                </div>
            </div>
        </div>

        <input type="hidden" id="summaryJson" value="@Model.SummaryJson" />
        <input type="hidden" id="l1Json" value="@Model.L1Json" />
        <input type="hidden" id="l2Json" value="@Model.L2Json" />
        <!-- Pie Chart -->
        <div class="col-xl-4 col-lg-5">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary"> @Model.CurrentPeriodName Performance </h6>
                </div>
                <div class="card-body">
                    @foreach (var p in @Model.Performances)
                    {
                        <h4 class="small font-weight-bold">
                            @p.Name <span class="float-right">@p.Value%</span>
                        </h4>
                        <div class="progress mb-4">
                            <div class="progress-bar" role="progressbar" style="width: @p.BarWidth%; background-color: @p.Color"
                             aria-valuenow="@p.Value" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>

@section script {
    <script src="~/vendor/nv-d3/d3.v3.js"></script>
    <script src="~/vendor/nv-d3/nv.d3.js"></script>
    <script src="~/js/chartConfig.js"></script>

    <script>

        var key1 = "";
        var key2 = "";
        var key3 = "";
        var level = 1;

        $(document).on("click", "#pieChart svg", function (e) {
            if (e.target._current == null) { return; }
            var cValue = e.target._current.data.key;
            if (level == 1) {
                key1 = cValue;
                level = 2;
                var tmp = JSON.parse($('#l2Json').val());
                var data = tmp.filter(d => d.L1 === cValue);
                if (data.length <= 0) return;
                var data2 = copyJson(data, 'L2');
                DrawPieDrillDown(data2);
                $('#pieChartNav').html(cValue);
            }
            else if (level == 2) {
                key2 = cValue;
                level = 3;
                var tmp = JSON.parse($('#summaryJson').val());
                var data = tmp.filter(d => d.L1 === key1).filter(d => d.L2 === key2);
                if (data.length <= 0) return;
                var data2 = copyJson(data, 'L3');
                DrawPieDrillDown(data2);
                $('#pieChartNav').html(key1 + " > " + key2);
            }
            else {
                key1 = key2 = key3 = "";
                level = 1;
                var data = copyJson(JSON.parse($('#l1Json').val()));
                DrawPieDrillDown(data);
                $('#pieChartNav').html("");
            }


        });

        function DrawPieDrillDown(data) {

            if (data.length == 0) {

                $('#pieChartNav').html("");
            }
            //tabulate(data, 'pieChartData', ["key", "y"]);
            defaultPieChart("pieChart", data, "", false, true);


        }

        var data = copyJson(JSON.parse($('#l1Json').val()));

        //tabulate(data, 'pieChartData', ["key", "y"]);
        defaultPieChart("pieChart", data, "", false, true);

        function copyJson(data, key) {
            var innArr = [];
            for (var i = 0; i < data.length; i++) {
                var keyValue = data[i].L1;
                if (key == "L2") {
                    keyValue = data[i].L2;
                } else if (key == "L3") {
                    keyValue = data[i].L3;
                }
                innArr.push({
                    "key": keyValue,
                    "y": data[i].No
                });
            }

            return innArr;
        }
    </script>

}