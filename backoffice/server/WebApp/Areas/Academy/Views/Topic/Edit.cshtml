@model ECCSA.BackOffice.Server.WebApp.Areas.Academy.Model.TopicViewModel


<div class="modal-header">
    <h5 class="modal-title">@(Model.TheModel.Id == Guid.Empty ? "Add" : "Edit") Topic</h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <form data-parsley-validate method="post"
          asp-action="@(Model.TheModel.Id == Guid.Empty ? "CreateTopic" : "UpdateTopic")" asp-antiforgery="true">
        <input type="hidden" asp-for="TheModel.Id" />
        <div class="row form-group">
            <label for="Code" class="col-sm-4 col-md-3 col-form-label">
                Code
            </label>
            <input type="text" class="form-control col-sm-7 col-md-8" asp-for="TheModel.Code" required/>
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Name
            </label>
            <input type="text" class="form-control col-sm-7 col-md-8" asp-for="TheModel.NameEng" required placeholder="Name  " />
        </div>
        <div class="row form-group" style="display: none;">
            <label class="col-sm-4 col-md-3 col-form-label">
                ስም
            </label>
            <input type="text" class="form-control col-sm-7 col-md-8" asp-for="TheModel.NameLocal" placeholder="ስም  " />
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Category
            </label>
            <select class="custom-select col-sm-7 col-md-8" asp-for="TheModel.CategoryId" required
                    asp-items="@(new SelectList(Model.CategoryLookup,"Id", "Name", Model.TheModel.CategoryId, "Parent"))"></select>
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Description
            </label>
            <textarea class="form-control col-sm-7 col-md-8" asp-for="TheModel.Decription" placeholder="Decription  " required></textarea>
        </div>
        <div class="row form-group" style="display: none;">
            <label class="col-sm-4 col-md-3 col-form-label">
                ማብራርያ
            </label>
            <textarea class="form-control col-sm-7 col-md-8" asp-for="TheModel.DecriptionLocal" placeholder="ማብራርያ  "></textarea>
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Status
            </label>
            <select class="custom-select col-sm-7 col-md-8" asp-for="TheModel.Status" required>
                <option value="1">Active</option>
                <option value="2">Inactive</option>
            </select>
        </div>
        <div class="row form-group">
            <div class="col-sm-12">
                <input type="submit" value="Save"
                       class="btn btn-primary">

            </div>
        </div>
    </form>
</div>

