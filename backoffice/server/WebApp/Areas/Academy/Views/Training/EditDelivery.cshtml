@model ECCSA.BackOffice.Server.WebApp.Areas.Academy.Model.DeliveryViewModel
@using ECCSA.BackOffice.Server.Model.Academy

<div class="modal-header">
    <h5 class="modal-title">@(Model.TheModel.Id == Guid.Empty ? "Add" : "Edit") Resource Delivery</h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <form data-parsley-validate method="post" enctype="multipart/form-data"
          asp-action="@(Model.TheModel.Id == Guid.Empty ? "CreateDelivery" : "UpdateDelivery")" asp-antiforgery="true">
        <input type="hidden" asp-for="TheModel.Id" />
        <input type="hidden" asp-for="TheModel.RegistrationId" />
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Resource
            </label>
            <select class="custom-select col-sm-7 col-md-8" asp-for="TheModel.ResourceId"
                    asp-items="@(new SelectList(Model.ResourcesLookup,"Id", "Name"))" required></select>
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Delivery Method
            </label>
            <select class="custom-select col-sm-7 col-md-8" asp-for="TheModel.DeliveryMethod" id="deliveryMethod"
                    asp-items="@(Html.GetEnumSelectList<DeliveryMethod>())" required></select>
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Delivery Date
            </label>
            <input type="date" max="@(DateTime.Today.ToString("yyyy-MM-dd"))" class="form-control col-sm-7 col-md-8" asp-for="TheModel.DeliveryDate" required />
        </div>
        <div class="row form-group">
            <div class="col-sm-12">
                <input type="submit" value="Save"
                       class="btn btn-primary">

            </div>
        </div>
    </form>
</div>

