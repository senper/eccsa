@model ECCSA.BackOffice.Server.WebApp.Areas.Academy.Model.TrainingViewModel


<div class="modal-header">
    <h5 class="modal-title">@(Model.TheModel.Id == Guid.Empty ? "Add" : "Edit") Training</h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <form data-parsley-validate method="post"
          asp-action="@(Model.TheModel.Id == Guid.Empty ? "CreateTraining" : "UpdateTraining")" asp-antiforgery="true">
        <input type="hidden" asp-for="TheModel.Id" />
        <input type="hidden" asp-for="TheModel.TopicId" />
        <input type="hidden" asp-for="TheModel.ServiceTypeId" />

        <div class="row form-group">
            <label for="Code" class="col-sm-4 col-md-3 col-form-label">
                Topic
            </label>
            <input type="text" class="form-control col-sm-7 col-md-8"
                   value="@($"{Model.TheModel.Topic.Code} - {Model.TheModel.Topic.NameEng} ( {Model.TheModel.Topic.NameLocal} )")" readonly />
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Start Date
            </label>
            <input type="date" class="form-control col-sm-7 col-md-8" asp-for="TheModel.StartDate" required />
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                End Date
            </label>
            <input type="date" class="form-control col-sm-7 col-md-8" asp-for="TheModel.EndDate" required />
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Session(s)
            </label>
            <div class=" col-sm-7 col-md-8 form-control">
                <input type="checkbox" asp-for="TheModel.HasMorning" /> Morning
                <input type="checkbox" asp-for="TheModel.HasAfternoon" />  Afternoon
                <input type="checkbox" asp-for="TheModel.HasEvening" />  Evening
            </div>
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Address
            </label>
            <input type="text" class="form-control col-sm-7 col-md-8" asp-for="TheModel.Schedule" required />
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Instructor
            </label>
            <input type="text" class="form-control col-sm-7 col-md-8" asp-for="TheModel.Instructor" required />
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Instruction Media
            </label>
            <select class="custom-select col-sm-7 col-md-8" asp-for="TheModel.InstructionMedia"
                    asp-items="@(Html.GetEnumSelectList<ECCSA.BackOffice.Server.Model.Academy.InstructionMedia>())" required></select>
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Rate Basis
            </label>
            <select class="custom-select col-sm-8 col-md-9" required asp-for="TheModel.RateBasis" id="rateBasis" onchange="onRateChanged();">
                <option value="0"> </option>
                <option value="5">Flat</option>
                <option value="4">Membership</option>

            </select>
        </div>
        <div class="row form-group" id="memberRate">
            <label class="col-sm-4 col-md-3 col-form-label">
                Member Fee
            </label>
            <div class="input-group col-sm-7 col-md-8" style="padding-left: 0px; padding-right: 0px;">
                <input type="number" min="0" max="100000" step="any" class="form-control" asp-for="TheModel.MemberFee" required />
                <div class="input-group-append">
                    <span class="input-group-text" id="basic-addon2">Birr</span>
                </div>
            </div>
        </div>
        <div class="row form-group  member flat " id="otherRate">
            <label class="col-sm-4 col-md-3 col-form-label" id="otherLabel" >
                Others
            </label>
            <label class="col-sm-4 col-md-3 col-form-label" id="flatRate" style="display:none;">
                Rate
            </label>
            <div class="input-group col-sm-7 col-md-8" style="padding-left: 0px; padding-right: 0px;">
                <input type="number" min="0" max="100000" step="any" class="form-control" asp-for="TheModel.NonMemberFee" required />
                <div class="input-group-append">
                    <span class="input-group-text" id="basic-addon2">Birr</span>
                </div>
            </div>
        </div>
        <div class="row form-group">
            <div class="col-sm-12">
                <input type="submit" value="Save"
                       class="btn btn-primary">

            </div>
        </div>
    </form>
</div>

@section script {
    
}