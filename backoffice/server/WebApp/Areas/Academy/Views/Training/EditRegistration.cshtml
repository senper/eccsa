@model ECCSA.BackOffice.Server.WebApp.Areas.Academy.Model.RegistrationViewModel

<div class="modal-header">
    <h5 class="modal-title">@(Model.TheModel.Id == Guid.Empty ? "Add" : "Edit") Registration</h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <form data-parsley-validate method="post" enctype="multipart/form-data"
          asp-action="@(Model.TheModel.Id == Guid.Empty ? "CreateRegistration" : "UpdateRegistration")" asp-antiforgery="true">
        <input type="hidden" asp-for="TheModel.Id" />
        <input type="hidden" asp-for="TheModel.TrainingId" />
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Sponsor
            </label>
            <select class="custom-select col-sm-7 col-md-8" asp-for="TheModel.TrainingSponsorId" 
                    asp-items="@(new SelectList(Model.SponsorsLookup,"Id", "Name"))" required>
                <option>Self</option>
            </select>
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Full Name
            </label>
            <input type="text" class="form-control col-sm-7 col-md-8" asp-for="TheModel.FullName" required />
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Email
            </label>
            <input type="email" class="form-control col-sm-7 col-md-8" asp-for="TheModel.EmailAddress" required />
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Mobile No.
            </label>
            <input type="text" class="form-control col-sm-7 col-md-8" asp-for="TheModel.MobileNo" required id="editRegistrationMobileNo"/>
            <div id="phone_error" style="color:red;display:none ;background-size:80%; ">Please enter a valid phone number</div>

        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Registration Date
            </label>
            <input type="date" max="@(DateTime.Today.ToString("yyyy-MM-dd"))" class="form-control col-sm-7 col-md-8" asp-for="TheModel.RegistrationDate" required />
        </div>
        <div class="row form-group d-none">
            <label class="col-sm-4 col-md-3 col-form-label">
                Discount Category
            </label>
            <select class="custom-select col-sm-7 col-md-8" asp-for="TheModel.DiscountCategory" 
                    asp-items="@(new SelectList(Model.DiscountCategory,"Id", "Name"))" required></select>
        </div>
        <div class="row form-group">
            <div class="col-sm-12">
                <input type="submit" value="Save"
                       class="btn btn-primary">

            </div>
        </div>
    </form>
</div>

