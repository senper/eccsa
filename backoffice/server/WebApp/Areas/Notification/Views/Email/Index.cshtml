@using ECCSA.BackOffice.Server.Model.Common
@model ECCSA.BackOffice.Server.WebApp.Areas.Notification.Model.EmailMessageViewModel

@{
    ViewData["Title"] = Model.PageTitle;
    Layout = Model.LayoutPage;
}

<div class="container-fluid">

    <div class="row d-sm-flex align-items-center justify-content-between" style="margin-left:15px;margin-bottom:2px;">
        <div class="col-md-5" style="margin-left:15px;margin-bottom:2px;">
            <form method="get" asp-action="Index">
                <input type="hidden" name="module" value="@Model.CurrentModule" />
                <div class="btn-group pull-left" role="group" aria-label="Basic example">
                    Search By &nbsp;&nbsp;<select name="SearchStatus" asp-for="@Model.Status"
                                                  asp-items="@(Html.GetEnumSelectList<MessageStatus>())"></select>
                    <button onclick="this.form.submit()" class=" d-none d-sm-inline-block btn btn-sm btn-outline-primary shadow-sm">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </form>

        </div>
        <div class="col-md-6 btn-group pull-left" role="group" aria-label="Basic example">

            <button class="col-md-2  btn btn-sm btn-outline-primary shadow-sm"
                    data-toggle="modal"
                    data-target="#theModal"
                    onclick="addEdit(this)"
                    title="SMS Message">
                <i class="fas fa-plus fa-sm "></i> New
            </button>

        </div>
    </div>
    <div class="row">
        <div class="col-12">

            <div class="card shadow mb-4">

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="dataTable" width="100%" cellpadding="0">
                            <thead>
                                <tr>
                                    <th>Subject</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th>Recipients</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th>Subject</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th>Recipients</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                            <tbody>
                                @foreach (var item in Model.TheList)
                                {

                                    <tr>
                                        <td>
                                            <a asp-controller="@Model.Controller" asp-action="Detail" asp-route-id="@item.Id" class="title">
                                                @Html.DisplayFor(modelItem => item.Subject)
                                            </a>
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => item.Status)</td>
                                        <td>
                                            @item.CreateStamp.ToString("yyyy-MM-dd")
                                        </td>
                                        <td>
                                            @item.Recipients.Count
                                        </td>


                                        <td>
                                            <div class="btn-group" role="group" aria-label="Basic example">

                                                <a class=" btn btn-sm  btn-outline-info" asp-controller="@Model.Controller" asp-action="Detail" asp-route-id="@item.Id">
                                                    <i class="fa fa-info" aria-hidden="true"></i>
                                                </a>

                                            </div>


                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>



</div>
<div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="theModal">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="idTitle"> New Email Message </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form data-parsley-validate novalidate method="post" enctype="multipart/form-data"
                      asp-action="Save" asp-antiforgery="true">
                    <input type="hidden" name="Id" value="@Guid.Empty" />
                    <input type="hidden" name="Owner" value="@Model.CurrentModule" />

                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Subject
                        </label>
                        <input type="text" name="Subject" maxlength="100" class="form-control col-sm-7 col-md-8" />
                    </div>
                    @*<div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Template
                        </label>
                        <select class="custom-select col-sm-7 col-md-8" name="TemplateId" required
                                asp-items="@(new SelectList(Model.Templates,"Id", "Name"))"></select>

                    </div>*@
                    <div class="row form-group">
                        <div class="col-sm-12">
                            <input type="submit" value="Save"
                                   class="btn btn-primary">

                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

