@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";

}

<div class="row justify-content-center">

    <div class="col-xl-10 col-lg-10 col-md-8">

        <div class="card o-hidden border-0 shadow-lg my-5" style="background-color: transparent; ">
            <div class="card-body p-0">
                <!-- Nested Row within Card Body -->
                <div class="row">
                    
                    <div class="col-lg-12" style="background-color: white; ">
                        <div class="p-5">
                            <div class="text-center">
                                <h1 class="h4 text-gray-900 mb-4"> <img src="~/img/logo.png" width="20%"  />ECDS Backoffice </h1>
                            </div>
                            <form id="account" class="user" method="post" asp-antiforgery="true">
                                <div class="form-group">
                                    <div asp-validation-summary="All" class="text-danger"></div>
                                    <input type="text" class="form-control form-control-user"
                                           id="exampleInputEmail" aria-describedby="emailHelp"
                                           placeholder="User Name..."
                                           asp-for="Input.UserName" maxlength="40" ondrop="return false" autocomplete="off" required>
                                    
                                </div>
                                <div class="form-group">
                                    <input type="password" class="form-control form-control-user"
                                           id="exampleInputPassword" placeholder="Password" autocomplete="off"
                                           asp-for="Input.Password" maxlength="40" ondrop="return false">
                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                   
                                </div>
                                <button type="submit" class="btn btn-primary btn-user btn-block">
                                    Login
                                </button>
                            </form>
                        
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />


}
<script src="https://www.google.com/recaptcha/api.js?render=6Lf7kD0cAAAAAGx34iJzEpaOqxaJX-mOwusv_BmQ"></script>
<script>
    grecaptcha.ready(function () {
        grecaptcha.execute('6Lf7kD0cAAAAAGx34iJzEpaOqxaJX-mOwusv_BmQ', { action: 'homepage' });
    });
</script>