@using ECCSA.BackOffice.Server.Model.Membership
@model ECCSA.BackOffice.Server.WebApp.Areas.Membership.Model.AssociationViewModel

<div class="modal-header">
    <h5 class="modal-title">@(Model.Contact.Id == Guid.Empty ? "Add" : "Edit") </h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <form data-parsley-validate novalidate method="post"
          asp-action="SaveContact" asp-antiforgery="true">
        <input type="hidden" asp-for="Contact.Id" />
        <input type="hidden" asp-for="Contact.MemberId" />

        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Type
            </label>
            <select class="custom-select col-sm-8 col-md-9"
                    asp-for="Contact.ContactType"
                    asp-items="Html.GetEnumSelectList<ContactTypeEnum>()">
            </select>
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Address
            </label>
            <input type="text" class="form-control col-sm-8 col-md-8" asp-for="Contact.Address" />
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Priority
            </label>
            <input type="number" min="0" max="10"  class="form-control col-sm-2 col-md-2" asp-for="Contact.Priority" />
        </div>

        <div class="row form-group">
            <div class="col-sm-12">
                <input type="submit" value="Save"
                       class="btn btn-primary">

            </div>
        </div>
    </form>
</div>
