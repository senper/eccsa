@model ECCSA.BackOffice.Server.WebApp.Areas.Membership.Model.AssociationViewModel

<div class="modal-header">
    <h5 class="modal-title">@(Model.TheModel.Id == Guid.Empty ? "Add" : "Edit") </h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <form data-parsley-validate novalidate method="post"
          asp-action="@(Model.TheModel.Id == Guid.Empty ? "Create" : "Update")" asp-antiforgery="true">
        <input type="hidden" asp-for="TheModel.Id" />

        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Name
            </label>
            <input type="text" class="form-control col-sm-8 col-md-8" asp-for="TheModel.NameEng" />
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                ስም
            </label>
            <input type="text" class="form-control col-sm-8 col-md-9" asp-for="TheModel.NameLocal" />
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Type
            </label>
            <select class="custom-select col-sm-8 col-md-9"
                    asp-for="TheModel.AssociationType">
                <option value="0">Please select ...</option>
                <option value="1">Administrative</option>
                <option value="2">Sectoral</option>
            </select>
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Level
            </label>
            <select class="custom-select col-sm-8 col-md-9"
                    asp-for="TheModel.AssociationLevel">
                <option value="0">National</option>
                <option value="1">Regional</option>
                <option value="3">Woreda</option>

            </select>
            <span asp-validation-for="TheModel.AssociationLevel" class="text-danger"></span>
        </div>
          <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Location
            </label>
            <select class="custom-select col-sm-8 col-md-9" asp-for="TheModel.LocationId"
                    asp-items="@(new SelectList(Model.Locations,"Id", "Name"))"></select>
        </div>
          <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Parent
            </label>
            <select class="custom-select col-sm-8 col-md-9" asp-for="TheModel.ParentId"
                    asp-items="@(new SelectList(Model.TheList,"Id", "Name"))"></select>
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Status
            </label>
            <select class="custom-select col-sm-8 col-md-9" asp-for="TheModel.Stakeholder.Status">
                <option value="1">Active</option>
                <option value="2">Inactive</option>
            </select>
        </div>
        <div class="row form-group">
            <div class="col-sm-12">
                <input type="submit" value="Save"
                       class="btn btn-primary">

            </div>
        </div>
    </form>
</div>
