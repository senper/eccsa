@model ECCSA.BackOffice.Server.WebApp.Areas.Membership.Model.AssociationViewModel

<div class="modal-header">
    <h5 class="modal-title">@(Model.MembershipRequirement.Id == Guid.Empty ? "Add" : "Edit") </h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <form data-parsley-validate novalidate method="post"
          asp-action="SaveDocument" asp-antiforgery="true">
        <input type="hidden" asp-for="MembershipRequirement.Id" />
        <input type="hidden" asp-for="MembershipRequirement.AssociationId" />

        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Document Type
            </label>
           
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                For New Application
            </label>
            <select class="custom-select col-sm-8 col-md-9" asp-for="MembershipRequirement.ApplicationRequirementLevel">
                <option value="0">Not Required</option>
                <option value="1">Mandatory</option>
                <option value="2">Optional</option>
            </select>
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                For Membership Renewal
            </label>
            <select class="custom-select col-sm-8 col-md-9" asp-for="MembershipRequirement.RenewalRequirementLevel">
                <option value="0">Not Required</option>
                <option value="1">Mandatory</option>
                <option value="2">Optional</option>
            </select>
        </div>
     
        <div class="row form-group">
            <div class="col-sm-12">
                <input type="submit" value="Save"
                       class="btn btn-primary">

            </div>
        </div>
    </form>
</div>
