@model ECCSA.BackOffice.Server.WebApp.Areas.Membership.Model.AssociationViewModel

<div class="modal-header">
    <h5 class="modal-title">@(Model.Setting.Id == Guid.Empty ? "Add" : "Edit") </h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <form data-parsley-validate novalidate method="post"
          asp-action="SaveSetting" asp-antiforgery="true">
        <input type="hidden" asp-for="Setting.Id" />
        <input type="hidden" asp-for="Setting.AssociationId" />
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Bank Name
            </label>
            <input type="text" maxlength="50" class="form-control col-sm-8 col-md-8" asp-for="Setting.BankName" />
        </div>

        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Account Number
            </label>
            <input type="text" class="form-control col-sm-8 col-md-9" asp-for="Setting.AccountNumber" />
        </div>

        <div class="row form-group">
            <div class="col-sm-12">
                <input type="submit" value="Save"
                       class="btn btn-primary">

            </div>
        </div>
    </form>
</div>
