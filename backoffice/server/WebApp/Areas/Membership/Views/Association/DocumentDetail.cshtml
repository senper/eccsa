@model ECCSA.BackOffice.Server.WebApp.Areas.Membership.Model.AssociationViewModel

<div class="modal-header">
    <h5 class="modal-title">Detail </h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">

    
    <div class="row ">
        <label class="col-sm-5 col-md-4 col-form-label">
            Document Type
        </label>
       
    </div>

    <div class="row ">
        <label class="col-sm-5 col-md-4 col-form-label">
            For new Application
        </label>
        @Model.MembershipRequirement.ApplicationRequirementLevel
    </div>
    <div class="row ">
        <label class="col-sm-5 col-md-4 col-form-label">
            For Renewal
        </label>
        @Model.MembershipRequirement.RenewalRequirementLevel
    </div>
    

</div>
