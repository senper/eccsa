@section script {

<script src="~/vendor/ckeditor/ckeditor.js"></script>
<script>
    CKEDITOR.replace('associationProfile', {
        height: 260,
        width: '100%',
    });

    function editProfile() {
        document.getElementById('ass_profile_info_editor').classList.remove('d-none');
        document.getElementById('ass_profile_info_text').classList.add('d-none');
    }

    function profileCancel() {
        document.getElementById('ass_profile_info_editor').classList.add('d-none');
        document.getElementById('ass_profile_info_text').classList.remove('d-none');
    }

    
    CKEDITOR.replace('associationProfileLocal', {
        height: 260,
        width: '100%',
    });

    function editProfileLocal() {
        document.getElementById('ass_profile_info_editor_local').classList.remove('d-none');
        document.getElementById('ass_profile_info_text_local').classList.add('d-none');
    }

    function profileLocalCancel() {
        document.getElementById('ass_profile_info_editor_local').classList.add('d-none');
        document.getElementById('ass_profile_info_text_local').classList.remove('d-none');
    }

    $('.edit').on('click', function () {

        var url = $(this).attr('data-url');
        $($(this).attr('data-target')).find(".modal-content").html("");

        $($(this).attr('data-target')).find(".modal-content").each(function (index, item) {
            $(item).html("");

            if (url && url.length > 0) {
                $(item).load(url);
            }
        });
    });
    function confirmDelete(form) {
        $.confirm({
            icon: 'fa fa-exclamation-triangle',
            title: 'Confirm!',
            content: 'Are you sure want to Delete ?',
            buttons: {
                yes: function () {
                    form.submit();
                },
                no: function () {
                }
            }
        });
        return false;
    }
</script>

<script>

    function showHideAnswers(e) {
        const ank = $(e);
        let show = true;
        for (let i = 0; i < ank[0].children.length; i++) {
            const child = ank[0].children[i];
            if (child.localName == 'i') {
                if (child.classList.contains('fa-angle-right')) {
                    show = true;
                    child.classList.remove('fa-angle-right');
                    child.classList.add('fa-angle-down');
                } else {
                    show = false;
                    child.classList.add('fa-angle-right');
                    child.classList.remove('fa-angle-down');
                }
            }
        }
        const className = ank.attr('data-tt');

        const rows = document.getElementsByClassName(className);
        for (let i = 0; i < rows.length; i++) {
            if (show) {
                rows[i].style.display = '';
            } else {
                rows[i].style.display = 'none';
            }
        }

    }

    function approvalChanged(e){
         document.getElementById('approvalRequiredHdn').value =Boolean( e.checked);
    }
    function attachmentChanged(e){
         document.getElementById('approvalAttachmentRequiredHdn').value =Boolean( e.checked);
    }
    function inputTypeChanged(e) {
        const val = Number(e.value);

        const rangeDiv = document.getElementById('lookupDiv');
        if (val === 10) {
            rangeDiv.style.display = '';
            $("#lookupDiv").attr('required', 'required');
        } else {
            rangeDiv.style.display = 'none';
            $("#lookupDiv").removeAttr('required');
        }
    }


    function editChoice(e) {
        const id = document.getElementById('choiceId');
        const title = document.getElementById('choiceTitle');
        const qid = document.getElementById('choiceQuestionId');
        const orderNo = document.getElementById('choiceOrderNo');
        const choiceText = document.getElementById('choiceText');

        const idVal = $(e).attr('data-id');
        const qidVal = $(e).attr('data-qid');
        const orderVal = $(e).attr('data-orderno');
        const choiceVal = $(e).attr('data-choice');
        const titleVal = $(e).attr('data-title');

        id.value = idVal;
        qid.value = qidVal;
        orderNo.value = orderVal;
        choiceText.value = choiceVal;
        title.innerHTML = titleVal;


    }

    function questionTypeChanged(e) {
        const val = Number(e.value);

        const rangeDiv = document.getElementById('rangeDiv');
        if (val === 3) {
            rangeDiv.style.display = '';
        } else {
            rangeDiv.style.display = 'none';
        }
    }

    function showParent(e) {
        const checked = Boolean(e.checked);
        showHideParent(checked);

    }

    function showHideParent(checked) {
        const parentChoiceDiv = document.getElementById('parentChoiceDiv');
        if (checked) {
            parentChoiceDiv.style.display = '';
        } else {
            parentChoiceDiv.style.display = 'none';
        }
        const parentOpt = document.getElementById('parentChoice');
        const qId = document.getElementById('questionId').value;
        const val = document.getElementById('settingAllChoices').value;

        const choices = JSON.parse(val);
        console.log(choices);
        $("#parentChoice").empty();
        for (let i = 0; i < choices.length; i++) {
            let item = choices[i];

            if (item != null && item.SimpleChoices != null && item.Id != qId) {
                var optGrp = document.createElement("optgroup");
                optGrp.label = `${item.OrderNo} ${item.Question}`
                for (let j = 0; j < item.SimpleChoices.length; j++) {
                    let itm = item.SimpleChoices[j];
                    var opt = document.createElement("option");
                    opt.value = itm.Id;
                    opt.innerHTML = itm.ChoiceText;
                    optGrp.appendChild(opt);
                }
                parentOpt.appendChild(optGrp);
            }

        }

    }

    function editRequirement(e) {
        const id = document.getElementById('requirementId');
        const orderNo = document.getElementById('requirementOrderNo');
        const nameEng = document.getElementById('nameEngRequirement');

        const label = document.getElementById('labelRequirement');
        const labelLocal = document.getElementById('labelLocalRequirement');
        const descEng = document.getElementById('DescriptionEngRequirement');
        const approve = document.getElementById('approveOnSubmit');

        const appl = document.getElementById('applicationRequirementLevel');
        const renewal = document.getElementById('renewalRequirementLevel');

        const idVal = $(e).attr('data-id');
        const orderVal = $(e).attr('data-orderno');
        const nameVal = $(e).attr('data-name');
        const labelVal = $(e).attr('data-label');
        const labelLocalVal = $(e).attr('data-labellocal');
        const lookupVal= $(e).attr('data-lookuptype');
        const descVal = $(e).attr('data-desc');
        const typeVal = Number($(e).attr('data-type'));
        const approveVal = Boolean($(e).attr('data-approve'));
        const applVal = Number($(e).attr('data-appl'));
        const renewalVal = Number($(e).attr('data-renewal'));
        id.value = idVal;
        orderNo.value = orderVal;
        nameEng.value = nameVal;
        label.value = labelVal;
        labelLocal.value = labelLocalVal;
        descEng.innerHTML = descVal;
        approve.value = approveVal;

        $('#inputMethodRequirement').val(typeVal).change();
        $('#applicationRequirementLevel').val(applVal).change();
        $('#renewalRequirementLevel').val(renewalVal).change();
        editRequirementInvoice(e);
        editRequirementGroup(e);
    }


    function editRequirementGroup(e) {
        const id = document.getElementById('groupId');
        const orderNo = document.getElementById('groupOrderNo');
        const name = document.getElementById('groupName');

        const idVal = $(e).attr('data-id');
        const orderVal = $(e).attr('data-orderno');
        const nameEngVal = $(e).attr('data-name');


        id.value = idVal;
        orderNo.value = orderVal;
        name.value = nameEngVal;
    }

    function editRequirementInvoice(e) {
        const id = document.getElementById('invoiceRequirementId');
        const orderNo = document.getElementById('invoiceOrderNo');
        const name = document.getElementById('invoiceName');

        const desc = document.getElementById('invoiceDescription');

        const idVal = $(e).attr('data-id');
        const orderVal = $(e).attr('data-orderno');
        const nameVal = $(e).attr('data-name');

        const descVal = $(e).attr('data-desc');


        id.value = idVal;
        orderNo.value = orderVal;
        name.value = nameVal;

        desc.innerHTML = descVal;
    }
</script>
}