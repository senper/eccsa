@using ECCSA.BackOffice.Server.Model.Common
@using ECCSA.BackOffice.Server.Model.Membership
@model ECCSA.BackOffice.Server.WebApp.Areas.Membership.Model.AssociationViewModel

@{
    ViewData["Title"] = "Associations";
    Layout = "~/Views/Shared/_MembershipLayout.cshtml";
    HashSet<Guid> associationSet = new HashSet<Guid>();
    HashSet<Guid> individualSet = new HashSet<Guid>();
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <a href="@Url.Action("Index","Association",new { Area ="Membership"})" class="btn btn-outline-info"><i class="fa fa-angle-double-left" aria-hidden="true"></i>back</a>
    </div>
    <div class="row">

        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-sm-2">
                            <img src="@Model.LogoPath" alt="Logo" style="max-height: 90px; max-width: 90px; min-height: 30px; min-width: 30px; " />
                        </div>
                        <div class="col-sm-9">

                            <h4>  @Model.TheModel.NameEng @Model.TheModel.NameLocal </h4>
                        </div>
                        <div class="col-sm-1">
                            <button data-toggle="modal"
                                    data-target="#AddEditModal"
                                    title="Edit"
                                    data-url="@Url.Action("Edit", new { Id=Model.TheModel.Id })"
                                    class=" float-right edit btn btn-outline-success btn-sm">
                                <i class="fa fa-pen "></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-9">
                            <div class="row">
                                <div class="col-sm-4">
                                    ShortName:
                                </div>
                                <div class="col-sm-8">
                                    @Model.TheModel.ShortName @Model.TheModel.ShortName_Local
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-4">
                                    Type:
                                </div>
                                <div class="col-sm-8">
                                    @Model.TheModel.AssociationType
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-4">
                                    Level
                                </div>
                                <div class="col-sm-8">
                                    @Model.TheModel.AssociationLevel
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-4">
                                    Location
                                </div>
                                <div class="col-sm-8">
                                    @Model.TheModel.Location.NameEng @Model.TheModel.Location.NameLocal
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-4">
                                    Member of
                                </div>
                                <div class="col-sm-8">
                                    @(Model.TheModel.Parent == null? "": Model.TheModel.Parent.Name)
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-4">
                                    Status
                                </div>
                                <div class="col-sm-8">
                                    @Model.TheModel.Stakeholder.Status
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-4">
                                    New Membership Fee
                                </div>
                                <div class="col-sm-8">
                                   Current: @Model.TheModel.RegistrationFee Birr , Proposed: @Model.TheModel.ProposedRegistrationFee Birr
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-4">
                                    Renewal Fee
                                </div>
                                <div class="col-sm-8">
                                    Current: @Model.TheModel.RenewalFee Birr , Proposed: @Model.TheModel.ProposedRenewalFee Birr
                                </div>
                            </div>
                            <br />
                            <div class="card">
                                <div class="card-header">
                                    Contact Details <button class="card-header-action btn edit btn-outline-success btn-sm"
                                                            id="newbtn"
                                                            data-url="@Url.Action("EditContact", new {AssociationId = Model.TheModel.Id, Id=Guid.Empty })"
                                                            data-toggle="modal"
                                                            data-target="#AddEditModal">
                                        New
                                    </button>
                                </div>
                                <div class="card-body">



                                    @foreach (var contact in @Model.TheModel.Stakeholder.Contacts.OrderBy(c => c.Priority))
                                    {
                                        <div class="row">
                                            <div class="col-sm-4">
                                                @contact.ContactType:
                                            </div>
                                            <div class="col-sm-6">
                                                @contact.Address
                                            </div>
                                            <div class="col-sm-2 btn-group" role="group" aria-label="Basic example">
                                                <button data-toggle="modal" data-target="#AddEditModal" data-url="@Url.Action("EditContact", new {AssociationId = Model.TheModel.Id,  Id=@contact.Id })"
                                                    class="edit btn btn-outline-success btn-sm">
                                                    <i class="fa fa-pen "></i>
                                                </button>

                                                <a onclick="return confirmDelete($('#deleteContact@(Model.Guid2String(contact.Id))')[0]);"
                                               class=" btn btn-sm btn-outline-danger">
                                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                                </a>
                                                <form data-parsley-validate novalidate method="post" id="deleteContact@(Model.Guid2String(contact.Id))"
                                                  asp-action="deleteContact" asp-antiforgery="true">
                                                    <input type="hidden" name="id" value="@contact.Id" />
                                                    <input type="hidden" name="memberId" value="@contact.MemberId" />
                                                </form>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="card">

                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <img id="blah1" src="@Model.BoardDirectorPath" alt="Board Chairperson" style="max-height: 170px; max-width: 170px; min-height: 170px; min-width: 170px; " /> <br />
                                            @Model.BoardChairman?.PositionType?.Name<br />
                                        </div>
                                    </div>
                                    <hr />
                                    <div class="row">
                                        <div class="col-sm-12">
                                            <img id="blah2" src="@Model.SecretaryGeneralPath" alt="Secretary General" style="max-height: 170px; max-width: 170px; min-height: 170px; min-width: 170px; " /><br />
                                            @Model.CEO?.PositionType?.Name <br />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
    <br />
    <div class="row">
        <div class="col-sm-12">
            <div class="card">

                <div class="card-body collapse show" id="detail_info">

                    <a class="profile" href="#" id="showhideDetail" data-toggle="collapse" data-target="#profile_info" aria-expanded="true" aria-controls="profile_info">
                        <strong>Profile</strong>
                    </a>
                    <div class="card collapse show" id="profile_info">
                        <div id="ass_profile_info_text">
                            <div class="row">
                                <div class="col-12">
                                    <button class="btn btn-outline-success btn-sm btn-circle float-right" onclick="editProfile()">
                                        <i class="fa fa-pen "></i>
                                    </button>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12" id="profileHtml">
                                    @Html.Raw(Model.TheModel.Profile)
                                </div>
                            </div>
                        </div>
                        <div id="ass_profile_info_editor" class=" d-none">
                            <form data-parsley-validate method="post" asp-action="SetProfile" asp-antiforgery="true">
                                <input type="hidden" name="id" value="@Model.TheModel.Id" />
                                <div>
                                    <textarea id="associationProfile" name="profile" placeholder="Profile ..............." cols="65" rows="10" data-sample-short>
                                        @(Model.TheModel.Profile)
                                    </textarea>
                                </div>
                                <div class="form-group ">
                                    <input type="submit" value="Save" class="btn btn-warning localize" data-key="Save">
                                    <input type="button" value="Cancel" class="btn btn-info localize " data-key="cancel" onclick="profileCancel()">
                                </div>
                            </form>
                        </div>
                        <div id="ass_profile_info_text_local">
                            <div class="row">
                                <div class="col-12">
                                    <button class="btn btn-outline-success btn-sm btn-circle float-right" onclick="editProfileLocal()">
                                        <i class="fa fa-pen "></i>
                                    </button>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12" id="profileHtml">
                                    @Html.Raw(Model.TheModel.Profile_Local)
                                </div>
                            </div>
                        </div>
                        <div id="ass_profile_info_editor_local" class=" d-none">
                            <form data-parsley-validate method="post" asp-action="SetProfileLocal" asp-antiforgery="true">
                                <input type="hidden" name="id" value="@Model.TheModel.Id" />
                                <div>
                                    <textarea id="associationProfileLocal" name="profile" placeholder="Profile Local..............." cols="65" rows="10" data-sample-short>
                                        @(Model.TheModel.Profile_Local)
                                    </textarea>
                                </div>
                                <div class="form-group ">
                                    <input type="submit" value="Save" class="btn btn-warning localize" data-key="Save">
                                    <input type="button" value="Cancel" class="btn btn-info localize " data-key="cancel" onclick="profileLocalCancel()">
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <br />
            <div class="card">
                <div class="card-body">

                    <div class="nav-tabs-boxed">
                        <ul class="nav nav-tabs" role="tablist">
                            <li class="nav-item"><a class="nav-link @Model.Tab0Active" data-toggle="tab" href="#representatives" role="tab" aria-controls="representatives">Representatives</a></li>

                            <li class="nav-item"><a class="nav-link @Model.Tab1Active" data-toggle="tab" href="#members" role="tab" aria-controls="members">Membership Requirements</a></li>
                            <li class="nav-item"><a class="nav-link @Model.Tab2Active" data-toggle="tab" href="#settings" role="tab" aria-controls="settings">Bank Settings</a></li>
                            <li class="nav-item"><a class="nav-link @Model.Tab3Active" data-toggle="tab" href="#profileImages" role="tab" aria-controls="profileImages">Profile Images</a></li>
                            <li class="nav-item"><a class="nav-link @Model.Tab4Active" data-toggle="tab" href="#associationInfo" role="tab" aria-controls="profileImages">Additional Info</a></li>
                            @*<li class="nav-item"><a class="nav-link @Model.Tab5Active" data-toggle="tab" href="#associations" role="tab" aria-controls="members">Members</a></li>*@
                        </ul>
                        <div class="tab-content">

                            <div class="tab-pane @Model.Tab0Active" id="representatives" role="tabpanel">
                                <div class="card-header-actions">
                                    <button class="card-header-action edit btn btn-outline-success btn-sm"
                                            id="newbtn"
                                            data-url="@Url.Action("EditStaff", new {AssociationId = Model.TheModel.Id, Id=Guid.Empty })"
                                            data-toggle="modal"
                                            data-target="#AddEditModal">
                                        New
                                    </button>

                                    @*<form data-parsley-validate novalidate method="get" id="printInvoice" target="_blank"
                                        asp-action="PrintInvoice" asp-antiforgery="true">
                                        <input type="hidden" value="@Model.TheModel.Id" name="id" />
                                        </form>
                                        <button type="submit" class="btn btn-primary localize" data-key="Print" onclick="$('#printInvoice').submit();">Print </button>



                                        <form data-parsley-validate novalidate method="get" id="printReceipt" target="_blank"
                                        asp-action="PrintReceipt" asp-antiforgery="true">
                                        <input type="hidden" value="@Model.TheModel.Id" name="id" />
                                        </form>
                                        <button type="submit" class="btn btn-primary localize" data-key="Print" onclick="$('#printReceipt').submit();">Print Receipt </button>*@


                                </div>
                                <table class="table table-bordered table-striped" id="datatbl">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Position</th>
                                            <th>Mobile</th>
                                            <th>Email</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in Model.TheModel.Employees.Where(e => e.Status == ECCSA.BackOffice.Server.Model.Common.StatusEnum.Active))
                                        {
                                            <tr>
                                                <td>@r.Name</td>
                                                <td>@r.PositionType.Name</td>
                                                <td>@r.Mobile</td>
                                                <td>@r.Email</td>
                                                <td>
                                                    <div class="col-sm-2 btn-group" role="group" aria-label="Basic example">
                                                        <a class="btn btn-outline-success edit btn-sm"
                                                       data-toggle="modal"
                                                       data-url="@Url.Action("EditStaff", new {AssociationId = Model.TheModel.Id, Id=r.Id })"
                                                       data-target="#AddEditModal"><i class="fa fa-pen "></i></a>

                                                        <a class="btn btn-outline-info edit btn-sm"
                                                       data-toggle="modal"
                                                       data-url="@Url.Action("StaffDetail", new {AssociationId = Model.TheModel.Id, Id=r.Id })"
                                                       data-target="#AddEditModal"><i class="fa fa-info" aria-hidden="true"></i></a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="tab-pane @Model.Tab1Active" id="members" role="tabpanel">
                                <div class="card-header-actions">
                                </div>
                                <table class="table table-bordered table-striped" id="datatbldocument">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Name</th>
                                            <th>Type</th>
                                            <th>Auto Approve</th>
                                            <th>For New</th>
                                            <th>For Renewal</th>
                                            <th>
                                                <div class="btn-group float-right">

                                                    @if (Model.RoleLevel == RoleLevelEnum.Admin)
                                                    {
                                                        <button class="card-header-action btn btn-outline-success btn-sm"
                                                            data-toggle="modal"
                                                            data-target="#editRequirementModal"
                                                            title="New Requirement"
                                                            data-id="@Guid.Empty"
                                                            data-orderno=""
                                                            data-name=""
                                                            data-desc=""
                                                            data-label=""
                                                            data-labelLocal=""
                                                            data-approve="true"
                                                            data-type="0"
                                                            data-appl="@((int)RequirementLevelEnum.Mandatory)"
                                                            data-renewal="@((int)RequirementLevelEnum.Mandatory)"
                                                            onclick="editRequirement(this)">
                                                            New
                                                        </button>


                                                    }
                                                </div>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var q in Model.TheModel.MembershipRequirements.Where(r => r.Status == StatusEnum.Active).OrderBy(o => o.OrderNo))
                                        {
                                            <tr>
                                                <td>@q.OrderNo</td>
                                                <td> @q.Name  </td>
                                                <td> @q.InputMethod  </td>
                                                <td>@(q.ApproveOnSubmit?"Yes":"No")</td>
                                                <td>@q.ApplicationRequirementLevel.GetDisplayName()</td>
                                                <td>@q.RenewalRequirementLevel.GetDisplayName()</td>
                                                <td>
                                                    @if (Model.RoleLevel == RoleLevelEnum.Admin)
                                                    {
                                                        if (!@q.HasApplicants)
                                                        {
                                                            <button data-toggle="modal"
                                                        data-target="#editRequirementModal"
                                                        title="Edit Requirement"
                                                        data-id="@q.Id"
                                                        data-orderno="@q.OrderNo"
                                                        data-name="@q.Name"
                                                        data-desc="@q.Description"
                                                        data-type="@((int)q.InputMethod)"
                                                        data-label="@q.Label"
                                                        data-labellocal="@q.LabelLocal"
                                                        data-lookuptype="@q.LookupTypeId"
                                                        data-appl="@((int)q.ApplicationRequirementLevel)"
                                                        data-renewal="@((int)q.RenewalRequirementLevel)"
                                                        data-approve="@q.ApproveOnSubmit"
                                                        onclick="editRequirement(this)"
                                                        class=" float-right btn btn-outline-success btn-sm">
                                                                <i class="fa fa-pen "></i>
                                                            </button>
                                                        }
                                                        <a onclick="return confirmDelete($('#delete@(Model.Guid2String(q.Id))')[0]);"
                                                   class=" btn btn-sm btn-outline-danger float-right">
                                                            <i class="fa fa-trash" aria-hidden="true"></i>
                                                        </a>
                                                        <form data-parsley-validate novalidate
                                                      method="post" id="delete@(Model.Guid2String(q.Id))"
                                                      asp-action="DeleteRequirement" asp-antiforgery="true">
                                                            <input type="hidden" name="requirementId" value="@q.Id" />
                                                            <input type="hidden" name="associationId" value="@q.AssociationId" />
                                                        </form>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="tab-pane @Model.Tab2Active" id="settings" role="tabpanel">

                                <div class="card-header-actions">
                                    <button class="card-header-action edit btn btn-outline-success btn-sm"
                                            id="newSettingBtn"
                                            data-url="@Url.Action("EditSetting", new {AssociationId = Model.TheModel.Id, Id=Guid.Empty })"
                                            data-toggle="modal"
                                            data-target="#AddEditModal">
                                        New
                                    </button>
                                </div>
                                <table class="table table-bordered table-striped" id="datatblsetting">
                                    <thead>
                                        <tr>
                                            <th colspan="3" class="text-center">Current</th>
                                            <th colspan="3" class="text-center">Proposed</th>
                                            <th></th>
                                        </tr>
                                        <tr>
                                            <th>Bank</th>
                                            <th>Account No</th>
                                            <th>Update Date</th>
                                            <th>Bank</th>
                                            <th>Account No</th>
                                            <th>Proposed Date</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in Model.TheModel.Settings)
                                        {
                                            <tr>
                                                <td> @r.BankName </td>
                                                <td>@r.AccountNumber</td>
                                        <td>
                                            @(r.UpdatedDate?.ToString("yyyy-MM-dd HH:mm tt"))
                                        </td>
                                                <td> @r.ProposedBankName </td>
                                                <td>@r.ProposedAccountNumber</td>
                                                
                                        <td>
                                            @(r.DateProposed?.ToString("yyyy-MM-dd HH:mm tt"))
                                        </td>
                                        
                                                <td>
                                                    <div class="col-sm-2 btn-group" role="group" aria-label="Basic example">
                                                        <a class="btn btn-outline-success edit btn-sm"
                                                       data-toggle="modal"
                                                       data-url="@Url.Action("EditSetting", new {AssociationId = Model.TheModel.Id, Id=r.Id })"
                                                       data-target="#AddEditModal"><i class="fa fa-pen "></i></a>

                                                        <a onclick="return confirmDelete($('#deleteSetting@(Model.Guid2String(r.Id))')[0]);"
                                                       class=" btn btn-sm btn-outline-danger">
                                                            <i class="fa fa-trash" aria-hidden="true"></i>
                                                        </a>
                                                        <form data-parsley-validate novalidate method="post" id="deleteSetting@(Model.Guid2String(r.Id))"
                                                          asp-action="DeleteSetting" asp-antiforgery="true">
                                                            <input type="hidden" name="id" value="@r.Id" />
                                                            <input type="hidden" name="associationId" value="@r.AssociationId" />
                                                        </form>



                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="tab-pane @Model.Tab3Active" id="profileImages" role="tabpanel">

                                <div class="card-header-actions">
                                    <form data-parsley-validate method="post" enctype="multipart/form-data"
                                          asp-action="@("AddProfileImage")" asp-antiforgery="true">
                                        <input type="hidden" name="id" value="@Model.TheModel.Id" />
                                        <input type="button" onclick="$('#selectfile').click()" id="selectFilebtn" class="btn btn-outline-success btn-sm" name="Select file" value="New" />
                                        <input type="file" name="image" id="selectfile" hidden onchange="this.form.submit()" accept="image/png, image/gif, image/jpeg">
                                    </form>
                                </div>
                                <table class="table table-bordered table-striped" id="datatblsetting">
                                    <thead>
                                        <tr>
                                            <th>Image</th>
                                            <th>Url</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in Model.ProfileImages)
                                        {
                                            <tr>
                                                <td> <img src="@r" width="30%" /> </td>
                                                <td>@r</td>
                                                <td>
                                                    <div class="col-sm-2 btn-group" role="group" aria-label="Basic example">
                                                        <a onclick="return confirmDelete($('#deleteProfileImage@(Model.ProfileImages.IndexOf(r))')[0]);"
                                                       class=" btn btn-sm btn-outline-danger">
                                                            <i class="fa fa-trash" aria-hidden="true"></i>
                                                        </a>
                                                        <form data-parsley-validate novalidate method="post" id="deleteProfileImage@(Model.ProfileImages.IndexOf(r))"
                                                          asp-action="RemoveProfileImage" asp-antiforgery="true">
                                                            <input type="hidden" name="id" value="@Model.TheModel.Id" />
                                                            <input type="hidden" name="fileName" value="@(r)" />
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="tab-pane @Model.Tab4Active" id="associationInfo" role="tabpanel">
                                <div class="row">

                                    <div class="col-md-11 ">
                                        <table class="table table-bordered table-striped" id="datatblprofile" style="margin-top: 5px; margin-left: 5px;">
                                            <thead>
                                                <tr>
                                                    <th>Attribute</th>
                                                    <th>Value</th>

                                                    <th>
                                                        <button class="card-header-action edit btn btn-outline-success btn-sm"
                                                                id="newbtn"
                                                                data-url="@Url.Action("EditProfile", new {id=Guid.Empty, associationId = Model.TheModel.Id })"
                                                                data-toggle="modal"
                                                                data-target="#AddEditModal">
                                                            New
                                                        </button>
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var a in Model.TheModel.AssociationProfiles)
                                                {
                                                    <tr>
                                                        <td> @a.ProfileAttribure.Name </td>
                                                        <td> @a.AttributeValue</td>
                                                        <td>

                                                            <button data-toggle="modal"
                                                                data-target="#AddEditModal"
                                                                title="Edit"
                                                                data-url="@Url.Action("EditProfile", new {id=a.Id, associationId = a.AssociationId })"
                                                                class=" float-right edit btn btn-outline-success btn-sm">
                                                                <i class="fa fa-pen "></i>
                                                            </button>

                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            @*<div class="tab-pane @Model.Tab5Active" id="associations" role="tabpanel">


                                <table class="table table-bordered table-striped" id="datatblsetting">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Type</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in Model.Associations)
                                        {
                                            if (associationSet.Contains(r.Id)) continue;
                                            if (r.Id == Model.TheModel.Id) continue;
                                            associationSet.Add(r.Id);
                                            <tr>
                                                <td> @r.Name </td>
                                                <td>@r.AssociationType </td>
                                                <td>
                                                    <div class="col-sm-2 btn-group" role="group" aria-label="Basic example">
                                                        <a class=" btn btn-sm  btn-outline-info" asp-controller="Association" asp-action="Detail" asp-route-id="@r.Id">
                                                            <i class="fa fa-info" aria-hidden="true"></i>
                                                        </a>

                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        @if (Model.Individuals != null)
                                        {
                                            foreach (var i in Model.Individuals)
