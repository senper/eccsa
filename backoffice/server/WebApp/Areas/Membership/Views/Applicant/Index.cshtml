@using ECCSA.BackOffice.Server.Model.Common
@model ECCSA.BackOffice.Server.WebApp.Areas.Membership.Model.ApplicantViewModel

@{
    ViewData["Title"] = "Associations";
    Layout = "~/Views/Shared/_MembershipLayout.cshtml";
}

<div class="container-fluid">

    <div class="row d-sm-flex align-items-center justify-content-between " style="margin-top:4px;margin-left:15px;margin-bottom:4px;margin-right:15px;">

        Association
        <form method="get" asp-action="Index">
            <select class="custom-select col-sm-8 col-md-9" asp-for="@Model.AssociationId"
                    asp-items="@(new SelectList(Model.Associations,"Id", "Name"))"
                    onchange="this.form.submit()"></select>
        </form>

    </div>
   

    <div class="row">
        <div class="col-12">

            <div class="card shadow mb-4">
                @*<div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">DataTables Example</h6>
                    </div>*@
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="dataTable" width="100%" cellpadding="0">
                            <thead>
                                <tr>
                                    <th>Applicant Name</th>
                                    <th>Tracking No</th>
                                    <th>Applied On</th>
                                    <th>Reason</th>
                                    
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th>Applicant Name</th>
                                    <th>Tracking No</th>
                                    <th>Applied On</th>
                                    <th>Reason</th>
                                    
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                            <tbody>
                                @foreach (var item in Model.TheList)
                                {
                                    var statusClass = (item.ApplicationStatus == WorkflowStateEnum.Rejected ? "danger" : "");

                                    <tr class="@statusClass">
                                        <td>
                                            <a asp-controller="Applicant" asp-action="Detail" asp-route-id="@item.Id" class="title @statusClass">
                                                @Html.DisplayFor(modelItem => item.NameEng)
                                            </a>
                                        </td>
                                        <td> @item.TrackingNo  </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.DateApplied)
                                        </td>
                                       <td>@item.Reason</td>
                                        <td>
                                            @item.ApplicationStatus
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group" aria-label="Basic example">
                                                
                                                <a class=" btn btn-sm  btn-outline-info" asp-controller="Applicant" asp-action="Detail" asp-route-id="@item.Id">
                                                    <i class="fa fa-info" aria-hidden="true"></i>
                                                </a>

                                            </div>


                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>



</div>


<div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="AddApplicantModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New Applicant </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form data-parsley-validate novalidate method="post" enctype="multipart/form-data"
                      asp-action="Save" asp-antiforgery="true">
                    <input type="hidden" asp-for="TheModel.Id" />
                    <input type="hidden" asp-for="TheModel.AssociationId" />


                    

                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Name
                        </label>
                        <input type="text" maxlength="100" class="form-control col-sm-8 col-md-8" asp-for="TheModel.NameEng" placeholder="Name  " />
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            ስም
                        </label>
                        <input type="text" maxlength="100" class="form-control col-sm-8 col-md-8" asp-for="TheModel.NameLocal" placeholder="ስም  " />
                    </div>
                   
                    




                    <div class="row form-group">
                        <div class="col-sm-12">
                            <input type="submit" value="Save"
                                   class="btn btn-primary">

                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="AddEditModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

        </div>
    </div>
</div>


@section script {

    <script src="/js/comboTreePlugin.js" type="text/javascript"></script>

    <script>

        loadLocation();
        function locationChanged() {
            document.getElementById('hdnlocationSelected').value = document.getElementById('locationSelectorId').value;
            loadLocation();
        }

        function loadLocation() {
            const id = document.getElementById('hdnlocationSelected').value;
            let selectedV = '';
            let url = `individual/getlocation`;
            jQuery.get(url, { parentId: id }, function (data) {
                $('#locationSelectorId')
                    .empty();
                $.each(data.$values, function (index, value) {
                    selectedV = '';
                    if (id == value.id) {
                        selectedV = `selected="selected"`;
                    }
                    const option = `<option  ${selectedV} value="${value.id}">${value.name}</option>`;
                    $('#locationSelectorId').append(option);
                });
            });

        }



        $('.edit').on('click', function () {

            var url = $(this).attr('data-url');
            $($(this).attr('data-target')).find(".modal-content").html("");

            $($(this).attr('data-target')).find(".modal-content").each(function (index, item) {
                $(item).html("");

                if (url && url.length > 0) {
                    $(item).load(url);
                }
            });
        });


        function confirmDelete(form) {
            $.confirm({
                icon: 'fa fa-exclamation-triangle',
                title: 'Confirm!',
                content: 'Are you sure want to Delete ?',
                buttons: {
                    yes: function () {
                        form.submit();
                    },
                    no: function () {
                    }
                }
            });
            return false;
        }
    </script>
}