@model ECCSA.BackOffice.Server.WebApp.Areas.Membership.Model.IndividualViewModel

<link href="~/vendor/combotree/style.css" rel="stylesheet" />
<div class="modal-header">
    <h5 class="modal-title">@(Model.RenewalHistory.Id == Guid.Empty ? "Initiate Renewal" : "Process Renewal") </h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <form data-parsley-validate novalidate method="post" enctype="multipart/form-data"
          asp-action="SaveRenewMembership" asp-antiforgery="true">
        <input type="hidden" asp-for="RenewalHistory.Id" />
        <input type="hidden" asp-for="RenewalHistory.EnrollmentId" />


        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Last Renewal Date
            </label>
            <input type="text" maxlength="10" class="form-control col-sm-4 col-md-4" asp-for="TheMember.TaxIdNumber" />
        </div>

        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Invoice No
            </label>
            <input type="text" maxlength="50" readonly disabled class="form-control col-sm-8 col-md-8" asp-for="RenewalHistory.InvoiceNo" />
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Amount
            </label>
            <input type="number" readonly disabled class="form-control col-sm-8 col-md-8" asp-for="RenewalHistory.Fee" />
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Receipt No
            </label>
            <input type="text" maxlength="50" class="form-control col-sm-4 col-md-4" asp-for="RenewalHistory.ReceiptNo" />
        </div>

        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Location
            </label>


            <select id="locationSelectorId" class="custom-select col-sm-8 col-md-9" asp-for="TheMember.LocationId"
                    onchange="loadLocation()"></select>

        </div>

  


        <div class="row form-group">
            <div class="col-sm-12">
                <input type="submit" value="Save"
                       class="btn btn-primary">

            </div>
        </div>
    </form>


    
</div>
<script>


   

</script>