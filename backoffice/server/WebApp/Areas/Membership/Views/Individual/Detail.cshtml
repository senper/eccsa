            </div>
        </div>
    </div>
</div>

@section script {
    <script>
        function previewPdf(e) {
            const title = document.getElementById('previewTitle');

            const frame = document.getElementById('frame');
            const longDiv = document.getElementById('longText');

            frame.style.display = "none";
            longDiv.style.display = "none";

            const srcVal = $(e).attr('data-src');
            const textVal = $(e).attr('data-text');

            const titleVal = $(e).attr('data-title');

            title.innerHTML = titleVal;
            if (srcVal.length > 2) {
                frame.style.display = '';
                $("#frame").attr("src", srcVal);
            } else {
                longDiv.style.display = '';
                longDiv.innerHTML = textVal;
            }
        }

        loadLocation();
        function locationChanged() {
            document.getElementById('hdnlocationSelected').value = document.getElementById('locationSelectorId').value;
            loadLocation();
        }

        function loadLocation() {
            const id = document.getElementById('hdnlocationSelected').value;
            let selectedV = '';
            let url = `/membership/individual/getlocation`;
            jQuery.get(url, { parentId: id }, function (data) {
                $('#locationSelectorId')
                    .empty();
                $.each(data.$values, function (index, value) {
                    selectedV = '';
                    if (id == value.id) {
                        selectedV = `selected="selected"`;
                    }
                    const option = `<option  ${selectedV} value="${value.id}">${value.name}</option>`;
                    $('#locationSelectorId').append(option);
                });
            });

        }

        $('.edit').on('click', function () {
            var url = $(this).attr('data-url');
            $($(this).attr('data-target')).find(".modal-content").html("");

            $($(this).attr('data-target')).find(".modal-content").each(function (index, item) {
                $(item).html("");

                if (url && url.length > 0) {
                    $(item).load(url);
                }
            });
        });

        function confirmDelete(form) {
            $.confirm({
                icon: 'fa fa-exclamation-triangle',
                title: 'Confirm!',
                content: 'Are you sure want to Delete ?',
                buttons: {
                    yes: function () {
                        form.submit();
                    },
                    no: function () {
                    }
                }
            });
            return false;
        }

        function confirmation(form, text) {
            $.confirm({
                icon: 'fa fa-exclamation-triangle',
                title: 'Confirm!',
                content: 'Are you sure want to ' + text + ' ?',
                buttons: {
                    yes: function () {
                        form.submit();
                    },
                    no: function () {
                    }
                }
            });
            return false;
        }

        function validateStatus() {
            const renewalStatus = document.getElementById('renewalStatus');
            const statusRemark = document.getElementById('statusRemark');
            const expiryDate = document.getElementById('expiryDate');
            const statusSubmit = document.getElementById('statusSubmit');
            const status = Number(renewalStatus.value);
            statusSubmit.disabled = true;
            statusRemark.disabled = true;
            expiryDate.disabled = true;
            if (status === 5) {
                expiryDate.disabled = false;
                statusSubmit.disabled = false;
            } else if (status == 9) {
                statusRemark.disabled = false;
                statusSubmit.disabled = false;
            }
        }

        //validateStatus();

        $('#additionalInfoCollapse').on('hide.bs.collapse', function () {
            $("#additionalInfoCollapseLink").html("Click To Show Additional Info.")
        })
        $('#additionalInfoCollapse').on('show.bs.collapse', function () {
            $("#additionalInfoCollapseLink").html("Click To hide Additional Info.")
        })
    </script>
}
