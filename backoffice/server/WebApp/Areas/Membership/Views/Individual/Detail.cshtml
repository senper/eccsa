                        <label class="col-sm-4 col-md-3 col-form-label">
                            Woreda (Keb.)
                        </label>
                        <input type="text" name="Woreda" asp-for="TheModel.IdCard.Woreda" maxlength="20" class="form-control col-sm-9 col-md-8" required />
                    </div>


                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            House No
                        </label>
