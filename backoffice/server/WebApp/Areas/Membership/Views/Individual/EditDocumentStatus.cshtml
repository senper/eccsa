@using ECCSA.BackOffice.Server.Model.Common
@using ECCSA.BackOffice.Server.Model.Membership
@model ECCSA.BackOffice.Server.WebApp.Areas.Membership.Model.IndividualViewModel

<link href="~/vendor/combotree/style.css" rel="stylesheet" />
<div class="modal-header">
    <h5 class="modal-title">@(Model.LegalDocument.Id == Guid.Empty ? "Create New Member" : "Edit Member Info") </h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <form data-parsley-validate novalidate method="post" enctype="multipart/form-data"
          asp-action="UpdateDocumentStatus" asp-antiforgery="true">
        <input type="hidden" asp-for="LegalDocument.Id" />
        <input type="hidden" asp-for="LegalDocument.IndividualId" />
        <input type="hidden" asp-for="TheModel.Id" />


        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Document Type
            </label>
            <span>@Model.LegalDocument.LegalDocumentType.Name</span>

        </div>

        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Title
            </label>
            <span>@Model.LegalDocument.Document</span>
        </div>
        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Approval
            </label>
            <select class="custom-select col-sm-8 col-md-9"
                    asp-for="LegalDocument.Status">
                <option value="0">Please select ...</option>
                <option value="2">Accepted</option>
                <option value="3">Rejected</option>
                <option value="4">Not Applicable</option>
            </select>
        </div>

        <div class="row form-group">
            <label class="col-sm-4 col-md-3 col-form-label">
                Remark
            </label>
            <input type="text" maxlength="10" class="form-control col-sm-4 col-md-4" asp-for="TheModel.Remark" />
        </div>



        <div class="row form-group">
            <div class="col-sm-12">
                <input type="submit" value="Save"
                       class="btn btn-primary">

            </div>
        </div>
    </form>


    
</div>
