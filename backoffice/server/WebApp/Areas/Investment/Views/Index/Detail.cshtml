@model ECCSA.BackOffice.Server.WebApp.Areas.Investment.Model.BusinessViewModel

@{
    ViewData["Title"] = "Business Interests";
    Layout = "~/Views/Shared/_InvestmentLayout.cshtml";
}
<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <a href="@Url.Action("Index",Model.Controller,new { Area =Model.Area})" class="btn btn-outline-info"><i class="fa fa-angle-double-left" aria-hidden="true"></i>back</a>
    </div>
    <div class="row">

        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="row">

                        <div class="col-sm-11">

                            <h4>  @Model.TheModel.Name  </h4>
                        </div>
                        <div class="col-sm-1">
                             <a onclick="return confirmDelete($('#deleteInterest'));"
                               class=" btn btn-sm btn-outline-danger float-right">
                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                    </a>
                                    <form data-parsley-validate novalidate method="post" id="deleteInterest"
                                        asp-action="Delete" asp-antiforgery="true">
                                        <input type="hidden" name="id" value="@Model.TheModel.Id" />
                                        
                                    </form>
                            <button data-toggle="modal"
                                    data-target="#theModal"
                                    title="Edit"
                                    class=" float-right btn btn-outline-success btn-sm">
                                <i class="fa fa-pen "></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-9">
                            <div class="row">
                                <div class="col-sm-4">
                                    Sector:
                                </div>
                                <div class="col-sm-8">
                                    @Model.TheModel.Sector
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-4">
                                    Profile
                                </div>
                                <div class="col-sm-8">
                                    @Model.TheModel.Profile
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-4">
                                    Country
                                </div>
                                <div class="col-sm-8">
                                    @Model.TheModel.Country
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-4">
                                    Address
                                </div>
                                <div class="col-sm-8">
                                    @Model.TheModel.Address
                                </div>
                            </div>


                            <div class="row">
                                <div class="col-sm-4">
                                    Email
                                </div>
                                <div class="col-sm-8">
                                    @Model.TheModel.Email
                                </div>
                            </div>


                            <div class="row">
                                <div class="col-sm-4">
                                    Telephone
                                </div>
                                <div class="col-sm-4">
                                    @Model.TheModel.Telephone
                                </div>
                                <div class="col-sm-4">
                                    @if (!Model.TheModel.PhoneConfirmed)
                                    {
                                       @* <button class="col-md-4 edit  btn btn-sm btn-outline-primary shadow-sm"
                                                data-toggle="modal"
                                                data-target="#confirmPhoneModal"
                                                title="Manual Phone Confirmation">
                                            Confirm
                                        </button>*@
                                    }

                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-4">
                                    TINo
                                </div>
                                <div class="col-sm-8">
                                    @Model.TheModel.TINo
                                </div>
                            </div>


                            <div class="row">
                                <div class="col-sm-4">
                                    Contact Person
                                </div>
                                <div class="col-sm-8">
                                    @Model.TheModel.ContactPerson
                                </div>
                            </div>


                            <div class="row">
                                <div class="col-sm-4">
                                    Products / Services
                                </div>
                                <div class="col-sm-8">
                                    @Model.TheModel.Products
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-4">
                                    Est. Year (G.C)
                                </div>
                                <div class="col-sm-8">
                                    @Model.TheModel.YearOfEstablishment
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-4">
                                    Working Capital
                                </div>
                                <div class="col-sm-8">
                                    @Model.TheModel.WorkingCapital
                                </div>
                            </div>

                            <br />

                        </div>

                    </div>

                </div>
            </div>
        </div>

    </div>
    <br />

</div>

@if (!Model.TheModel.PhoneConfirmed)
{
    <div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="confirmPhoneModal">
        <div class="modal-dialog modal-md">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="questionTitle">Confirm Phone</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form data-parsley-validate method="post"
                          asp-action="ConfirmPhone" asp-antiforgery="true">
                        <input type="hidden" name="requestId" value="@Model.TheModel.Id" />

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Code
                            </label>
                           
                                <input type="text"  asp-for="TheModel.SMSCode" disabled />
                            
                        </div>

                        <div class="row form-group">
                            <div class="col-sm-12">
                                <input type="submit" value="Confirm" class="btn btn-primary">

                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
<div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="theModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Edit Media Agency</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form data-parsley-validate novalidate method="post"
                      asp-action="Save" asp-antiforgery="true">
                    <input type="hidden" name="Id" value="@Model.TheModel.Id" />

                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Name
                        </label>
                        <input type="text" name="Name" maxlength="100" asp-for="TheModel.Name" class="form-control col-sm-8 col-md-9" required />
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Sector
                        </label>
                        <input type="text" name="Sector" maxlength="100" asp-for="TheModel.Sector" class="form-control col-sm-8 col-md-9" required />
                    </div>

                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Profile
                        </label>
                        <textarea rows="4" name="Profile" maxlength="800" asp-for="TheModel.Profile" class="form-control col-sm-8 col-md-9" required></textarea>
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Country
                        </label>
                        <input type="text" name="Country" maxlength="50" asp-for="TheModel.Country" class="form-control col-sm-8 col-md-9" required />
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Address
                        </label>
                        <textarea rows="4" name="Address" maxlength="100" asp-for="TheModel.Address" class="form-control col-sm-8 col-md-9" required></textarea>
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Email
                        </label>
                        <input type="email" name="Email" maxlength="50" asp-for="TheModel.Email" class="form-control col-sm-8 col-md-9" required />
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Telephone
                        </label>
                        <input type="text" name="Telephone" maxlength="50" asp-for="TheModel.Telephone" class="form-control col-sm-8 col-md-9" required />
                    </div>

                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            TINo
                        </label>
                        <input type="text" name="TINo" maxlength="20" asp-for="TheModel.TINo" class="form-control col-sm-8 col-md-9" required />
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Contact Person
                        </label>
                        <input type="text" name="ContactPerson" asp-for="TheModel.ContactPerson" maxlength="50" class="form-control col-sm-8 col-md-9" required />
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Products/Services
                        </label>
                        <input type="text" name="Products" asp-for="TheModel.Products" maxlength="100" class="form-control col-sm-8 col-md-9" required />
                    </div>

                    
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Est. Year
                        </label>
                        
                        <div class="input-group col-sm-7 col-md-8" style="padding-left: 0px; padding-right: 0px;">
                        <input type="number" name="YearOfEstablishment" asp-for="TheModel.YearOfEstablishment" max="@DateTime.Today.Year" class="form-control col-sm-8 col-md-9" required />
                        <div class="input-group-append">
                            <span class="input-group-text" id="basic-addon2">G.C</span>
                        </div>
                    </div>
                    </div>
                    
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Working Capital
                        </label>
                        <div class="input-group col-sm-7 col-md-8" style="padding-left: 0px; padding-right: 0px;">
                           <input type="number" name="WorkingCapital" asp-for="TheModel.WorkingCapital" class="form-control col-sm-8 col-md-9" required />
                            <div class="input-group-append">
                                <span class="input-group-text" id="basic-addon2">1,000 Birr</span>
                            </div>
                        </div>
                    </div>



                    <div class="row form-group">
                        <div class="col-sm-12">
                            <input type="submit" value="Save"
                                   class="btn btn-primary">

                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section script {
    <script>

        function confirmDelete(form) {
            $.confirm({
                icon: 'fa fa-exclamation-triangle',
                title: 'Confirm!',
                content: 'Are you sure want to Delete ?',
                buttons: {
                    yes: function () {
                        form.submit();
                    },
                    no: function () {
                    }
                }
            });
            return false;
        }
    </script>
}