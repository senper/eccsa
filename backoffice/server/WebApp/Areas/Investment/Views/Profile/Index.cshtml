@model ECCSA.BackOffice.Server.WebApp.Areas.Investment.Model.ProfileViewModel

@{
    ViewData["Title"] = "Region Sector Profile";
    Layout = "~/Views/Shared/_InvestmentLayout.cshtml";
   
}

<div class="container-fluid">

    
    <div class="row d-sm-flex align-items-center justify-content-between" style="margin-left:15px;margin-bottom:2px;">
        <div class=" btn-group" role="group" aria-label="Basic example">



            <button class="d-none d-sm-inline-block btn btn-sm btn-outline-primary shadow-sm"
                    data-toggle="modal"
                    data-target="#AddBusinessSectorModal"
                    title="Add New Region / Sector">
                <i class="fas fa-plus fa-sm text-white-50"></i> Add New
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-12">

            <div class="card shadow mb-4">

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="dataTable" width="100%" cellpadding="0">
                            <thead>
                                <tr>
                                    <th> Name</th>
                                    <th> Type</th>


                                    <th></th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th> Name</th>
                                    <th>Type</th>

                                    <th></th>
                                </tr>
                            </tfoot>
                            <tbody>
                                @foreach (var item in Model.TheList)
                                {


                                    <tr>
                                        <td>
                                           
                                                <a asp-controller="@Model.Controller" asp-action="Detail" asp-route-id="@item.Id" class="title ">
                                                    @Html.DisplayFor(modelItem => item.NameFull)
                                                </a>
                                            
                                        </td>
                                        <td>@item.Type </td>

                                        <td>
                                            <div class="btn-group" role="group" aria-label="Basic example">
                                                @if (!item.IsCountry)
                                                {

                                                    <a onclick="return confirmDelete($('#deleteSector@(Model.Guid2String(item.Id))')[0]);"
                                               class=" btn btn-sm btn-outline-danger">
                                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                                    </a>
                                                    <form data-parsley-validate novalidate method="post" id="deleteSector@(Model.Guid2String(item.Id))"
                                                  asp-action="DeleteProfile" asp-antiforgery="true">
                                                        <input type="hidden" name="Id" value="@item.Id" />

                                                    </form>



                                                }




                                            </div>


                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>



</div>

<div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="AddBusinessSectorModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New Profile </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                


                   <form data-parsley-validate novalidate method="post"
                      asp-action="Save" asp-antiforgery="true">
                    <input type="hidden" name="Id" value="@Guid.Empty" />

                    <div class="row form-group" style="margin-bottom:1px;">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Name
                        </label>
                        <input type="text" name="Name" maxlength="100" placeholder="name in english" class="form-control col-sm-8 col-md-9" required />
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            
                        </label>
                        <input type="text" name="NameLocal" maxlength="100" placeholder="ስም በአማርኛ" class="form-control col-sm-8 col-md-9" required />
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label" for="isRegion">
                          
                        </label>
                        <div class="col col-md-3" style="padding-left: 20px;">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isRegion" name="IsRegion" title="Check if it is region">
                                <label class="form-check-label" for="isRegion">Is Region</label>
                            </div>
                        </div>
                       
                    </div>

                    <div class="row form-group">
                        <div class="col-sm-12">
                            <input type="submit" value="Save"
                                   class="btn btn-primary">

                        </div>
                    </div>
                </form>




            </div>
        </div>
    </div>
</div>

@section script {


<script>



    function confirmDelete(form) {
        $.confirm({
            icon: 'fa fa-exclamation-triangle',
            title: 'Confirm!',
            content: 'Are you sure want to Delete ?',
            buttons: {
                yes: function () {
                    form.submit();
                },
                no: function () {
                }
            }
        });
        return false;
    }
</script>
}