@model ECCSA.BackOffice.Server.WebApp.Areas.MandE.Model.PlanViewModel

@{
    ViewData["Title"] = Model.PageTitle;
    Layout = Model.LayoutPage;

}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">

        <a href="@Url.Action("Index","Planning",new { Area ="MandE", module=Model.CurrentModule})" class="btn btn-outline-info">
            <i class="fa fa-angle-double-left" aria-hidden="true"></i>
            back
        </a>

    </div>
    <div class="row">

        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="row">

                        <div class="col-sm-11">

                            <h4>  @Model.TheModel.Name </h4>
                        </div>
                                    <div class="modal-body"  id="AddNewPlanModal">
                                                    <div class="modal-header">
                                                <h5 class="modal-title" > Edit Plan</h5>
                                                
                                      </div><br>
                                <form data-parsley-validate method="post"
                                      asp-action="EditPlan" asp-route-id="@Model.TheModel.Id"  asp-antiforgery="true">
                                    <input type="hidden" asp-for="TheModel.Id" />
                                    <div class="row form-group">
                                        <label class="col-sm-1 col-md-1 col-form-label">
                                            #
                                        </label>
                                        <input type="text"  class="form-control col-sm-2 col-md-2" asp-for="@Model.TheModel.Code" required/>
                                          <label class="col-sm-2 col-md-2 col-form-label">
                                            Item
                                        </label>
                                        <input type="text"  class="form-control col-sm-7 col-md-7" asp-for="TheModel.Name" required/>
                                    </div>
                                    <div class="row form-group">
                                      
                                    </div>
                                    <div class="row form-group">
                                        <label class="col-sm-4 col-md-3 col-form-label">
                                            Unit
                                        </label>
                                        <select  class="custom-select col-sm-7 col-md-8" asp-for="TheModel.Unit" required>
                                            <option value="0">None</option>
                                            <option value="1">Percentage</option>
                                            <option value="2">Number</option>
                                        </select>
                                   </div>
        
        
                                    <div class="row form-group">
                                        <label class="col-sm-4 col-md-3 col-form-label">
                                            Annual Target
                                        </label>
                                        <input type="text"  class="form-control col-sm-7 col-md-8" asp-for="TheModel.PlanAmount" />
                                    </div>

                                    <div class="row form-group">
                                        <label class="col-sm-4 col-md-3 col-form-label">
                                            Expected Result
                                        </label>
                                        <input type="text"  class="form-control col-sm-7 col-md-8" asp-for="TheModel.ExpectedResult" />
                                    </div>
                                    <div class="row form-group">
                                        <div class="col align-self-start">
                                        
                                            Hamle
                                       
                                        <input type="text"  class="form-control col-sm-7 col-md-8" asp-for="TheModel.Month01.Plan" />
                                        </div>
                                        <div class="col align-self-center">
                                        
                                            Nehase
                                        
                                        <input type="text"  class="form-control col-sm-7 col-md-8" asp-for="TheModel.Month02.Plan" />
                                        </div>
                                        
                                        <div class="col align-self-end">
                                            
                                            Meskerem
                                        
                                        <input type="text"  class="form-control col-sm-7 col-md-8" asp-for="TheModel.Month03.Plan" />

                                        </div>

                                    </div>

                                    

                                    <div class="row form-group">
                                        <div class="col align-self-start">
                                        
                                            Tikimt
                                        
                                        <input type="text"  class="form-control col-sm-7 col-md-8" asp-for="TheModel.Month04.Plan" />
                                        </div>
                                        <div class="col align-self-center">
                                        
                                            Hidar
                                        
                                        <input type="text"  class="form-control col-sm-7 col-md-8" asp-for="TheModel.Month05.Plan" />
                                        </div>
                                        
                                        <div class="col align-self-end">
                                            
                                            Tahsas
                                        
                                        <input type="text"  class="form-control col-sm-7 col-md-8" asp-for="TheModel.Month06.Plan" />
                                        </div>
                                    </div>

                                    

                                    <div class="row form-group">
                                        <div class="col align-self-start">
                                        
                                            Tir
                                        
                                        <input type="text"  class="form-control col-sm-7 col-md-8" asp-for="TheModel.Month07.Plan" />
                                        </div>
                                        <div class="col align-self-center">
                                        
                                            Yekatit
                                        
                                        <input type="text"  class="form-control col-sm-7 col-md-8" asp-for="TheModel.Month08.Plan" />
                                        </div>
                                        
                                        <div class="col align-self-end">
                                            
                                            Megabit
                                        
                                        <input type="text"  class="form-control col-sm-7 col-md-8" asp-for="TheModel.Month09.Plan" />
                                        </div>
                                    </div>

                                    

                                    <div class="row form-group">
                                        <div class="col align-self-start">
                                        
                                            Miyazya
                                        
                                        <input type="text"  class="form-control col-sm-7 col-md-8" asp-for="TheModel.Month10.Plan" />
                                        </div>
                                        <div class="col align-self-center">
                                        
                                            Ginbot
                                        
                                        <input type="text"  class="form-control col-sm-7 col-md-8" asp-for="TheModel.Month11.Plan" />
                                        </div>
                                        
                                        <div class="col align-self-end">
                                            
                                            Sene
                                        
                                        <input type="text"  class="form-control col-sm-7 col-md-8" asp-for="TheModel.Month12.Plan" />
                                        </div>
                                    </div>

                                    

                                    <div class="row form-group">
                                        <div class="col align-self-start">
                                            
                                            Estimated Budget:
                                        
                                        <input type="text"  class="form-control col-sm-7 col-md-8" asp-for="TheModel.EstimatedBudget" />
                                        </div>

                                        <div class="col align-self-center">
                                             
                                            From Chamber:
                                        
                                        <input type="text"  class="form-control col-sm-7 col-md-8" asp-for="TheModel.FromChamber" />
                                        </div>

                                        <div class="col align-self-end">
                                            
                                            From Donor:
                                        
                                        <input type="text"  class="form-control col-sm-7 col-md-8" asp-for="TheModel.FromDonor" />
                                        </div>
                                        
                                    </div>
        
                                <div class="row form-group">
                                    <div class="col-sm-12">
                                        <input type="submit" value="Save"  class="btn btn-primary btn-sm" id="savebtn"> &nbsp;
                                        <input type="button" value="Cancel" onclick="editPlan(false);"  class="btn btn-warning btn-sm" id="cancelbtn"> &nbsp

                                    </div>
                                </div>
                    </form>
                 </div>
                    </div>
                </div>
                

                </div>
            </div>
        </div>

    </div>
 








@section script {
<script src="~/js/confirmation.js"></script>
<script src="~/js/validation.js"></script>
<script src="~/js/serviceTypeValidation.js"></script>
	$("#datatblquestion").treetable({ expandable: false });
<script>
        function confirmDelete(form) {
        $.confirm({
            icon: 'fa fa-exclamation-triangle',
            title: 'Confirm!',
            content: 'Are you sure want to Delete ?',
            buttons: {
                yes: function () {
                    form.submit();
                },
                no: function () {
                }
            }
        });
        return false;
    }

      function confirmAction(form) {
        $.confirm({
            icon: 'fa fa-exclamation-triangle',
            title: 'Confirm!',
            content: 'Are you sure want to Change Status ?',
            buttons: {
                yes: function () {
                    form.submit();
                },
                no: function () {
                }
            }
        });
        return false;
    }
        function showHideAnswers(e) {
            const ank = $(e);
            let show = true;
            for (let i = 0; i < ank[0].children.length; i++) {
                const child = ank[0].children[i];
                if (child.localName == 'i') {
                    if (child.classList.contains('fa-angle-right')) {
                        show = true;
                        child.classList.remove('fa-angle-right');
                        child.classList.add('fa-angle-down');
                    } else {
                        show = false;
                        child.classList.add('fa-angle-right');
                        child.classList.remove('fa-angle-down');
                    }
                }
            }
            const className = ank.attr('data-tt');

            const rows = document.getElementsByClassName(className);
            for (let i = 0; i < rows.length; i++) {
                if (show) {
                    rows[i].style.display = '';
                } else {
                    rows[i].style.display = 'none';
                }
            }

        }


        function inputTypeChanged(e) {
            const val = Number(e.value);

            const rangeDiv = document.getElementById('lookupDiv');
            if (val === 10) {
                rangeDiv.style.display = '';
            } else {
                rangeDiv.style.display = 'none';
            }
        }
        onRateChanged();


        function editChoice(e) {
            const id = document.getElementById('choiceId');
            const title = document.getElementById('choiceTitle');
            const qid = document.getElementById('choiceQuestionId');
            const orderNo = document.getElementById('choiceOrderNo');
            const choiceText = document.getElementById('choiceText');

            const idVal = $(e).attr('data-id');
            const qidVal = $(e).attr('data-qid');
            const orderVal = $(e).attr('data-orderno');
            const choiceVal = $(e).attr('data-choice');
            const titleVal = $(e).attr('data-title');

            id.value = idVal;
            qid.value = qidVal;
            orderNo.value = orderVal;
            choiceText.value = choiceVal;
            title.innerHTML = titleVal;


        }

        function questionTypeChanged(e) {
            const val = Number(e.value);

            const rangeDiv = document.getElementById('rangeDiv');
            if (val === 3) {
                rangeDiv.style.display = '';
            } else {
                rangeDiv.style.display = 'none';
            }
        }

        function showParent(e) {
            const checked = Boolean(e.checked);
            showHideParent(checked);

        }

        function showHideParent(checked) {
            const parentChoiceDiv = document.getElementById('parentChoiceDiv');
            if (checked) {
                parentChoiceDiv.style.display = '';
            } else {
                parentChoiceDiv.style.display = 'none';
            }
            const parentOpt = document.getElementById('parentChoice');
            const qId = document.getElementById('questionId').value;
            const val = document.getElementById('settingAllChoices').value;

            const choices = JSON.parse(val);
            console.log(choices);
            $("#parentChoice").empty();
            for (let i = 0; i < choices.length; i++) {
                let item = choices[i];

                if (item != null && item.SimpleChoices != null && item.Id != qId) {
                    var optGrp = document.createElement("optgroup");
                    optGrp.label = `${item.OrderNo} ${item.Question}`
                    for (let j = 0; j < item.SimpleChoices.length; j++) {
                        let itm = item.SimpleChoices[j];
                        var opt = document.createElement("option");
                        opt.value = itm.Id;
                        opt.innerHTML = itm.ChoiceText;
                        optGrp.appendChild(opt);
                    }
                    parentOpt.appendChild(optGrp);
                }

            }

        }

        function editRequirement(e) {
            const id = document.getElementById('requirementId');
            const orderNo = document.getElementById('requirementOrderNo');
            const nameEng = document.getElementById('nameEngRequirement');

            const label = document.getElementById('labelRequirement');
            const descEng = document.getElementById('DescriptionEngRequirement');
            const approve = document.getElementById('approveOnSubmit');


            const idVal = $(e).attr('data-id');
            const orderVal = $(e).attr('data-orderno');
            const nameVal = $(e).attr('data-name');
            const labelVal = $(e).attr('data-label');
            const lookupVal= $(e).attr('data-lookuptype');
            const descVal = $(e).attr('data-desc');
            const typeVal = Number($(e).attr('data-type'));
            const approveVal = Boolean($(e).attr('data-approve'));
            id.value = idVal;
            orderNo.value = orderVal;
            nameEng.value = nameVal;
            label.value = labelVal;
            descEng.innerHTML = descVal;
            approve.value = approveVal;

            $('#inputMethodRequirement').val(typeVal).change();
            editRequirementInvoice(e);
            editRequirementGroup(e);
        }


</script>
}