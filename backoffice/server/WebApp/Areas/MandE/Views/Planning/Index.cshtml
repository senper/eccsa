@using ECCSA.BackOffice.Server.Model.Common
@using ECCSA.BackOffice.Server.Model.Common.Planning
@model ECCSA.BackOffice.Server.WebApp.Areas.MandE.Model.PlanViewModel

@{
    ViewData["Title"] = "Planning";// = Model.PageTitle;
    Layout = Model.LayoutPage;

    var isSubmitable = Model.TheList.Any(p => p.CanBeSubmitted);
    var rejected = Model.TheList.Any(p => p.Status == PlanningStatusEnum.Rejected);
}
@{
    async Task Template(Plan parent, string parentCode, List<Plan> subPlans, string padding)
    {
        await BuildRow(parent, parentCode, subPlans, padding);


        padding += "&nbsp;&nbsp;&nbsp;";
        foreach (var ind in subPlans)
        {
            var plans = Model.TheList.Where(p => p.ParentId == ind.Id).OrderBy(p => p.Code).ToList();
            await Template(ind, parent.InternalCode, plans, padding);
        }


    }

    async Task BuildRow(Plan ind, string parentCode, List<Plan> subPlans, string padding)
    {
        var planningPhase = Model.PlanPhase == PlanningPhaseEnum.Planning;
        var labelWithNoChild = ind.IsLabel && subPlans.Count == 0;
        var nonLabelNonSubmitted = !ind.IsLabel && (ind.Status == PlanningStatusEnum.Planning || ind.Status == PlanningStatusEnum.Rejected);
        var hasChildren = Model.HasChildren(ind.Id);
        var labelSubPlan = subPlans.Count == 0 || subPlans.All(p => p.IsLabel);
        var nonLabelSubPlan = subPlans.Count == 0 || subPlans.All(p => !p.IsLabel);
        var unSubmitted = ind.Status == PlanningStatusEnum.Planning || ind.Status == PlanningStatusEnum.Rejected;
        var ownedIndicator = ind.ResponsibleUnit == Model.CurrentSubsystem && ind.SupportingUnitId == Model.SupportingUnitId;
        var unitName = @ind.ResponsibleUnit.GetDisplayName();
        var leafs = Model.TheList.Where(p => !p.IsLabel && p.InternalCode.StartsWith(ind.InternalCode) && p.Id != ind.Id).ToList();
        var status = ind.IsLabel ? PlanningStatusEnum.None :
        ind.Status;
        if (leafs.Count > 0)
        {
            if (leafs.Any(l => l.Status == PlanningStatusEnum.Rejected))
                status = PlanningStatusEnum.Rejected;
            else if (leafs.Any(l => l.Status == PlanningStatusEnum.Planning))
                status = PlanningStatusEnum.Planning;
            else if (leafs.Any(p => p.Status == PlanningStatusEnum.Submitted))
                status = PlanningStatusEnum.Submitted;
            else if (leafs.Any(l => l.Status == PlanningStatusEnum.Approved))
                status = PlanningStatusEnum.Approved;

        }
        var parentTt = !ind.ParentId.HasValue ? "root" : $"child";
        @if (!Model.TreeView)
        {
            parentTt = string.Empty;
            parentCode = string.Empty;
        }
        <tr class="@parentTt @parentCode" id="@ind.InternalCode">
            <td>
                @Html.Raw(@padding)
                @if (hasChildren && Model.TreeView)
                {
                    <a data-tt="@ind.InternalCode" onclick="showHideChildren(this);" class="title"><i class="fas fa-angle-right"></i>@ind.NameWithCode </a>
                }
                else
                {
                    @ind.NameWithCode
                }
            </td>

            <td>@ind.UnitName </td>

            <td>@ind.PlanAmountName</td>
            <td>@ind.ExpectedResult</td>
            <td>@ind.EstimatedBudgetName</td>
            <td style="@(Model.StatusStyle(status))">
                @status.GetDisplayName()
                @if (ind.ResponsibleUnit == Model.CurrentSubsystem)
                {
                    @if (ind.Status == PlanningStatusEnum.Rejected)
                    {
                        <br />
                        <small>@ind.Remark</small>
                    }
                }

            </td>
            <td>
                <div class="col-sm-2 btn-group" role="group" aria-label="Basic example">


                    @if (!ind.IsLabel && ownedIndicator)
                    {
                        <a class="btn btn-sm  btn-outline-info"
               asp-controller="Planning"
               asp-action="Detail"
               asp-route-id="@ind.Id"
               asp-route-subsystem="@Model.CurrentSubsystem">
                            <i class="fa fa-info" aria-hidden="true"></i>
                        </a>
                    }
                    @if (Model.RoleLevel == RoleLevelEnum.Admin && planningPhase)
                    {
                        @if (ownedIndicator && (labelWithNoChild || nonLabelNonSubmitted))
                        {

                            <a onclick="return confirmDelete($('#deleteLabel@(Model.Guid2String(ind.Id))')[0]);"
                               class=" btn btn-sm btn-outline-danger">
                                <i class="fa fa-trash" aria-hidden="true"></i>
                            </a>
                            <form data-parsley-validate novalidate method="post" id="deleteLabel@(Model.Guid2String(ind.Id))"
                  asp-action="DeletePlanModule" asp-antiforgery="true">
                                <input type="hidden" name="id" value="@ind.Id" />
                                <input type="hidden" name="planYear" value="@Model.PlanYear" />
                                <input type="hidden" name="subsystem" value="@Model.CurrentModule" />
                            </form>
                        }




                        if (ind.IsLabel && nonLabelSubPlan)
                        {
                            <button class="createHeaderPlan btn btn-sm btn-outline-primary"
                                    data-toggle="modal"
                                    data-target="#planModal"
                                    data-id="@Guid.Empty"
                                    data-parent="@ind.Id"
                                    data-parentname='@ind.Name'
                                    data-code="@ind.Code"
                                    data-name="@ind.Name"
                                    data-plan="@ind.PlanAmount"
                                    data-result="@ind.ExpectedResult"
                                    data-unit="@((int)Model.CurrentModule)"
                                    data-budget="@ind.EstimatedBudget"
                                    data-donor="@ind.FromDonor"
                                    data-chamber="@ind.FromChamber"
                                    data-sunit="@ind.Unit"
                                    onclick="editPlan(this);"
                                    title="Create Plan">
                                <i class="fas fa-plus fa-sm "></i>
                            </button>
                        }
                        if (ind.IsLabel && ownedIndicator && labelSubPlan)
                        {
                            <button data-toggle="modal"
                                    data-target="#createLabelModal"
                                    title="Create Plan Header"
                                    data-parent="@ind.Id"
                                    data-parentname="@ind.Name"
                                    onclick="createChildName(this);"
                                    class=" float-right edit btn btn-outline-primary btn-sm">
                                <i class="fas fa-clipboard fa-sm"></i>
                            </button>


                        }

                    }

                </div>
            </td>
        </tr>
    }
}
<div class="container-fluid">


    <div class="row">
        <div class="col-12">

            <div class="card shadow mb-4">
                <div class="card-header">
                    <div class="col-md-6 col-sm-6">
                        <label for="yearfrom" class="col-sm-8 col-form-label">Year: @Model.PlanYear Ver. @Model.PlanVersionNo (@Model.PlanPhase.GetDisplayName())</label>

                    </div>
                    <div class="col-md-6">
                        @if (isSubmitable)
                        {
                            <form data-parsley-validate method="post" id="submitform"
                              asp-action="SubmitPlans" asp-antiforgery="true">
                                <label for="yearfrom" class="col-sm-8 col-form-label">Planning for the Year: @Model.PlanYear </label>
                                <input type="hidden" name="PlanYear" value="@Model.PlanYear" />
                                <input type="hidden" name="subSystem" value="@Model.CurrentSubsystem" />
                                <input type="button" value="Submit Plans" class="btn btn-warning btn-sm float-right"
                                       onclick="return confirmAction($('#submitform')[0], 'Submit Plan(s)')" />
                            </form>
                        }

                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <form data-parsley-validate method="get" id="filterForm" class="row g-3" style="padding-left: 20px;"
                              asp-action="Index" asp-antiforgery="true">

                            <input type="hidden" name="subSystem" value="@((int)Model.CurrentSubsystem)" />



                            <div class="col col-md-3" style="padding-left: 20px;">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="idTreeView" name="treeMode" onclick='document.getElementById("filterForm").submit(); return false;' asp-for="@Model.TreeView">
                                    <label class="form-check-label" for="idTreeView">Tree View</label>
                                </div>
                            </div>



                        </form>
                    </div>
                    <hr />
                    <div class="form-group row">
                        <div class="col-sm-12 table-responsive">

                            <table id="example1" class="table table-bordered">
                                <thead>
                                    <tr>

                                        <th style="width:400px;">Name</th>
                                        <th style="width:50px;">Unit</th>

                                        <th>Plan</th>
                                        <th>Expected Result</th>
                                        <th>Est. Budget '000</th>
                                        <th>Status</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="tableDetail">
                                    @{
                                        if (Model.TreeView)
                                        {
                                            @foreach (var root in Model.RootPlans)
                                            {
                                                var subPlans = Model.TheList.Where(p => p.ParentId == root.Id).OrderBy(p => p.Code).ToList();
                                                await Template(root, "", subPlans, "");
                                            }
                                        }
                                        else
                                        {
                                            foreach (var plan in Model.TheList)
                                            {
                                                await BuildRow(plan, "", new List<Plan>(), "");
                                            }
                                        }
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <span style="font-size: larger; margin: 0px; padding: 5px;">Color Legend: </span>
                            <span style="@Model.StatusStyle(PlanningStatusEnum.Planning) font-size: larger; margin: 0px; padding: 5px;">Planning</span>
                            <span style="@Model.StatusStyle(PlanningStatusEnum.Submitted) font-size: larger; margin: 0px; padding: 5px;">Submitted</span>
                            <span style="@Model.StatusStyle(PlanningStatusEnum.Rejected) font-size: larger; margin: 0px; padding: 5px;">Rejected</span>
                            <span style="@Model.StatusStyle(PlanningStatusEnum.Approved) font-size: larger; margin: 0px; padding: 5px;">Approved</span>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.RoleLevel == RoleLevelEnum.Admin)
{

    <div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="planModal">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Add/Edit Plan</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form data-parsley-validate method="post"
                      asp-action="SaveMainPlan" asp-antiforgery="true">
                        <input type="hidden" name="Id" id="pId" />
                        <input type="hidden" name="PlanYear" value="@Model.PlanYear" />
                        <input type="hidden" name="subSystem" value="@Model.CurrentSubsystem" />
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Parent
                            </label>
                            <span id="parentLabelId" class='col-sm-8 col-md-9'></span>

                            <input type="hidden" name="ParentId" id="parentIdValue" />
                        </div>
                        @if (Model.CurrentModule == ECCSAModuleFlag.Support && Model.IsFinance)
                        {
                            <div class="row form-group">
                                <label class="col-sm-4 col-md-3 col-form-label">
                                    Financial Item
                                </label>
                                <select name="FinancialItemId" id="financialItemId"
        class="form-select col-sm-8 col-md-9" onchange="financialItemChanged(this)"
                                asp-for="@Model.TheModel.FinancialItemId">
                                    @foreach (var fi in @Model.FinancialItems)
                                    {
                                        if (Model.TheModel.FinancialItemId.HasValue && Model.TheModel.FinancialItemId.Value == fi.Id)
                                        {
                                            <option selected value="@fi.Id" data-code="@fi.Code" data-name="@fi.Name">@fi.NameWithCode</option>
                                        }
                                        else
                                        {
                                            <option value="@fi.Id" data-code="@fi.Code" data-name="@fi.Name">@fi.NameWithCode</option>
                                        }
                                    }
                                </select>
                            </div>
                        }
                        <div class="row form-group financial">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                #
                            </label>
                            <input type="text" maxlength="20" name="Code" id="cId" placeholder="R.No" class="form-control col-sm-3 col-md-3" required />
                        </div>

                        <div class="row form-group financial">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Name
                            </label>

                            <input type="text" maxlength="250" name="Name" id="nId" class="form-control col-sm-8 col-md-9" required />
                        </div>
                        <div class="row form-group financial">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Target
                            </label>
                           
                            <input type="number" min="1" name="PlanAmount" id="tId" class="form-control col-sm-4 col-md-4" required />
                            <select name="Unit" id="unitId"
                                    class="form-select col-sm-4 col-md-5" required>
                                <option></option>
                                <option value="3">Percent(%)</option>
                                <option value="2">Count</option>
                                <option value="1">Money</option>
                            </select>
                        </div>

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Expected Result
                            </label>
                            <input type="text" maxlength="250" id="resultId" name="ExpectedResult" class="form-control col-sm-8 col-md-9" required />
                        </div>
                        <div class="row form-group financial">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Estimated Budget
                            </label>
                            <div class="input-group-append  col-sm-8 col-md-5" style="padding-left: 0px;">
                                <input type="number" min="0" id="budgetId" class="form-control" name="EstimatedBudget" required />

                                <span class="input-group-text" id="basic-addon2">Birr</span>
                            </div>
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Donor / Chamber
                            </label>
                            <div class="input-group-append col-sm-8 col-md-8" style="padding-left: 0px;">
                                <input type="number" min="0" id="donorId" name="FromDonor" class="form-control" onchange="financialValue()" required />
                                <input type="number" min="0" id="chamId" name="FromChamber" class="form-control" onchange="financialValue()" required />

                                <span class="input-group-text" id="basic-addon2">Birr</span>
                            </div>
                        </div>

                        <div class="row form-group">
                            <div class="col-sm-12">
                                <input type="submit" value="Save" class="btn btn-primary">

                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>



    <div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="createLabelModal">
        <div class="modal-dialog modal-md">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Create Private Label</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form data-parsley-validate method="post"
                      asp-action="CreateLabel" asp-antiforgery="true">
                        <input type="hidden" name="Id" />
                        <input type="hidden" name="PlanYear" value="@Model.PlanYear" />
                        <input type="hidden" name="subSystem" value="@Model.CurrentSubsystem" />
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                #
                            </label>
                            <input type="text" placeholder="No" title="code " maxlength="20" name="Code" class="form-control col-sm-5 col-md-5" required />
                        </div>

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Name
                            </label>
                            <input type="text" placeholder="plan title" title="Plan name or title" maxlength="250" name="Name" class="form-control col-sm-8 col-md-9" required />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Parent
                            </label>
                            <span id="parentHeaderIdLabel" class='col-sm-8 col-md-9'></span>
                            <input type="hidden" name="ParentId" id="parentHeaderId" />


                        </div>

                        <div class="row form-group">
                            <div class="col-sm-12">
                                <input type="submit" value="Save" class="btn btn-primary">

                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
@section script {


    <script>

        function changeValue(e) {
            const name = e.name;
            e.value = e.checked ? "true" : false;
            $(`input:hidden[name=${e.name}]`).attr('value', e.value);
        }
        function confirmAction(form, action) {
            $.confirm({
                icon: 'fa fa-exclamation-triangle',
                title: 'Confirm!',
                content: 'Are you sure want to ' + action + ' ?',
                buttons: {
                    yes: function () {
                        form.submit();
                    },
                    no: function () {
                    }
                }
            });
            return false;
        }

        function confirmDelete(form) {
            $.confirm({
                icon: 'fa fa-exclamation-triangle',
                title: 'Confirm!',
                content: 'Are you sure want to Delete ?',
                buttons: {
                    yes: function () {
                        form.submit();
                    },
                    no: function () {
                    }
                }
            });
            return false;
        }
        function createChildName(e) {
            const parentInput = document.getElementById('parentHeaderId');
            const parentNameInput = $('#parentHeaderIdLabel');

            const parent = $(e).attr('data-parent');
            const parentName = $(e).attr('data-parentname');
            parentInput.value = parent;
            parentNameInput.html(parentName);
        }

        function editPlan(e) {
            const sUnitInput = document.getElementById('supportingUnitId');


            const idVal = $(e).attr('data-id');
            const parentVal = $(e).attr('data-parent');
            const parentName = $(e).attr('data-parentname');
            const codeVal = $(e).attr('data-code');
            const nameVal = $(e).attr('data-name');
            const sunit = $(e).attr('data-sunit');

            const targetVal = $(e).attr('data-plan');
            const unitVal = $(e).attr('data-unit');
            const resultVal = $(e).attr('data-result');
            const budgetVal = $(e).attr('data-budget');

            const donorVal = $(e).attr('data-donor');
            const chamberVal = $(e).attr('data-chamber');

            document.getElementById('pId').value = idVal;
            document.getElementById("parentLabelId").innerText = parentName;
            document.getElementById('parentIdValue').value = parentVal;
            document.getElementById('cId').value = codeVal;
            document.getElementById('nId').value = nameVal;

            document.getElementById('tId').value = targetVal;
            document.getElementById('resultId').value = resultVal;
            document.getElementById('budgetId').value = budgetVal;

            document.getElementById('donorId').value = donorVal;
            document.getElementById('chamId').value = chamberVal;
            $('#supportingUnitId').val(sunit).change();

            $('#unitId').val(unitVal).change();

        }
        function cancelPlan() {

            document.getElementById('editbtn').hidden = false;
            document.getElementById('savebtn').hidden = true;
            document.getElementById('cancelbtn').hidden = true;
        }

        function hideChildren() {
            const children = document.getElementsByClassName('child');
            for (var i = 0; i < children.length; i++) {
                children[i].style.display = 'none';
            }
        }
        hideChildren();
        function hideDescendant(e) {
            console.log(e);
            const parent = $(e).attr('data-tt');
            const children = document.getElementsByClassName(parent);
            for (var i = 0; i < children.length; i++) {
                const child = children[i];
                child.style.display = 'none';
                //console.log(child.id, child, document.getElementsByClassName(child.id).length);
                if (document.getElementsByClassName(child.id).length > 0) {
                    $(child).find('i').removeClass('fa-angle-down');
                    $(child).find('i').addClass('fa-angle-right');
                    hideDescendant($(child).find('a')[0]);
                }

            }
        }

        function showHideChildren(e) {
            const ank = $(e);
            let show = true;

            for (let i = 0; i < ank[0].children.length; i++) {
                const child = ank[0].children[i];
                if (child.localName == 'i') {
                    if (child.classList.contains('fa-angle-right')) {
                        show = true;
                        child.classList.remove('fa-angle-right');
                        child.classList.add('fa-angle-down');
                    } else {
                        show = false;
                        child.classList.add('fa-angle-right');
                        child.classList.remove('fa-angle-down');
                    }
                }
            }

            if (show) {
                const parent = $(e).attr('data-tt');
                const children = document.getElementsByClassName(parent);
                for (var i = 0; i < children.length; i++) {
                    children[i].style.display = '';
                }
            }
            else {
                hideDescendant(e);
            }
        }

        function financialItemChanged(e) {
            var value = e.value;
            var text = e.options[e.selectedIndex].text;
            const opt = e.options[e.selectedIndex];
            const codeVal = opt.dataset.code;
            const nameVal = opt.dataset.name;
            console.log(codeVal);
            console.log(nameVal);
            const code = document.getElementById("cId");
            const name = document.getElementById("nId");

            code.value = codeVal;
            name.value = nameVal;
            const isFinancialItem = value !== "00000000-0000-0000-0000-000000000000";

            
            if (isFinancialItem) {
                $('#unitId').val(1).change();
            }
            let items = document.getElementsByClassName("financial");
            for (let i = 0; i < items.length; i++) {
                const item = items[i];
                item.style.display = isFinancialItem ? "none" : "";
            }
            
        }
        function financialValue() {
            const e = document.getElementById("financialItemId");
            const isFinancialItem = e.value !== "00000000-0000-0000-0000-000000000000";
            const donor = document.getElementById("donorId");
            const chamber = document.getElementById("chamId");

            let donorValue = isNaN(parseInt(donor.value)) ? 0 : parseInt(donor.value);
            let chamberValue = isNaN(parseInt(chamber.value)) ? 0 : parseInt(chamber.value);
            let totalValue = donorValue + chamberValue;

            document.getElementById("tId").value = totalValue;
            document.getElementById("unitId").disabled = isFinancialItem;
            document.getElementById("budgetId").value = totalValue;
        }
    </script>
}
