@if (Model.RoleLevel == RoleLevelEnum.Admin)
{

    <div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="planModal">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Edit Plan</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form data-parsley-validate method="post"
                          asp-action="SaveMainPlan" asp-antiforgery="true">
                        <input type="hidden" name="Id" value="@Model.TheModel.Id"/>
                        <input type="hidden" name="PlanYear" value="@Model.PlanYear"/>
                        <input type="hidden" name="subSystem" value="@Model.CurrentSubsystem"/>
                        <input type="hidden" name="ParentId" value="@Model.TheModel.ParentId"/>
                        
                        
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                #
                            </label>
                            <input type="text" maxlength="20" name="Code" asp-for="TheModel.Code" class="form-control col-sm-5 col-md-5" required />
                        </div>


                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Name
                            </label>
                            <input type="text" maxlength="250" asp-for="TheModel.Name" name="name" class="form-control col-sm-8 col-md-9" required/>
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Target
                            </label>
                            <input type="number" min="1" name="PlanAmount" asp-for="TheModel.PlanAmount" class="form-control col-sm-4 col-md-4" required/>
                            <select name="Unit" asp-for="TheModel.Unit"
                                    class="form-control col-sm-4 col-md-5" required>
                                <option></option>
                                <option value="3">Percent(%)</option>
                                <option value="2">Count</option>
                                <option value="1">Money</option>
                            </select>
                        </div>

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Expected Result
                            </label>
                            <input type="text" maxlength="250" asp-for="TheModel.ExpectedResult" name="ExpectedResult" class="form-control col-sm-8 col-md-9" required/>
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Estimated Budget
                            </label>
                            <div class="input-group-append  col-sm-8 col-md-5" style="padding-left: 0px;">
                            <input type="number" min="0" asp-for="TheModel.EstimatedBudget" name="EstimatedBudget" class="form-control" required/>
                        
                                <span class="input-group-text" id="basic-addon2">Birr</span>
                            </div>
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Donor / Chamber
                            </label>

                            <div class="input-group-append  col-sm-8 col-md-5" style="padding-left: 0px;">
                            <input type="number" min="0" asp-for="TheModel.FromDonor" name="FromDonor" class="form-control " required />
                            <input type="number" min="0" asp-for="TheModel.FromChamber" name="FromChamber" class="form-control " required/>
                           
                                <span class="input-group-text" id="basic-addon2">Birr</span>
                            </div>
                        </div>

                        <div class="row form-group">
                            <div class="col-sm-12">
                                <input type="submit" value="Save" class="btn btn-primary">

                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}







@section script {


    <script>
        function confirmDelete(form) {
            $.confirm({
                icon: 'fa fa-exclamation-triangle',
                title: 'Confirm!',
                content: 'Are you sure want to Delete ?',
                buttons: {
                    yes: function() {
                        form.submit();
                    },
                    no: function() {
                    }
                }
            });
            return false;
        }


        function confirmAction(form) {
            $.confirm({
                icon: 'fa fa-exclamation-triangle',
                title: 'Confirm!',
                content: 'Are you sure want to Change Status ?',
                buttons: {
                    yes: function() {
                        form.submit();
                    },
                    no: function() {
                    }
                }
            });
            return false;
        }

        function hasPlanChanged(e) {
            console.log(e);
            const id = e.id.replace('hp', 'im');
            const input = document.getElementById(e.id.replace('hp', 'im'));
            const hidden = document.getElementById(e.id.replace('hp', 'hd'));
            const planText = document.getElementById(e.id.replace('hp', 'ta'));
            const checked = Boolean(e.checked);
            input.disabled = !checked;
            hidden.value = checked;
            planText.disabled = input.disabled;
        }



        function validatePlan() {
            const m1 = Number(document.getElementById('im01').value);
            const m2 = Number(document.getElementById('im02').value);
            const m3 = Number(document.getElementById('im03').value);
            const m4 = Number(document.getElementById('im04').value);
            const m5 = Number(document.getElementById('im05').value);
            const m6 = Number(document.getElementById('im06').value);

            const m7 = Number(document.getElementById('im07').value);
            const m8 = Number(document.getElementById('im08').value);
            const m9 = Number(document.getElementById('im09').value);
            const m10 = Number(document.getElementById('im10').value);
            const m11 = Number(document.getElementById('im11').value);
            const m12 = Number(document.getElementById('im12').value);
            const planAmount = Number(@m.PlanAmount);
            const totalPlan = m1 + m2 + m3 + m4 + m5 + m6 + m7 + m8 + m9 + m10 + m11 + m12;
            const isValid = planAmount === totalPlan;
            const messageDiv = document.getElementById('labeldiv');
            messageDiv.innerHTML = "";
            if (!isValid) {
                messageDiv.innerHTML = `Monthly Plan ${totalPlan} !=  Annual Plan ${planAmount}`;
            }
            return isValid;
        }

    </script>
}