@using ECCSA.BackOffice.Server.Model.Common
@using ECCSA.BackOffice.Server.Model.Common.Planning
@using DocumentFormat.OpenXml.Drawing.Diagrams
@model ECCSA.BackOffice.Server.WebApp.Areas.MandE.Model.PlanViewModel

@{
    ViewData["Title"] = "Planning";// = Model.PageTitle;
    Layout = Model.LayoutPage;
}
@{
    async Task Template(Plan parent, string parentCode, List<Plan> subPlans, string padding)
    {
        
        //var decsendant = Model.TheList.Where(p => !p.IsLabel && p.InternalCode.StartsWith(parent.InternalCode) && p.Id != parent.Id).ToList();
        //if(parent.IsLabel && decsendant.Count > 0)
         await BuildRow(parent, parentCode, subPlans, padding);


        padding += "&nbsp;&nbsp;&nbsp;";
        foreach (var ind in subPlans)
        {
            var plans = Model.TheList.Where(p => p.ParentId == ind.Id).OrderBy(p => p.Code).ToList();
            await Template(ind, parent.InternalCode, plans, padding);
        }
    }

    async Task BuildRow(Plan ind, string parentCode, List<Plan> subPlans, string padding)
    {
        var hasChildren = Model.HasChildren(ind.Id);
        var labelSubPlan = Model.AreAllLabelChildren(ind.Id);
        var isPlanning = ind.Status == PlanningStatusEnum.Planning || ind.Status == PlanningStatusEnum.Rejected;

        var ownedIndicator = ind.ResponsibleUnit == Model.CurrentSubsystem && ind.SupportingUnitId == Model.SupportingUnitId;
        var unitName = @ind.ResponsibleUnit.GetDisplayName();

        var parentTt = !ind.ParentId.HasValue ? "root" : $"child";
        if (!Model.TreeView)
        {
            parentCode = String.Empty;
            parentTt = string.Empty;
        }
        <tr class=" @parentTt @parentCode" id="@ind.InternalCode">
            <td style="@(ind.IsLabel ? "" : Model.StatusStyle(ind.Status))">
                @Html.Raw(@padding)
                @if (hasChildren && Model.TreeView)
                {
                    <a data-tt="@ind.InternalCode" onclick="showHideChildren(this);" class="title"><i class="fas fa-angle-right"></i>@ind.Code </a>
                }
                else
                {
                    @ind.Code
                }
            </td>
            <td>
                @if (ind.IsLabel)
                {
                    @ind.Name
                }
                else
                {
                    <a asp-controller="Controlling"
                   class="title"
           asp-action="Detail"
           asp-route-id="@ind.Id"
           asp-route-subsystem="@Model.CurrentSubsystem">@ind.Name</a>
                }
            </td>
            <td>@ind.UnitName </td>

            <td>@ind.PlanAmountName</td>
            <td>@ind.ExpectedResult</td>
            <td>@ind.EstimatedBudgetName</td>

            <td>
                <div class="col-sm-4 btn-group" role="group" aria-label="Basic example">


                    @if (Model.RoleLevel == RoleLevelEnum.Admin)
                    {
                        if (ind.Status == PlanningStatusEnum.Submitted && ind.PlanAmount > 0)
                        {
                            <a class="btn btn-sm btn-outline-danger"
                               data-toggle="modal"
                               data-target="#rejectPlanModal"
                               data-id="@ind.Id"
                               onclick="editPlan(this);"
                               style="margin-right: 5px;"
                               title="Reject Plan">
                                Reject
                            </a>
                            <input type="button" value="approved" class="btn btn-outline-success btn-sm float-right"
                                   onclick="return confirmAction($('#approvePlan@(Model.Guid2String(ind.Id))')[0], 'Approve Plan')" />
                            <form data-parsley-validate method="post" id="approvePlan@(Model.Guid2String(ind.Id))"
                  asp-action="ApprovePlan" asp-antiforgery="true">
                                <input type="hidden" name="Id" value="@ind.Id" />
                                <input type="hidden" name="PlanYear" value="@Model.PlanYear" />
                                <input type="hidden" name="responsibleUnitFilter" value="@Model.ResponsibleUnitFilter" />


                                <input type="hidden" name="treemode" value="@Model.TreeView" />

                            </form>



                        }


                    }
                </div>
            </td>
        </tr>
    }
}
<div class="container-fluid">


    <div class="row">
        <div class="col-12">

            <div class="card shadow mb-4">
                <div class="card-header">
                    <label for="yearfrom" class="col-form-label"> Year: @Model.PlanYear Ver. @Model.PlanVersionNo (@Model.PlanPhase.GetDisplayName())</label>
                </div>
                <div class="card-body">

                    <form data-parsley-validate method="get" id="filterfomr" class="row g-3"
                          asp-action="Index" asp-antiforgery="true">

                        <div class="col col-md-1">
                            <label class="form-label-sm" style="text-align: right;" for="responsibleUnitFilterId">R. Unit</label>
                        </div>
                        <div class="col col-md-2">
                            <select name="responsibleUnitFilter" class="form-select-sm" title="Responsible Unit" id="responsibleUnitFilterId"
                                    asp-for="@Model.ResponsibleUnitFilter">
                                @foreach (var u in Enum.GetValues(typeof(ECCSAModuleEnum)).Cast<ECCSAModuleEnum>())
                                {
                                    if (u == ECCSAModuleEnum.Bmo)
                                    {
                                        continue;
                                    }
                                    else if (u == ECCSAModuleEnum.None)
                                    {
                                        <option value="0_0">All</option>
                                    }
                                    else if (u == ECCSAModuleEnum.Support)
                                    {
                                        foreach (var su in Model.SupportingUnits)
                                        {
                                            if (!string.IsNullOrWhiteSpace(su.Name))
                                            {
                                                <option value="@((int)@u)_@(su.Value)">@su.Name</option>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <option value="@((int)@u)_0">@u.GetDisplayName()</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col col-md-7">

                            <div class="row">

                                <div class="col-md-3">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="idTreeView" name="treeMode" asp-for="@Model.TreeView" onchange="changeValue(this)">
                                        <label class="form-check-label" for="idTreeView">Tree View</label>
                                    </div>
                                </div>


                                <input type="submit" value="Show Data" class="col-md-3 btn-sm btn-outline-primary">

                            </div>
                        </div>

                    </form>

                    <hr />
                    <div class="form-group row">
                        <div class="col-md-12 table-responsive">

                            <table id="example1" class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th style="width: 40px; max-width:50px !important;">#</th>
                                        <th style="width:400px;">Name</th>
                                        <th style="width:50px;">Unit</th>

                                        <th>Plan</th>
                                        <th>Expected Result</th>
                                        <th>Est. Budget '000</th>

                                        <th>
                                            @if (Model.PlanPhase == PlanningPhaseEnum.Planning && Model.TheList.Any(p => !p.IsLabel && p.Status == PlanningStatusEnum.Submitted))
                                            {
                                                <input type="button" value="Approve All" class="btn btn-outline-success btn-sm float-right"
                                                       onclick="return confirmAction($('#approveAllPlan')[0], 'Approve All Plan')"/>
                                                <form data-parsley-validate method="post" id="approveAllPlan"
                                                      asp-action="ApproveAllPlan" asp-antiforgery="true">
                                                    <input type="hidden" name="PlanYear" value="@Model.PlanYear"/>
                                                    <input type="hidden" name="responsibleUnitFilter" value="@Model.ResponsibleUnitFilter"/>

                                                    <input type="hidden" name="treemode" value="@Model.TreeView"/>

                                                </form>
                                            }
                                        </th>
                                    </tr>
                                </thead>
                                <tbody id="tableDetail">
                                    @{
                                        if (Model.TreeView)
                                        {
                                            @foreach (var root in Model.RootPlans)
                                            {
                                                var subPlans = Model.TheList.Where(p => p.ParentId == root.Id).OrderBy(p => p.Code).ToList();
                                                await Template(root, "",subPlans, "");
                                            }
                                            
                                        }
                                        else
                                        {
                                            foreach (var plan in Model.TheList)
                                            {
                                                await BuildRow(plan, "", new List<Plan>(), "");
                                            }
                                        }
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">

                        <div class="col-md-12">
                            <span style="font-size: larger; margin: 0px; padding: 5px;">Color Legend: </span>
                            <span style="@Model.StatusStyle(PlanningStatusEnum.Planning) font-size: larger; margin: 0px; padding: 5px;">Planning</span>
                            <span style="@Model.StatusStyle(PlanningStatusEnum.Submitted) font-size: larger; margin: 0px; padding: 5px;">Submitted</span>
                            <span style="@Model.StatusStyle(PlanningStatusEnum.Rejected) font-size: larger; margin: 0px; padding: 5px;">Rejected</span>
                            <span style="@Model.StatusStyle(PlanningStatusEnum.Approved) font-size: larger; margin: 0px; padding: 5px;">Approved</span>

                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
    @if (Model.RoleLevel == RoleLevelEnum.Admin)
    {

        <div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="rejectPlanModal">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title label label-danger">Reject Plan</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <form data-parsley-validate method="post"
                          asp-action="RejectPlan" asp-antiforgery="true">
                            <input type="hidden" name="Id" id="pId" />
                            <input type="hidden" name="PlanYear" value="@Model.PlanYear" />
                            <input type="hidden" name="responsibleUnitFilter" value="@Model.ResponsibleUnitFilter" />


                            <input type="hidden" name="treemode" value="@Model.TreeView" />

                            <div class="row form-group">
                                <label class="col-sm-4 col-md-3 col-form-label">
                                    Remark
                                </label>
                                <textarea rows="4" name="Remark" id="idRemark" class="form-control col-sm-8 col-md-9" required></textarea>
                            </div>

                            <div class="row form-group">
                                <div class="col-sm-12">
                                    <input type="submit" value="Save" class="btn btn-primary">

                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>


    }
    @section script {


        <script>
            function changeValue(e) {
                const name = e.name;
                e.value = e.checked ? "true" : false;
                $(`input:hidden[name=${e.name}]`).attr('value', e.value);
            }

            function confirmDelete(form) {
                $.confirm({
                    icon: 'fa fa-exclamation-triangle',
                    title: 'Confirm!',
                    content: 'Are you sure want to Delete ?',
                    buttons: {
                        yes: function () {
                            form.submit();
                        },
                        no: function () {
                        }
                    }
                });
                return false;
            }

            function confirmAction(form, action) {
                $.confirm({
                    icon: 'fa fa-exclamation-triangle',
                    title: 'Confirm!',
                    content: 'Are you sure want to ' + action + ' ?',
                    buttons: {
                        yes: function () {
                            form.submit();
                        },
                        no: function () {
                        }
                    }
                });
                return false;
            }

            function editName(e) {
                const id = document.getElementById('planId');
                const code = document.getElementById('codeId');
                const name = document.getElementById('nameId');

                const idVal = $(e).attr('data-id');
                const codeVal = $(e).attr('data-code');
                const nameVal = $(e).attr('data-name');
                id.value = idVal;
                code.value = codeVal;
                name.value = nameVal;
                // $('#inputMethodRequirement').val(typeVal).change();
            }

            function createPlanHeader(e) {
                const parentVal = $(e).attr('data-parent');
                const parentDiv = $("#createRootModal")
                parentDiv.find('#parentId').val(parentVal).change();
                parentDiv.find('#responsibleUnitId').val('@((int)Model.CurrentModule)').change();
                parentDiv.find('#parentIdValue').val(parentVal).change();
                parentDiv.find('#responsibleUnitIdValue').val('@((int)Model.CurrentModule)').change();
            }

            function createChildName(e) {
                const parentInput = document.getElementById('parentLabelId');
                const parentNameInput = $('#parentHeaderLabel');

                const parent = $(e).attr('data-parent');
                const parentName = $(e).attr('data-parentname');
                parentInput.value = parent;
                parentNameInput.html(parentName);
            }

            function editPlan(e) {
                const id = document.getElementById('pId');
                const code = document.getElementById('cId');
                const name = document.getElementById('nId');

                const target = document.getElementById('tId');
                const result = document.getElementById('resultId');

                const budget = document.getElementById('budgetId');
                const donor = document.getElementById('donorId');
                const chamber = document.getElementById('chamId');
                const sUnitInput = document.getElementById('supportingUnitId');
                const parentNameInput = $('#parentHeader');

                const idVal = $(e).attr('data-id');
                const parentVal = $(e).attr('data-parent');
                const parentName = $(e).attr('data-parentname');
                const codeVal = $(e).attr('data-code');
                const nameVal = $(e).attr('data-name');
                const sunit = $(e).attr('data-sunit');

                const targetVal = $(e).attr('data-plan');
                const unitVal = $(e).attr('data-unit');
                const resultVal = $(e).attr('data-result');
                const budgetVal = $(e).attr('data-budget');

                const donorVal = $(e).attr('data-donor');
                const chamberVal = $(e).attr('data-chamber');

                id.value = idVal;
                code.value = codeVal;
                name.value = nameVal;

                if (sUnitInput) {
                    sUnitInput.value = sunit;
                }


                target.value = targetVal;
                result.value = resultVal;
                budget.value = budgetVal;

                donor.value = donorVal;
                chamber.value = chamberVal;
                parentNameInput.html(parentName);

                $('#parentId').val(parentVal).change();
                $('#parentIdValue').val(parentVal).change();
                $('#unitId').val(unitVal).change();

            }

            function cancelPlan() {

                document.getElementById('editbtn').hidden = false;
                document.getElementById('savebtn').hidden = true;
                document.getElementById('cancelbtn').hidden = true;
            }

            function hideChildren() {
                const children = document.getElementsByClassName('child');
                for (var i = 0; i < children.length; i++) {
                    children[i].style.display = 'none';
                }
            }

            hideChildren();

            function hideDescendant(e) {
                console.log(e);
                const parent = $(e).attr('data-tt');
                const children = document.getElementsByClassName(parent);
                for (var i = 0; i < children.length; i++) {
                    const child = children[i];
                    child.style.display = 'none';
                    //console.log(child.id, child, document.getElementsByClassName(child.id).length);
                    if (document.getElementsByClassName(child.id).length > 0) {
                        $(child).find('i').removeClass('fa-angle-down');
                        $(child).find('i').addClass('fa-angle-right');
                        hideDescendant($(child).find('a')[0]);
                    }

                }
            }

            function showHideChildren(e) {
                const ank = $(e);
                let show = true;

                for (let i = 0; i < ank[0].children.length; i++) {
                    const child = ank[0].children[i];
                    if (child.localName == 'i') {
                        if (child.classList.contains('fa-angle-right')) {
                            show = true;
                            child.classList.remove('fa-angle-right');
                            child.classList.add('fa-angle-down');
                        } else {
                            show = false;
                            child.classList.add('fa-angle-right');
                            child.classList.remove('fa-angle-down');
                        }
                    }
                }

                if (show) {
                    const parent = $(e).attr('data-tt');
                    const children = document.getElementsByClassName(parent);
                    for (var i = 0; i < children.length; i++) {
                        children[i].style.display = '';
                    }
                } else {
                    hideDescendant(e);
                }
            }

        </script>
    }
