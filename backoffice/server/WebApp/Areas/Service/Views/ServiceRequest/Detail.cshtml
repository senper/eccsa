@using ECCSA.BackOffice.Server.Model.Common
@using ECCSA.BackOffice.Server.Model.Membership
@model ECCSA.BackOffice.Server.WebApp.Areas.Service.Model.ServiceRequestViewModel

@{
    ViewData["Title"] = Model.PageTitle;
    Layout = Model.LayoutPage;

}
@{
    var TIN = Model.TheModel.TIN;
}
<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        @if (Model.CurrentModule == ECCSAModuleFlag.Academy)
        {
            <a href="@Url.Action("Detail","Training",
            new { Area ="Academy", module=Model.CurrentModule, id = Guid.Empty, serviceTypeId = Model.TheModel.ServiceTypeId })" class="btn btn-outline-info">
                <i class="fa fa-angle-double-left" aria-hidden="true"></i>
                back
            </a>
        }
        else if (Model.ServiceTypeId == Model.TheModel.ServiceTypeId)
        {
            <a href="@Url.Action("ByServiceType","ServiceRequest",new { Area ="Service", module=Model.CurrentModule,serviceTypeId = Model.ServiceTypeId })" class="btn btn-outline-info"><i class="fa fa-angle-double-left" aria-hidden="true"></i>back</a>
        }
        else
        {
            <a href="@Url.Action("Index","ServiceRequest",new { Area ="Service", module=Model.CurrentModule, SearchStatus=Model.TheModel.RequestStatusValue})" class="btn btn-outline-info"><i class="fa fa-angle-double-left" aria-hidden="true"></i>back</a>
        }
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="row">

                        <div class="col-sm-10">

                            <h4>
                                @if (Model.TheModel.UnderReview)
                                {
                                    @Model.TheModel.FullName
                                    <small>&nbsp; @Model.TheModel.PendingDocumentsNo pending req. </small>

                                    <small> &nbsp;@Model.TheModel.OperatorName </small>
                                }
                                else if (Model.TheModel.ReadyForApproval || Model.TheModel.Approved)
                                {
                                    if (Model.TheModel.Rejection)
                                    {
                                        <span class="text-danger">
                                            @Model.TheModel.FullName  <small>[ @Model.TheModel.OperatorName ] </small>
                                        </span>
                                    }
                                    else
                                    {
                                        if (string.IsNullOrEmpty(@Model.TheModel.CertificateUrl))
                                        {
                                            @Model.TheModel.FullName  <small>[ @Model.TheModel.Signature ] </small>

                                            <small>[ @Model.TheModel.OperatorName ] </small>
                                        }
                                        else
                                        {
                                            <a id="filename" class="title" target="_blank" href="@Model.TheModel.CertificateUrl">
                                                @Model.TheModel.FullName  <small>[ @Model.TheModel.Signature ] </small><small>[ @Model.TheModel.OperatorName ] </small>
                                            </a>
                                        }

                                    }

                                }
                                else
                                {
                                    @Model.TheModel.FullName
                                    <small> @Model.TheModel.PendingDocumentsNo pending req. </small>
                                }
                            </h4>
                        </div>
                        <div class="col-sm-1" style="padding-right:0;">
                            @if (Model.TheModel.UnderReview && Model.IsUserOrAdmin)
                            {
                                if (Model.FullName != Model.TheModel.OperatorName)
                                {
                                    <form data-parsley-validate novalidate method="post"
                                  asp-action="StartProcessing" asp-antiforgery="true">
                                        <input type="hidden" name="Id" value="@Model.TheModel.Id" />
                                        <button onclick="this.form.submit()" title="start reviewing this document" class="btn btn-sm btn-outline-success float-right">Review</button>
                                    </form>
                                }
                            }
                        </div>
                        <div class="col-sm-1" style="padding-left:0;">
                            @if (Model.IsAdmin && Model.Users.Count > 1 && Model.TheModel.RequestStatus != WorkflowStateEnum.NotSet && Model.TheModel.RequestStatus != WorkflowStateEnum.Closed
                            && Model.TheModel.UnderReview)
                            {

                                <button title="assign to different reviewer"
                                        data-toggle="modal"
                                        data-target="#assignUserModal"
                                        class="btn btn-sm btn-outline-warning">
                                    Assign
                                </button>
                            }
                        </div>

                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12">


                            <div class="row">
                                <div class="col-sm-2">
                                    Service Type
                                </div>
                                <div class="col-sm-8">
                                    @Model.TheModel.ServiceType.Name
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-2">
                                    Request Date
                                </div>
                                <div class="col-sm-10">
                                    @Model.TheModel.RequestDate.ToLongDateString()
                                </div>
                            </div>
                        <div class="row">
                            <div class="col-sm-2">
                                Tracking Number
                            </div>
                            <div class="col-sm-2">
                                     <a class="label label-info" data-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample" title="Click to view requestor contact info">@Model.TheModel.TrackingNo </a> 
                            </div>
                                <div class="collapse col-sm-8" id="collapseExample">
                                    <div class="row">
                                        <div class="col-sm-4" style="text-align: right;">
                                            Email
                                        </div>
                                        <div class="col-sm-8">
                                            @Model.TheModel.Email
                                        </div>
                                    </div>
                        
                                    <div class="row">
                                        <div class="col-sm-4" style="text-align: right;">
                                            Mobile
                                        </div>
                                        <div class="col-sm-8">
                                            @Model.TheModel.MobileNo
                                        </div>
                                    </div>
                                       
                                    
                                </div>
                            
                        </div>
                        
                        
                        <div class="row">
                                <div class="col-sm-2">
                                    Invoice No
                                </div>
                                <div class="col-sm-10">
                                    @Model.TheModel.InvoiceNo   @Model.TheModel.InvoiceAmount
                                    @if (Model.IsCurrentOperator && String.IsNullOrEmpty(Model.TheModel.InvoiceNo) && Model.TheModel.RequestStatus >= WorkflowStateEnum.Submitted)
                                    {
                                        <button class=" btn btn-sm btn-outline-primary shadow-sm"
                                                data-toggle="modal"
                                                data-target="#invoiceModal"
                                                title="Generate Invoice">
                                            <i class="fas fa-file-invoice-dollar"></i>&nbsp;Invoice
                                        </button>


                                    }
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-2">
                                    Last Receipt No
                                </div>
                                <div class="col-sm-10">
                                    @{
                                        var lstSet = Model.TheModel.Invoice?.Settlments?.FirstOrDefault(s => s.ReceiptNo == Model.TheModel.ReceiptNo);
                                        var otherReceipts = Model.TheModel.Invoice?.Settlments?.Where(s => s.ReceiptNo != Model.TheModel.ReceiptNo);
                                    }
                                    @if ( true)
                                    {
                                        <span title="@Model.TheModel.PaymentMethod.GetDisplayName()">@Model.TheModel.ReceiptNo</span>
                                        @(Model.TheModel.PaymentStatus.GetDisplayName())

                                        @if (lstSet != null && !String.IsNullOrWhiteSpace(lstSet.Extension))
                                        {
                                            <a class="title" data-toggle="modal"
                                               data-target="#dialog"
                                               title="Preview Receipt"
                                               data-src="@lstSet.RelativePath"
                                               data-text=""
                                               data-id="@lstSet.Id"
                                               data-title="@lstSet.ReceiptNo"
                                               data-additional="1"
                                               onclick="previewPdf(this);">
                                                Preview Receipt
                                            </a>
                                        }
                                        @if (!Model.TheModel.PrintReceipt && !String.IsNullOrWhiteSpace(Model.TheModel.InvoiceNo) &&
                                             !String.IsNullOrWhiteSpace(Model.TheModel.ReceiptNo))
                                        {
                                            <form data-parsley-validate method="post"
                                                  asp-action="ConfirmPayment" asp-antiforgery="true">
                                                <input type="hidden" name="Id" value="@Model.TheModel.Id"/>
                                                <input type="hidden" name="ReceiptNo" value="@Model.TheModel.ReceiptNo"/>
                                                <input type="hidden" name="InvoiceNo" value="@Model.TheModel.InvoiceNo"/>
                                                <input type="number" min="0" name="ConfirmedAmount" placeholder="Confirmed Amount" title="Confirmed Amount" required/>
                                                <button onclick="return confirmDelete(this.form, 'Confirm Payment')" title="Confirm Payment" class="btn btn-sm btn-outline-success ">Confirm Payment</button>
                                            </form>
                                        }
                                        @if (Model.TheModel.RequestStatus <= WorkflowStateEnum.UnderReview &&  !String.IsNullOrWhiteSpace(Model.TheModel.InvoiceNo) &&
                                             !String.IsNullOrWhiteSpace(Model.TheModel.ReceiptNo) && Model.TheModel.PaymentStatus != PaymentStatusEnum.Rejected
                                             && Model.TheModel.PaymentStatus != PaymentStatusEnum.Accepted)
                                        {
                                            <form data-parsley-validate method="post"
                                                  asp-action="RejectReceipt" asp-antiforgery="true">
                                                <input type="hidden" name="Id" value="@Model.TheModel.Id"/>
                                                <input type="hidden" name="ReceiptNo" value="@Model.TheModel.ReceiptNo"/>
                                                <input type="hidden" name="InvoiceNo" value="@Model.TheModel.InvoiceNo"/>
                                                <button onclick="return confirmDelete(this.form, 'Reject Receipt')" title="Reject Receipt" class="btn btn-sm btn-outline-danger ">Reject Receipt</button>
                                            </form>
                                        }
                                    }
                                </div>
                            </div> <div class="row">
                                <div class="col-sm-2">
                                    Total Payment
                                </div>
                                <div class="col-sm-10">
                                    @Model.TheModel.ReceiptAmount
                                </div>
                            </div>
                            @if (otherReceipts?.Count() > 0)
                            {
                                <div class="row">
                                    <div class="col-sm-2">
                                        Other Receipts
                                    </div>
                                    <div class="col-sm-10">
                                        @foreach (var r in otherReceipts)
                                        {
                                            @if (!string.IsNullOrWhiteSpace(r.Extension))
                                            {
                                                <a class="title" data-toggle="modal"
                                                   data-target="#dialog"
                                                   title="Preview Receipt @r.ReceiptNo @r.PaymentMethod.GetDisplayName()"
                                                   data-src="@r.RelativePath"
                                                   data-text=""
                                                   data-id="@r.Id"
                                                   data-title="@r.ReceiptNo"
                                                   data-additional="1"
                                                   onclick="previewPdf(this);">
                                                    Preview Receipt @r.ReceiptNo
                                                </a>
                                            }
                                            else
                                            {
                                                <span title="@r.PaymentMethod.GetDisplayName()">@r.ReceiptNo</span>
                                            }
                                            <text>&nbsp;</text>
                                        }
                                    </div>
                                </div>
                            }
                            @if (Model.TheModel.ServiceType.IsArbitration)
                            {
                                <div class="row">
                                    <div class="col-sm-2">
                                        Second Respondent
                                    </div>
                                    <div class="col-sm-10">
                                        @if (Model.TheModel.ServiceType.IsArbitration && Model.TheModel.OpponentUserId != null)
                                        {
                                            <strong>Full Name: </strong> @(Model.TheModel.OpponentFullName ?? "-") <br/>
                                            <strong>Email: </strong>@(Model.TheModel.OpponentEmail ?? "-") <br/>
                                            <strong>Mobile No: </strong>@(Model.TheModel.MobileNo ?? "-")
                                        }
                                        @if (Model.TheModel.RequestStatus == WorkflowStateEnum.Submitted ||
                                       Model.TheModel.RequestStatus == WorkflowStateEnum.UnderReview)
                                        {
                                            <form data-parsley-validate method="post"
                                          asp-action="SaveOpponent" asp-antiforgery="true">
                                                <input type="hidden" name="Id" value="@Model.TheModel.Id" />
                                                <div class="input-group-append  col-sm-8 col-md-5" style="padding-left: 0px;">
                                                <select name="opponentUserId"  required id="opponentUserIdSelect"
                                                 onchange="opponentChange()" class="form-select-md">
                                                    <option></option>
                                                    @foreach(var u in Model.OpponentUsers)
                                                    {
                                                        @if (u.Id == Model.TheModel.OpponentUserId)
                                                        {
                                                            <option value="@u.Id" selected="selected" data-fullname="@u.FullName" data-mobileno="@u.MobileNo">@u.Email</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@u.Id" data-fullname="@u.FullName" data-mobileno="@u.MobileNo">@u.Email</option>
                                                        }
                                                    }
                                                </select><button onclick="return confirmDelete(this.form, 'set selected user as opponent')" title="Set opponent" class=" input-group-btn btn btn-sm btn-outline-success ">Set</button><br />
                                                    
                                                </div>
                                                <span id="selectedOpponentPreview" style="margin-bottom: 5px;"></span>
                                                
                                            </form>
                                        }

                                    </div>
                                </div>
                            }
                            <div class="row">
                                <div class="col-sm-2">
                                    Status
                                </div>
                                <div class="col-sm-4">
                                    @Model.TheModel.RequestStatus.GetDisplayName()

                                    @if (Model.TheModel.UnderReview && Model.TheModel.PaymentStatus == PaymentStatusEnum.Accepted)
                                    {
                                        if (Model.IsUserOrAdmin && Model.IsCurrentOperator)
                                        {
                                            if (Model.TheModel.PendingDocumentsNo <= 0)
                                            {
                                                <button class="col-sm-3 btn btn-sm btn-outline-success shadow-sm"
                                                        data-toggle="modal"
                                                        data-target="#recommendAcceptModal"
                                                        title="Recommend Approval">
                                                    <i class="fa fa-check"></i>&nbsp;Approve
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-outline-warning shadow-sm"
                                                    data-toggle="modal"
                                                    data-target="#recommendRejectModal"
                                                    title="Recommend Rejection">
                                                <i class="fa fa-times"></i>&nbsp;Reject
                                            </button>
                                        }
                                    }
                                    else if (Model.TheModel.ReadyForApproval)
                                    {
                                        if (Model.IsAdmin)
                                        {
                                            if (Model.TheModel.Rejection)
                                            {

                                                <form data-parsley-validate novalidate method="post"
                                          asp-action="AcceptRejection" asp-antiforgery="true">
                                                    <input type="hidden" name="id" value="@Model.TheModel.Id" />
                                                    <button onclick="this.form.submit()"
                                                            title="Accept Approve request"
                                                            class="btn btn-sm btn-outline-success">
                                                        <i class="fa fa-check"></i>Approve
                                                    </button>
                                                </form>
                                                <form data-parsley-validate novalidate method="post"
                                          asp-action="DeclineRejection" asp-antiforgery="true">
                                                    <input type="hidden" name="id" value="@Model.TheModel.Id" />
                                                    <button onclick="this.form.submit()" title="Decline Approve request" class="btn btn-sm btn-outline-warning"><i class="fa fa-times"></i>Decline</button>
                                                </form>

                                            }
                                            else
                                            {
                                                <form data-parsley-validate novalidate method="post"
                                          asp-action="AcceptApprove" asp-antiforgery="true">
                                                    <input type="hidden" name="id" value="@Model.TheModel.Id" />
                                                    <button onclick="this.form.submit()"
                                                            title="Accept Approve request"
                                                            class="btn btn-sm btn-outline-success">
                                                        <i class="fa fa-check"></i>Approve
                                                    </button>
                                                </form>
                                                <form data-parsley-validate novalidate method="post"
                                          asp-action="DeclineApprove" asp-antiforgery="true">
                                                    <input type="hidden" name="id" value="@Model.TheModel.Id" />
                                                    <button onclick="this.form.submit()" title="Decline Approve request" class="btn btn-sm btn-outline-warning"><i class="fa fa-times"></i>Decline</button>
                                                </form>
                                            }

                                        }
                                    }
                                </div>


                            </div>
                            @if (Model.TheModel.Approved)
                            {
                                <div class="row">
                                    <div class="col-sm-2">
                                        Reviewed By:
                                    </div>
                                    <div class="col-sm-6">
                                        @Model.TheModel.OperatorName
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-2">
                                        Approved By:
                                    </div>
                                    <div class="col-sm-6">
                                        @Model.TheModel.ApproverName
                                    </div>
                                </div>
                            }
                            <div class="row">
                                <div class="col-sm-2">
                                    Remark:
                                </div>
                                <div class="col-sm-10">
                                    @Model.TheModel.Remark
                                </div>
                            </div>
                            @if (Model.TheModel.ServiceType.CertificateTypeValue > 0 &&
                            Model.TheModel.RequestStatus >= WorkflowStateEnum.Submitted)
                            {
                                <div class="row">
                                    <div class="col-sm-2">
                                        
                                    </div>
                                    <div class="col-sm-10">
                                        <a id="previewCertificate" asp-action="PreviewCertificate" asp-route-serviceId="@Model.TheModel.Id"
                                        asp-route-module="@Model.Module">
                                            Preview Certificate
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>

                    </div>

                </div>
            </div>
        </div>

    </div>
    <br />
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-body">

                    <div class="nav-tabs-boxed">
                        <ul class="nav nav-tabs" role="tablist">
                            <li class="nav-item"><a class="nav-link @Model.Tab0Active" data-toggle="tab" href="#questionsTab" role="tab" aria-controls="representatives">Requirements</a></li>
                            @if (Model.TheModel.ServiceType.AllowOptionalEntries)
                            {
                                <li class="nav-item"><a class="nav-link @Model.Tab3Active" data-toggle="tab" href="#optionalEntriesTab" role="tab" aria-controls="optionalEntries">Optional Requirements</a></li>
                            }
                            @if (Model.TheModel.ServiceType.AllowAdditionalAttachments)
                            {
                                <li class="nav-item"><a class="nav-link @Model.Tab2Active" data-toggle="tab" href="#attachmentTab" role="tab" aria-controls="attachemnts">Attachments</a></li>
                            }
                            <li class="nav-item"><a class="nav-link @Model.Tab1Active" data-toggle="tab" href="#surveyTab" role="tab" aria-controls="members">Followup</a></li>

                        </ul>
                        <div class="tab-content">

                            <div class="tab-pane @Model.Tab0Active" id="questionsTab" role="tabpanel">
                                <div class="row">
                                    @*<input id="btnShow4" type="button" value="Show PDF" />*@


                                    <div class="col-md-11 ">
                                        <table class="table table-bordered table-striped" id="datatblquestion" style="margin-top: 5px; margin-left: 5px;">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>Requirement</th>
                                                    <th>Value</th>
                                                    <th>Status</th>
                                                    <th>

                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var q in Model.TheModel.Responses)
                                                {
                                                    <tr>
                                                        <td>
                                                            @q.Requirement.OrderNo

                                                        </td>
                                                        <td>

                                                            @q.Name

                                                        </td>
                                                        <td>
                                                            @if (q.Requirement.InputMethod == ServiceInputTypeEnum.Upload)
                                                            {
                                                                <a class="title" data-toggle="modal"
                                                                   data-target="#dialog"
                                                                   title="Review Document"
                                                                   data-src="@q.RelativePath"
                                                                   data-text=""
                                                                   data-id="@q.Id"
                                                                   data-status ="@q.ReviewStatusValue"
                                                                   data-title="@q.Requirement.OrderNo @q.Requirement.NameEng"
                                                                   onclick="previewPdf(this);">
                                                                    Preview
                                                                </a>
                                                            }
                                                            else if (
                                                            q.Requirement.InputMethod == ServiceInputTypeEnum.LegalDocument)
                                                            {
                                                                <a class="title" data-toggle="modal"
                                                                   data-target="#dialog"
                                                                   title="Review Document"
                                                                   data-src="@q.RelativePath"
                                                                   data-text="@q.TextResponse"
                                                                   data-status="@q.ReviewStatusValue"
                                                                   data-id="@q.Id"
                                                                   data-title="@q.Requirement.OrderNo @q.Requirement.NameEng"
                                                                   onclick="previewPdf(this);">
                                                                    @q.TextResponse
                                                                </a>
                                                            }
                                                            else if (q.Requirement.InputMethod == ServiceInputTypeEnum.TradeAgreement ||
                                                            q.Requirement.InputMethod == ServiceInputTypeEnum.LongText)
                                                            {
                                                                <a class="title" data-toggle="modal"
                                                                   data-target="#dialog"
                                                                   title="Review Document"
                                                                   data-src="@q.RelativePath"
                                                                   data-text="@q.TextResponse"
                                                                   data-id="@q.Id"
                                                                   data-status="@q.ReviewStatusValue"
                                                                   data-title="@q.Requirement.OrderNo @q.Requirement.NameEng"
                                                                   onclick="previewPdf(this);">
                                                                    Preview
                                                                </a>
                                                            }
                                                            else if (q.Requirement.InputMethod == ServiceInputTypeEnum.Payment)
                                                            {
                                                                if (string.IsNullOrEmpty(q.InvoiceNo) && Model.TheModel.RequestStatus >= WorkflowStateEnum.Submitted)
                                                                {
                                                                    <button class="btn btn-sm btn-outline-primary shadow-sm"
                                                                            data-toggle="modal"
                                                                            data-target="#requirementInvoiceModal"
                                                                            data-id="@q.Id"
                                                                            data-status="@q.ReviewStatusValue"
                                                                            onclick="generateInvoice(this);"
                                                                            title="Generate Invoice">
                                                                        <i class="fas fa-file-invoice-dollar"></i>&nbsp;Invoice
                                                                    </button>

                                                                }
                                                                else if(q.Invoice != null)
                                                                {
                                                                    <span title="@q.PaymentMethod.GetDisplayName()">
                                                                        @(String.IsNullOrEmpty(q.ReceiptNo) ? "" : $"Last Receipt No : {q.Response}({q.PaymentStatus})")
                                                                    </span>

                                                                    var resLstSet = q.Invoice.Settlments.FirstOrDefault(s => s.ReceiptNo == q.ReceiptNo);
                                                                    var resOtherReceipts = q.Invoice.Settlments.Where(s => s.ReceiptNo != q.ReceiptNo);

                                                                    @if (resLstSet != null && !String.IsNullOrWhiteSpace(resLstSet.Extension) && Model.TheModel.RequestStatus >= WorkflowStateEnum.Submitted)
                                                                    {
                                                                        <a class="" data-toggle="modal"
                                                                           data-target="#dialog"
                                                                           title="Preview Receipt"
                                                                           data-src="@resLstSet.RelativePath"
                                                                           data-text=""
                                                                           data-id="@resLstSet.Id"
                                                                           data-title="@resLstSet.ReceiptNo"
                                                                           data-additional="1"
                                                                           onclick="previewPdf(this);">
                                                                            Preview Receipt
                                                                        </a>
                                                                    }
                                                                    @if (q.ReviewStatus == DocumentReviewStatusEnum.Submitted && !q.PrintReceipt && !String.IsNullOrEmpty(q.InvoiceNo) &&
                                                                   !String.IsNullOrEmpty(q.ReceiptNo))
                                                                    {
                                                                        <form data-parsley-validate method="post"
                                                              asp-action="ConfirmRequirementPayment" asp-antiforgery="true">
                                                                            <input type="hidden" name="Id" value="@q.Id" />
                                                                            <input type="hidden" name="RequestId" value="@Model.TheModel.Id" />
                                                                            <input type="hidden" name="ReceiptNo" value="@q.ReceiptNo" />
                                                                            <input type="hidden" name="InvoiceNo" value="@q.InvoiceNo" />
                                                                            <input type="number" min="0" name="ConfirmedAmount" placeholder="Confirmed Amount" title="Confirmed Amount" required />
                                                                            <button onclick="return confirmDelete(this.form, 'Confirmed Amount')" title="Confirm Payment" class="btn btn-sm btn-outline-success ">Confirm Payment</button>
                                                                        </form>
                                                                    }
                                                                    @if (q.ReviewStatus == DocumentReviewStatusEnum.Submitted &&
                                                                   !String.IsNullOrWhiteSpace(q.InvoiceNo) &&
                                                                   !String.IsNullOrWhiteSpace(q.ReceiptNo) && q.PaymentStatus != PaymentStatusEnum.Rejected
                                                                   && q.PaymentStatus != PaymentStatusEnum.Accepted)
                                                                    {
                                                                        <form data-parsley-validate method="post"
                                                              asp-action="RejectRequirementReceipt" asp-antiforgery="true">
                                                                            <input type="hidden" name="Id" value="@q.Id" />
                                                                            <input type="hidden" name="RequestId" value="@Model.TheModel.Id" />
                                                                            <input type="hidden" name="ReceiptNo" value="@q.ReceiptNo" />
                                                                            <input type="hidden" name="InvoiceNo" value="@q.InvoiceNo" />
                                                                            <button onclick="return confirmDelete(this.form, 'Reject Receipt')" title="Reject Receipt" class="btn btn-sm btn-outline-danger ">Reject Receipt</button>
                                                                        </form>
                                                                    }
                                                                    @if (q.PaymentStatus != PaymentStatusEnum.Accepted)
                                                                    {
                                                                        <br />
                                                                        @("Total Paid: " + (q.AmountPaid ?? 0).ToString("#,##0.00") + "birr") <br />
                                                                    }
                                                                    @if (resOtherReceipts.Count() > 0)
                                                                    {
                                                                        <br />
                                                                        @foreach (var rr in resOtherReceipts)
                                                                        {
                                                                            @if (!string.IsNullOrWhiteSpace(rr.Extension))
                                                                            {
                                                                                <a class="" data-toggle="modal"
                                                                                   data-target="#dialog"
                                                                                   title="Preview Receipt @rr.ReceiptNo @rr.PaymentMethod.GetDisplayName()"
                                                                                   data-src="@rr.RelativePath"
                                                                                   data-text=""
                                                                                   data-id="@rr.Id"
                                                                                   data-title="@rr.ReceiptNo"
                                                                                   data-additional="1"
                                                                                   onclick="previewPdf(this);">
                                                                                    Preview Receipt @rr.ReceiptNo
                                                                                </a>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span title="@rr.PaymentMethod.GetDisplayName()">@rr.ReceiptNo</span>
                                                                            }
                                                                            <text>&nbsp;</text>
                                                                        }
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                  <text>No Invoice</text>  
                                                                }
                                                            }
                                                            else
                                                            {
                                                                @q.Response
                                                            }


                                                        </td>
                                                        <td>@q.ReviewStatus</td>
                                                        <td>

                                                            @if (Model.IsCurrentOperator && q.ReviewStatus != DocumentReviewStatusEnum.Accepted &&
                                                           q.ReviewStatus != DocumentReviewStatusEnum.NotApplicable &&
                                                           q.ReviewStatus != DocumentReviewStatusEnum.NotSet)
                                                            {

                                                                <button data-toggle="modal"
                                                                        data-target="#reviewResponseModal"
                                                                        title="Review Document"
                                                                        data-id="@q.Id"
                                                                        data-remark="@q.Remark"
                                                                        data-orderno="@q.Requirement.OrderNo"
                                                                        data-status=" @q.ReviewStatus"
                                                                        onclick="editDocumentReview(this)"
                                                                        class=" float-right btn btn-outline-success btn-sm">
                                                                    <i class="fa fa-pen "></i>
                                                                </button>

                                                            }


                                                        </td>
                                                    </tr>

                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                </div>
                                @foreach (var res in Model.TheModel.Responses.Where(r => r.Requirement.InputMethod == ServiceInputTypeEnum.Tabular))
                                {
                                    var tabularReq = Model.TheModel.ServiceType.TabularRequirements
                                    .FirstOrDefault(t => t.Id == res.Requirement.LookupTypeId);
                                    if (tabularReq != null && tabularReq.Details.Any())

                                    {
                                        var detail = tabularReq.Details.OrderBy(s => s.No).ToList();
                                        <div class="row">
                                            <div class="col-md-11 ">
                                                <strong># @res.Requirement.OrderNo @res.Requirement.Label</strong>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-11 ">
                                                <table class="table table-bordered table-striped" id="datatblquestion" style="margin-top: 5px; margin-left: 5px;">
                                                    <thead>
                                                        <tr>
                                                            @foreach (var td in detail)
                                                            {
                                                                <th>@td.Caption</th>
                                                            }
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @{
                                                            var rows = res.TabularResponse.Select(s => s.RowId).Distinct();
                                                        }
                                                        @foreach (var q in rows)
                                                        {
                                                            <tr>
                                                                @foreach (var td in detail)
                                                                {
                                                                    var resp = res.TabularResponse.FirstOrDefault(d => d.RowId == q && d.Text == td.Id);
                                                                    var value = resp != null ? resp.Value : "NA";
                                                                    <td>@value</td>
                                                                }
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                        </div>
                                    }
                                }
                            </div>
                            @if (Model.TheModel.ServiceType.AllowOptionalEntries)
                            {
                                <div class="tab-pane @Model.Tab3Active" id="optionalEntriesTab" role="tabpanel">
                                    <div class="row">
                                        <div class="col-md-12 ">
                                            <table class="table table-bordered table-striped" id="datatableOptionalEntries" style="margin-top: 5px; margin-left: 5px;">
                                                <thead>
                                                    <tr>
                                                        <th>Label</th>
                                                        <th>Value</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var s in Model.TheModel.OptionalEntries)
                                                    {
                                                        <tr>
                                                            <td>@s.Label</td>
                                                            <td>@s.Value</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (Model.TheModel.ServiceType.AllowAdditionalAttachments)
                            {
                                <div class="tab-pane @Model.Tab2Active" id="attachmentTab" role="tabpanel">
                                    <div class="row">
                                        <div class="col-md-12 ">
                                            <table class="table table-bordered table-striped" id="datatablesurvey" style="margin-top: 5px; margin-left: 5px;">
                                                <thead>
                                                    <tr>
                                                        <th>Title</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var s in Model.TheModel.Attachments)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <a class="title" data-toggle="modal"
                                                                   data-target="#dialog"
                                                                   title="Review Document"
                                                                   data-src="@s.RelativePath"
                                                                   data-text=""
                                                                   data-id="@s.Id"
                                                                   data-title="@s.Title"
                                                                   data-additional="1"
                                                                   onclick="previewPdf(this);">
                                                                    @s.Title
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="tab-pane @Model.Tab1Active" id="surveyTab" role="tabpanel">
                                <div class="row">

                                    <div class="col-md-12 ">
                                        <table class="table table-bordered table-striped" id="datatablesurvey" style="margin-top: 5px; margin-left: 5px;">
                                            <thead>
                                                <tr>
                                                    <th>Title</th>
                                                    <th>Start Date</th>
                                                    <th>Start Time</th>
                                                    <th>Status</th>
                                                    <th>Remark</th>
                                                    <th>
                                                        @if (Model.TheModel.RequestStatus != WorkflowStateEnum.Accepted)
                                                        {

                                                            <button data-toggle="modal"
                                                                    data-target="#followupStatusModal"
                                                                    title="Edit Followup"
                                                                    data-id="@Guid.Empty"
                                                                    data-remark=""
                                                                    data-title=""
                                                                    data-date="@DateTime.Today.AddDays(10)"
                                                                    data-time="@DateTime.Now"
                                                                    data-status="0"
                                                                    onclick="editFollowup(this)"
                                                                    class=" float-right btn btn-outline-success btn-sm">
                                                                New
                                                            </button>
                                                        }
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var s in Model.TheModel.Followups.OrderBy(f => f.StartDate).ThenBy(f => f.StartTime))
                                                {
                                                    <tr>
                                                        <td>
                                                            @if (s.HasAttachment)
                                                            {
                                                                <a id="filename" class="title" asp-action="DownLoadFile" asp-route-id="@s.Id"
                                                           asp-route-title="@s.Title" asp-route-module="@Model.Module"
                                                           asp-route-extension="@s.Extension">
                                                                    @s.Title
                                                                </a>
                                                            }
                                                            else
                                                            {
                                                                @s.Title
                                                            }
                                                        </td>
                                                        <td>@s.StartDate.ToString("yyyy-MM-dd")</td>
                                                        <td>@s.StartTime</td>
                                                        <td>@s.Status.GetDisplayName() </td>
                                                        <td>@s.Description</td>
                                                        <td>
                                                            @if (Model.TheModel.RequestStatus != WorkflowStateEnum.Accepted
                                                           && s.Status != TaskStatusEnum.Completed)
                                                            {


                                                                <a onclick="return confirmDelete($('#deleteFollowup@(s.Id)')[0]);"
                                                                   class=" btn btn-sm btn-outline-danger">
                                                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                                                </a>
                                                                <form data-parsley-validate novalidate method="post" id="deleteFollowup@(s.Id)"
                                                              asp-action="DeleteFollowup" asp-antiforgery="true" asp-route-id="@s.Id" asp-route-serviceId="@s.ServiceId">
                                                                    <input type="hidden" name="id" value="@s.Id" />
                                                                    <input type="hidden" name="ServiceId" value="@s.ServiceId" />
                                                                </form>
                                                            }

                                                        </td>
                                                    </tr>

                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>


                        </div>
                    </div>


                </div>
            </div>

        </div>
    </div>
</div>

@if (string.IsNullOrEmpty(Model.TheModel.ReceiptNo) && !string.IsNullOrEmpty(Model.TheModel.InvoiceNo))
