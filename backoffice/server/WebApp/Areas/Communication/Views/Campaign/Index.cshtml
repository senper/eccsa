@using ECCSA.BackOffice.Server.Model.Common
@model ECCSA.BackOffice.Server.WebApp.Areas.Communication.Model.CampaignViewModel

@{
    ViewData["Title"] = "Campaigns";
    Layout = "~/Views/Shared/_CommunicationLayout.cshtml";
}

<div class="container-fluid">


    <div class="row d-sm-flex align-items-center justify-content-between" style="margin-left:15px;margin-bottom:2px;">
        <div class=" btn-group" role="group" aria-label="Basic example">

            @if (Model.IsUserOrAdmin)
            {
                <button class="d-none d-sm-inline-block btn btn-sm btn-outline-primary shadow-sm"
                    data-toggle="modal"
                    data-target="#theModal"
                    onclick="addEdit(this)"
                    title="Add New Campaign"
                    data-id="@Guid.Empty"
                    data-title=""
                    data-titlelocal=""
                    data-description=""
                    data-purpose=""
                    data-startdate="@(DateTime.Today.AddDays(1))"
                    data-enddate="@(DateTime.Today.AddDays(30))"
                    data-status="@((int)StatusEnum.Active)">
                <i class="fas fa-plus fa-sm text-white-50"></i> Create New
            </button>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-12">

            <div class="card shadow mb-4">
                @*<div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">DataTables Example</h6>
                    </div>*@
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="dataTable" width="100%" cellpadding="0">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th>Title</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                            <tbody>
                                @foreach (var item in Model.TheList)
                                {
                                    var statusClass = (item.Status != ECCSA.BackOffice.Server.Model.Communication.CampaignStatusEnum.Active ? "danger" : "");

                                    <tr class="@statusClass">
                                        <td>
                                            <a asp-controller="Campaign" asp-action="Detail" asp-route-id="@item.Id" class="title @statusClass">
                                                @Html.DisplayFor(modelItem => item.Title)
                                            </a>
                                        </td>
                                       
                                        <td>
                                            @(item.StartDate.ToString("yyyy-MM-dd"))
                                        </td>
                                        <td>
                                            @( item.EndDate.ToString("yyyy-MM-dd"))
                                        </td>
                                        <td>
                                            @item.Status
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group" aria-label="Basic example">
                                               
                                                <a class=" btn btn-sm  btn-outline-info" asp-controller="Campaign" asp-action="Detail" asp-route-id="@item.Id">
                                                    <i class="fa fa-info" aria-hidden="true"></i>
                                                </a>

                                            </div>


                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>



</div>
@if (Model.IsUserOrAdmin)
{
    <div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="theModal">
        <div class="modal-dialog modal-md">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Campaign</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form data-parsley-validate novalidate method="post" enctype="multipart/form-data"
                      asp-action="Save" asp-antiforgery="true" 
                      onsubmit="return valideCampaign()">
                        <input type="hidden" name="Id" id="id" />

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Title
                            </label>
                            <input type="text" name="Title" id="titleId" maxlength="100" class="form-control col-sm-8 col-md-9" required />
                        </div>



                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Description
                            </label>
                            <textarea rows="4" name="Description" id="descriptionId" maxlength="1000" class="form-control col-sm-8 col-md-9" required></textarea>
                        </div>

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Start Date
                            </label>
                            <input type="date" class="form-control col-sm-8 col-md-9" name="startDate" id="startDateId" required />
                        </div>

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                End Date
                            </label>
                            <input type="date" class="form-control col-sm-8 col-md-9" name="endDate" id="endDateId" required />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Purpose
                            </label>
                            <textarea maxlength="1000" name="Purpose" id="purposeId" class="form-control col-sm-8 col-md-9"></textarea>
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">Letter</label>
                            <input accept="application/pdf, image/png, image/jpg" type="file" name="Material" class="form-control-file form-control col-sm-8 col-md-8" />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Status
                            </label>
                            <select class="custom-select col-sm-8 col-md-9"  
                                asp-items="@(Html.GetEnumSelectList<ECCSA.BackOffice.Server.Model.Communication.CampaignStatusEnum>())" id="statusId" name="Status" required>

                            </select>
                        </div>





                        <div class="row form-group">
                            <div class="col-sm-12">
                                <input type="submit" value="Save" id="submitPayment"
                                   class="btn btn-primary">

                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section script {
          <script src="~/js/validation.js"></script>
    <script src="~/js/mediaAgencyValidation.js"></script>

    <script src="/js/comboTreePlugin.js" type="text/javascript"></script>

    <script>



        function confirmDelete(form) {
            $.confirm({
                icon: 'fa fa-exclamation-triangle',
                title: 'Confirm!',
                content: 'Are you sure want to Delete ?',
                buttons: {
                    yes: function () {
                        form.submit();
                    },
                    no: function () {
                    }
                }
            });
            return false;
        }

        function addEdit(e) {
            const id = document.getElementById("id");
            const title = document.getElementById("titleId");
            const titleLocal = document.getElementById("titleLocalId");
            const description = document.getElementById("descriptionId");
            const startDate = document.getElementById("startDateId");
            const endDate = document.getElementById("endDateId");
            const purpose = document.getElementById("purposeId");


            const idVal = $(e).attr('data-id');
            const titleVal = $(e).attr("data-title");
            const titleLocalVal = $(e).attr("data-titlelocal");
            const descriptionVal = $(e).attr("data-description");
            const startDateVal = $(e).attr("data-startdate");
            const endDateVal = $(e).attr("data-enddate");
            const purposeVal = $(e).attr("data-purpose");
                 const statusVal = $(e).attr("data-status");

            id.value = idVal;
            title.value = titleVal;
            titleLocal.value = titleLocalVal;
            description.value = descriptionVal;
            startDate.value = startDateVal;
            endDate.value = endDateVal;
            purpose.value = purposeVal;
            $('#statusId').val(statusVal).change();
        }
    </script>
}