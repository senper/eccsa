@model ECCSA.BackOffice.Server.WebApp.Areas.Communication.Model.NewsViewModel
@using ECCSA.BackOffice.Server.Model.Common
@{
    ViewData["Title"] = "News";
    Layout = Model.LayoutPage;
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4 edit">
        @if (Model.IsUserOrAdmin)
        {
            <button class="d-none d-sm-inline-block btn btn-sm btn-outline-primary shadow-sm"
                data-toggle="modal"
                data-target="#theModal"
                title="Add New News "
                data-id="@Guid.Empty"
                data-status="@((int)StatusEnum.Active)"
                onclick="addEdit(this)">
                <i class="fas fa-plus fa-sm text-white-50"></i> Create New
            </button>
        }
    </div>
    <div class="row">
        <div class="col-12">

            <div class="card shadow mb-4">

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="dataTable" width="100%" cellpadding="0">
                            <thead>
                                <tr>
                                    <th>Heading</th>
                                    <th>Reporter</th>
                                    <th>Pub. Date</th>

                                    <th></th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th>Heading</th>
                                    <th>Reporter</th>
                                    <th>Pub. Date</th>

                                    <th></th>
                                </tr>
                            </tfoot>
                            <tbody>
                                @foreach (var i in Model.TheList)
                                {


                                    <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => i.TitleFull)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => i.AuthorFull)
                                        </td>
                                        <td>
                                            @(i.NewsDate.ToLongDateString())
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group" aria-label="Basic example">

                                                <a class=" btn btn-sm  btn-outline-info" asp-controller="@Model.Controller" asp-action="Detail" asp-route-id="@i.Id">
                                                    <i class="fa fa-info" aria-hidden="true"></i>
                                                </a>
                                                <a onclick="return confirmDelete($('#deleteNews@(i.Id)')[0]);"
                                               class=" btn btn-sm btn-outline-danger">
                                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                                </a>
                                                <form data-parsley-validate novalidate
                                                  method="post"
                                                  id="deleteNews@(i.Id)"
                                                  asp-action="Delete" asp-antiforgery="true" asp-route-id="@i.Id">
                                                    <input type="hidden" name="id" value="@i.Id" />

                                                </form>
                                            </div>


                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@if (Model.IsUserOrAdmin)
{
    <div class="modal fade" tabindex="-1"
     role="dialog" aria-hidden="true" id="theModal">
        <div class="modal-dialog modal-md">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">News </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form data-parsley-validate method="post" enctype="multipart/form-data"
                      asp-action="Save" asp-antiforgery="true">
                        <input type="hidden" name="Id" value="@Guid.Empty" />


                        <div class="row form-group" style="margin-bottom:1px;">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Heading
                            </label>
                            <input type="text" name="Title" maxlength="100" class="form-control col-sm-9 col-md-8" required placeholder="Heading  "  />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                
                            </label>
                            <input type="text" name="TitleLocal" maxlength="100" class="form-control col-sm-9 col-md-8" placeholder="ርዕስ  " required />
                        </div>
                        <div class="row form-group" style="margin-bottom:1px;">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Author
                            </label>
                            <input type="text" name="Author" maxlength="100" class="form-control col-sm-9 col-md-8" required placeholder="Reporter  " />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                
                            </label>
                            <input type="text" name="AuthorLocal" maxlength="100" class="form-control col-sm-9 col-md-8" required placeholder="ዘጋቢ " />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Date
                            </label>
                            <input type="date" name="NewsDate" min="@DateTime.Today.AddYears(-1)" max="@DateTime.Today" class="form-control col-sm-9 col-md-8" id="startDateId" required />
                        </div>
                        <div class="row form-group" style="margin-bottom:1px;">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Lead
                            </label>
                            <textarea placeholder="Brief  " rows="4" name="Brief" id="Brief" maxlength="800" class="form-control col-sm-9 col-md-8" required></textarea>
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                
                            </label>
                            <textarea rows="4" name="BriefLocal" placeholder="አርዕስተ   " id="BriefLocal" maxlength="800" class="form-control col-sm-9 col-md-8" required></textarea>
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">Photo</label>
                            <input accept="image/png, image/jpeg" asp-for="Photo" class="form-control-file form-control col-sm-8 col-md-8" />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">Home Top Photo</label>
                            <input accept="image/png, image/jpeg" title="720px by 600px"  asp-for="HomePhoto" class="form-control-file form-control col-sm-8 col-md-8" />
                        </div>
                        <div class="row form-group">
                            <div class="col-sm-12">
                                <input type="submit" value="Save"
                                   class="btn btn-primary">

                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
}
@section script {
<script>

    function confirmDelete(form) {
        $.confirm({
            icon: 'fa fa-exclamation-triangle',
            title: 'Confirm!',
            content: 'Are you sure want to Delete ?',
            buttons: {
                yes: function () {
                    form.submit();
                },
                no: function () {
                }
            }
        });
        return false;
    }
</script>
}