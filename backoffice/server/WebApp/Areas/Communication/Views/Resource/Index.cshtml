@model ECCSA.BackOffice.Server.WebApp.Areas.Communication.Model.ResourceViewModel
@using ECCSA.BackOffice.Server.Model.Common
@{
    ViewData["Title"] = "Resource";
    Layout = Model.LayoutPage;
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4 edit">
       @* @if (Model.IsUserOrAdmin)
        {*@
            <button class="d-none d-sm-inline-block btn btn-sm btn-outline-primary shadow-sm"
                data-toggle="modal"
                data-target="#theModal"
                title="Add New Media Agency"
                data-id="@Guid.Empty"
                data-status="@((int)StatusEnum.Active)"
                onclick="addEdit(this)">
            <i class="fas fa-plus fa-sm text-white-50"></i> Create New
        </button>
        @*}*@
    </div>
    <div class="row">
        <div class="col-12">

            <div class="card shadow mb-4">
                @*<div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">DataTables Example</h6>
                    </div>*@
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="dataTable" width="100%" cellpadding="0">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Type</th>
                                    <th>Author</th>
                                    <th>Pub. Month</th>
                                    
                                    <th></th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th>Title</th>
                                    <th>Type</th>
                                    <th>Author</th>
                                    <th>Pub. Month</th>

                                    <th></th>
                                </tr>
                            </tfoot>
                            <tbody>
                                @foreach (var i in Model.TheList)
                                {
                                    

                                    <tr >
                                        <td>
                                            <a asp-controller="@Model.Controller" asp-action="Detail" asp-route-module="@i.OwnerModule" asp-route-id="@i.Id" class="title">@Html.DisplayFor(modelItem => i.Title)</a>
                                        </td>

                                        <td>
                                            @(Model.ResourceTypes.FirstOrDefault(r => r.Id == i.TypeId)?.Text)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => i.AuthorFull)
                                        </td>
                                        <td>
                                            @(i.PublicationDate.ToString("yyyy-MM"))
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group" aria-label="Basic example">
                                               
                                                <a class=" btn btn-sm  btn-outline-info" asp-controller="@Model.Controller" asp-action="Detail" asp-route-id="@i.Id" asp-route-module="@i.OwnerModule">
                                                    <i class="fa fa-info" aria-hidden="true"></i>
                                                </a>
                                                 <a onclick="return confirmDelete($('#deleteResource@(i.Id)')[0]);"
                                                                   class=" btn btn-sm btn-outline-danger">
                                                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                                                    </a>
                                                                    <form data-parsley-validate novalidate method="post" id="deleteResource@(i.Id)"
                                                                      asp-action="Delete" asp-antiforgery="true" asp-route-id="@i.Id">
                                                                        <input type="hidden" name="id" value="@i.Id" />
                                                                        <input type="hidden" name="module" value="@i.OwnerModule" />
                                                                    </form>
                                            </div>


                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@*@if (Model.IsUserOrAdmin)
{*@
    <div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="theModal">
        <div class="modal-dialog modal-md">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Resource</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form data-parsley-validate  method="post" enctype="multipart/form-data"
                      asp-action="Save" asp-antiforgery="true">
                        <input type="hidden" name="Id" value="@Guid.Empty" />
                        <input type="hidden" name="OwnerModule" value="@Model.CurrentModule" />

                        <div class="row form-group" style="margin-bottom:1px;">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Title
                            </label>
                        <input type="text" name="Title" maxlength="100" class="form-control col-sm-8 col-md-9" placeholder="Title  " required />
                        </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            
                        </label>
                        <input type="text" name="TitleLocal" maxlength="100" class="form-control col-sm-8 col-md-9" required placeholder="ርዕስ  " />
                    </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Type
                            </label>
                        <select class="custom-select col-sm-8 col-md-8" asp-for="TheModel.TypeId" name="TypeId"
                                    asp-items="@(new SelectList(Model.ResourceTypes,"Id", "Name"))"></select>
                           
                        </div>

                        <div class="row form-group" style="margin-bottom:1px;">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Description
                            </label>
                        <textarea rows="4" name="Description" id="descriptionId" maxlength="800" class="form-control col-sm-8 col-md-9" required placeholder="Description  "></textarea>
                        </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            
                        </label>
                        <textarea rows="4" name="DescriptionLocal" id="descriptionLocalId" placeholder="ማብራርያ  " maxlength="800" class="form-control col-sm-8 col-md-9" required></textarea>
                    </div>
                    <div class="row form-group" style="margin-bottom:1px;">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Author
                            </label>
                        <input type="text" name="Author" maxlength="100" class="form-control col-sm-8 col-md-9" placeholder="Author  " required />
                        </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            
                        </label>
                        <input type="text" name="AuthorLocal" maxlength="100" class="form-control col-sm-8 col-md-9" required placeholder="ጸሐፊ  " />
                    </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Publication Date
                            </label>
                            <input type="month" name="PublicationDate" class="form-control col-sm-8 col-md-9" id="startDateId" required />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Url
                            </label>
                            <input type="text" name="Url" maxlength="100" class="form-control col-sm-8 col-md-9"  />
                        </div>

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Digital
                            </label>
                            <input type="file" name="upload" class="form-control col-sm-8 col-md-9" />
                        </div>

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Digital Cost
                            </label>
                            
                            <div class="input-group col-sm-7 col-md-8" style="padding-left: 0px; padding-right: 0px;">
                                <input type="number" min="0" name="DigitalCost"  class="form-control col-sm-4 col-md-4" required />
                                <div class="input-group-append">
                                    <span class="input-group-text" id="basic-addon2">Birr</span>
                                </div>
                            </div>
                        </div>

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Print (URI)
                            </label>
                            <input type="text" name="PrintUri" maxlength="100" class="form-control col-sm-8 col-md-9" />
                        </div>

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Print Cost
                            </label>
                            
                            <div class="input-group col-sm-7 col-md-8" style="padding-left: 0px; padding-right: 0px;">
                                <input type="number" min="0" name="PrintCost"  class="form-control col-sm-4 col-md-4" required />
                                <div class="input-group-append">
                                    <span class="input-group-text" id="basic-addon2">Birr</span>
                                </div>
                            </div>
                        </div>


                        <div class="row form-group">
                            <div class="col-sm-12">
                                <input type="submit" value="Save"
                                   class="btn btn-primary">

                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
@*}*@
@section script {
    <script>     
        function confirmDelete(form) {
            $.confirm({
                icon: 'fa fa-exclamation-triangle',
                title: 'Confirm!',
                content: 'Are you sure want to Delete ?',
                buttons: {
                    yes: function () {
                        form.submit();
                    },
                    no: function () {
                    }
                }
            });
            return false;
        }
    </script>
}