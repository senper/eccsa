@using ECCSA.BackOffice.Server.Model.Common
@model ECCSA.BackOffice.Server.WebApp.Areas.Communication.Model.ResourceViewModel

@{
    ViewData["Title"] = "Resources";
    Layout = Model.LayoutPage;
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <a href="@Url.Action("Index",Model.Controller,new { Area =Model.Area, module = Model.TheModel.OwnerModule})" class="btn btn-outline-info"><i class="fa fa-angle-double-left" aria-hidden="true"></i>back</a>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="row">

                        <div class="col-sm-11">

                            <h4>  @Model.TheModel.TitleFull </h4>
                        </div>
                        <div class="col-sm-1">
                            @if (Model.IsUserOrAdmin)
                            {
                                <button data-toggle="modal"
                                    data-target="#theModal"
                                    title="Edit"
                                    class=" float-right btn btn-outline-success btn-sm">
                                    <i class="fa fa-pen "></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-body">

                    <div class="row">
                        <div class="col-sm-3">
                            Type:
                        </div>
                        <div class="col-sm-9">
                            @Model.TypeName
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-3">
                            Author
                        </div>
                        <div class="col-sm-9">
                            @Model.TheModel.AuthorFull
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-3">
                            Pub. Month
                        </div>
                        <div class="col-sm-9">
                            @Model.TheModel.PublicationDate.ToString("MMMM yyyy")
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-3">
                            Online
                        </div>
                        <div class="col-sm-9">
                            @if (!string.IsNullOrEmpty(Model.TheModel.Url))
                            {
                                <a href="@Model.TheModel.Url"
                               target="_blank">
                                    @(Model.TheModel.Url)
                                </a>
                            } (@Model.TheModel.DigitalCost ETB)
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-3">
                            Digital
                        </div>
                        <div class="col-sm-9">
                            @if (!String.IsNullOrEmpty(Model.TheModel.Extension))
                            {
                                <a id="filename" asp-action="DownLoadFile" asp-controller="Resource" asp-area="Communication" asp-route-id="@Model.TheModel.Id" asp-route-type="@Model.TheModel.OwnerModule"
                               asp-route-fileName="@(Model.TheModel.Title + Model.TheModel.Extension)">
                                    @("Attachment")
                                </a>
                            }
                            else
                            {
                                @(" - ")
                            }
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-3">
                            Print
                        </div>
                        <div class="col-sm-9">
                            @Model.TheModel.PrintUri (@Model.TheModel.PrintCost ETB)
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-3">
                            Description
                        </div>
                        <div class="col-sm-9">
                            @Model.TheModel.Description
                        </div>
                    </div>
                     <div class="row">
                        <div class="col-sm-3">
                            
                        </div>
                        <div class="col-sm-9">
                            @Model.TheModel.DescriptionLocal
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body collapse show" id="detail_info">
                    <a class="profile" href="#" id="showhideDetail" data-toggle="collapse" data-target="#profile_info" aria-expanded="true" aria-controls="profile_info">
                        <strong>Profile</strong>
                    </a>
                    <div class="card collapse show" id="profile_info">
                        <div id="res_profile_info_text">
                            <div class="row">
                                <div class="col-12">
                                    <button class="btn btn-outline-success btn-sm btn-circle float-right" onclick="editProfile()">
                                        <i class="fa fa-pen "></i>
                                    </button>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12" id="profileHtml">
                                    @Html.Raw(Model.TheModel.Profile)
                                </div>
                            </div>
                        </div>
                        <div id="res_profile_info_editor" class=" d-none">
                            <form data-parsley-validate method="post" asp-action="SetProfile" asp-antiforgery="true">
                                <input type="hidden" name="id" value="@Model.TheModel.Id" />
                                <input type="hidden" name="module" value="@Model.CurrentModule" />
                                <div>
                                    <textarea id="resProfile" name="profile" placeholder="Profile ..............." cols="65" rows="10" data-sample-short>
                                        @(Model.TheModel.Profile)
                                    </textarea>
                                </div>
                                <div class="form-group ">
                                    <input type="submit" value="Save" class="btn btn-warning localize" data-key="Save">
                                    <input type="button" value="Cancel" class="btn btn-info localize " data-key="cancel" onclick="profileCancel()">
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body collapse show" id="detail_local_info">
                    <a class="profile" href="#" id="showhideLocalDetail" data-toggle="collapse" data-target="#profile_local_info" aria-expanded="true" aria-controls="profile_local_info">
                        <strong>ፕሮፋይል  </strong>
                    </a>
                    <div class="card collapse show" id="profile_local_info">
                        <div id="res_profile_local_info_text">
                            <div class="row">
                                <div class="col-12">
                                    <button class="btn btn-outline-success btn-sm btn-circle float-right" onclick="editLocalProfile()">
                                        <i class="fa fa-pen "></i>
                                    </button>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12" id="profileLocalHtml">
                                    @Html.Raw(Model.TheModel.ProfileLocal)
                                </div>
                            </div>
                        </div>
                        <div id="res_profile_local_info_editor" class=" d-none">
                            <form data-parsley-validate method="post" asp-action="SetLocalProfile" asp-antiforgery="true">
                                <input type="hidden" name="id" value="@Model.TheModel.Id" />
                                <input type="hidden" name="module" value="@Model.CurrentModule" />
                                <div>
                                    <textarea id="resLocalProfile" name="profile" placeholder="Profile ..............." cols="65" rows="10" data-sample-short>
                                        @(Model.TheModel.ProfileLocal)
                                    </textarea>
                                </div>
                                <div class="form-group ">
                                    <input type="submit" value="Save" class="btn btn-warning localize" data-key="Save">
                                    <input type="button" value="Cancel" class="btn btn-info localize " data-key="cancel" onclick="profileLocalCancel()">
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header-actions">
                    <form data-parsley-validate method="post" enctype="multipart/form-data"
                          asp-action="@("AddProfileImage")" asp-antiforgery="true">
                        <input type="hidden" name="id" value="@Model.TheModel.Id" />
                                <input type="hidden" name="module" value="@Model.CurrentModule" />
                        <input type="button" onclick="$('#selectfile').click()" id="selectFilebtn" class="btn btn-outline-success btn-sm" name="Select file" value="New" />
                        <input type="file" name="image" id="selectfile" hidden onchange="this.form.submit()" accept="image/png, image/gif, image/jpeg">
                    </form>
                </div>
                <table class="table table-bordered table-striped" id="datatblsetting">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Url</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.ProfileImages)
                        {
                            <tr>
                                <td> <img src="@r" width="30%" /> </td>
                                <td>@r</td>
                                <td>
                                    <div class="col-sm-2 btn-group" role="group" aria-label="Basic example">
                                        <a onclick="return confirmDelete($('#deleteProfileImage@(Model.ProfileImages.IndexOf(r))')[0]);"
                                       class=" btn btn-sm btn-outline-danger">
                                            <i class="fa fa-trash" aria-hidden="true"></i>
                                        </a>
                                        <form data-parsley-validate novalidate method="post" id="deleteProfileImage@(Model.ProfileImages.IndexOf(r))"
                                          asp-action="RemoveProfileImage" asp-antiforgery="true">
                                            <input type="hidden" name="id" value="@Model.TheModel.Id" />
                                <input type="hidden" name="module" value="@Model.CurrentModule" />
                                            <input type="hidden" name="fileName" value="@(r)" />
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (Model.IsUserOrAdmin)
{
    <div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="theModal">
        <div class="modal-dialog modal-md">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Resource</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form data-parsley-validate method="post" enctype="multipart/form-data"
                      asp-action="Save" asp-antiforgery="true">
                        <input type="hidden" name="Id" value="@Model.TheModel.Id" />
                        <input type="hidden" name="OwnerModule" value="@Model.CurrentModule" />

                        <div class="row form-group" style="margin-bottom:1px;">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Title
                            </label>
                            <input type="text" name="Title" asp-for="TheModel.Title" maxlength="100" class="form-control col-sm-8 col-md-9" required placeholder="Title  " />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                
                            </label>
                            <input type="text" name="TitleLocal" asp-for="TheModel.TitleLocal" maxlength="100" class="form-control col-sm-8 col-md-9" required placeholder="ርዕስ  " />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Type
                            </label>
                            <select class="custom-select col-sm-8 col-md-8" asp-for="TheModel.TypeId" name="TypeId" asp-for="TheModel.TypeId"
                                    asp-items="@(new SelectList(Model.ResourceTypes,"Id", "Name"))" required></select>
                            
                        </div>

                        <div class="row form-group" style="margin-bottom:1px;">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Description
                            </label>
                            <textarea rows="4" name="Description" asp-for="TheModel.Description" maxlength="800" class="form-control col-sm-8 col-md-9" required placeholder="Description  "></textarea>
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                
                            </label>
                            <textarea rows="4" name="DescriptionLocal" asp-for="TheModel.DescriptionLocal" maxlength="800" class="form-control col-sm-8 col-md-9" required placeholder="ማብራርያ  "></textarea>
                        </div>
                        <div class="row form-group" style="margin-bottom:1px;">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Author
                            </label>
                            <input type="text" name="Author" asp-for="TheModel.Author" maxlength="100" class="form-control col-sm-8 col-md-9" required placeholder="Author  " />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                
                            </label>
                            <input type="text" name="AuthorLocal" asp-for="TheModel.AuthorLocal" maxlength="100" class="form-control col-sm-8 col-md-9" required placeholder="ጸሐፊ  " />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Publication Month
                            </label>
                            <input type="month" name="PublicationDate" asp-for="TheModel.PublicationDate" class="form-control col-sm-8 col-md-9" id="startDateId" required />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Url
                            </label>
                            <input type="text" name="Url" asp-for="TheModel.Url" maxlength="100" class="form-control col-sm-8 col-md-9" />
                        </div>

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Digital
                            </label>
                            <input type="file" name="upload" class="form-control col-sm-8 col-md-9" />
                        </div>

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Digital Cost
                            </label>
                            <input type="number" min="0" name="DigitalCost" asp-for="TheModel.DigitalCost" class="form-control col-sm-4 col-md-4" required />Birr
                        </div>

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Print (URI)
                            </label>
                            <input type="text" name="PrintUri" maxlength="100" asp-for="TheModel.PrintUri" class="form-control col-sm-8 col-md-9" />
                        </div>

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Print Cost
                            </label>
                            <input type="number" name="PrintCost" min="0" asp-for="TheModel.PrintCost" class="form-control col-sm-4 col-md-4" />Birr
                        </div>
                        <div class="row form-group">
                            <div class="col-sm-12">
                                <input type="submit" value="Save"
                                   class="btn btn-primary">

                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section script {
<script src="~/vendor/ckeditor/ckeditor.js"></script>
<script>
    CKEDITOR.replace('resProfile', {
        height: 260,
        width: '100%',
    });
        CKEDITOR.replace('resLocalProfile', {
            height: 260,
            width: '100%',
        });
    function editProfile() {
        document.getElementById('res_profile_info_editor').classList.remove('d-none');
        document.getElementById('res_profile_info_text').classList.add('d-none');
    }
        function editLocalProfile() {
            document.getElementById('res_profile_local_info_editor').classList.remove('d-none');
            document.getElementById('res_profile_local_info_text').classList.add('d-none');
        }
    function profileCancel() {
        document.getElementById('res_profile_info_editor').classList.add('d-none');
        document.getElementById('res_profile_info_text').classList.remove('d-none');
    }
        function profileLocalCancel() {
            document.getElementById('res_profile_local_info_editor').classList.add('d-none');
            document.getElementById('res_profile_local_info_text').classList.remove('d-none');
        }

    function confirmDelete(form) {
        $.confirm({
            icon: 'fa fa-exclamation-triangle',
            title: 'Confirm!',
            content: 'Are you sure want to Delete ?',
            buttons: {
                yes: function () {
                    form.submit();
                },
                no: function () {
                }
            }
        });
        return false;
    }

    function confirmation(form, text) {
        $.confirm({
            icon: 'fa fa-exclamation-triangle',
            title: 'Confirm!',
            content: 'Are you sure want to ' + text + ' ?',
            buttons: {
                yes: function () {
                    form.submit();
                },
                no: function () {
                }
            }
        });
        return false;
    }


</script>
}
