@model ECCSA.BackOffice.Server.WebApp.Areas.Communication.Model.PressViewModel

@{
    ViewData["Title"] = Model.TheModel.MediaType.Name;
    Layout = Model.LayoutPage;
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <a href="@Url.Action("Index",Model.Controller,new { Area =Model.Area})" class="btn btn-outline-info"><i class="fa fa-angle-double-left" aria-hidden="true"></i>back</a>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="row">

                        <div class="col-sm-11">

                            <h4>  @Model.TheModel.TitleFull </h4>
                        </div>
                        <div class="col-sm-1">
                            @if (Model.IsUserOrAdmin)
                            {
                                <button data-toggle="modal"
                                    data-target="#theModal"
                                    title="Edit"
                                    class=" float-right btn btn-outline-success btn-sm">
                                    <i class="fa fa-pen "></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-body">

                    <div class="row">
                        <div class="col-sm-3">
                            Type:
                        </div>
                        <div class="col-sm-9">
                            @Model.TheModel.MediaType.Name
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-3">
                            Author
                        </div>
                        <div class="col-sm-9">
                            @Model.TheModel.AuthorNameFull
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-3">
                            Pub. Date
                        </div>
                        <div class="col-sm-9">
                            @Model.TheModel.DateCreated.ToLongDateString()
                        </div>
                    </div>



                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body collapse show" id="detail_info">
                    <a class="profile" href="#" id="showhideDetail" data-toggle="collapse" data-target="#profile_info" aria-expanded="true" aria-controls="profile_info">
                        <strong>Content</strong>
                    </a>
                    <div class="card collapse show" id="profile_info">
                        <div id="res_profile_info_text">
                            <div class="row">
                                <div class="col-12">
                                    <button class="btn btn-outline-success btn-sm btn-circle float-right" onclick="editProfile()">
                                        <i class="fa fa-pen "></i>
                                    </button>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12" id="profileHtml">
                                    @Html.Raw(Model.TheModel.Content)
                                </div>
                            </div>
                        </div>
                        <div id="res_profile_info_editor" class=" d-none">
                            <form data-parsley-validate method="post" asp-action="SetContent" asp-antiforgery="true">
                                <input type="hidden" name="id" value="@Model.TheModel.Id" />
                                <div>
                                    <textarea id="resProfile" name="Content" placeholder="Profile ..............." cols="65" rows="10" data-sample-short>
                                        @(Model.TheModel.Content)
                                    </textarea>
                                </div>
                                <div class="form-group ">
                                    <input type="submit" value="Save" class="btn btn-warning localize" data-key="Save">
                                    <input type="button" value="Cancel" class="btn btn-info localize " data-key="cancel" onclick="profileCancel()">
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body collapse show" id="detail_info_local">
                    <a class="profile" href="#" id="showhideDetailLocal" data-toggle="collapse" data-target="#profile_info_local" aria-expanded="true" aria-controls="profile_info_local">
                        <strong>ዝርዝር </strong>
                    </a>
                    <div class="card collapse show" id="profile_info_local">
                        <div id="res_profile_info_text_local">
                            <div class="row">
                                <div class="col-12">
                                    <button class="btn btn-outline-success btn-sm btn-circle float-right" onclick="editProfileLocal()">
                                        <i class="fa fa-pen "></i>
                                    </button>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12" id="profileHtmlLocal">
                                    @Html.Raw(Model.TheModel.ContentLocal)
                                </div>
                            </div>
                        </div>
                        <div id="res_profile_info_editor_local" class=" d-none">
                            <form data-parsley-validate method="post" asp-action="SetContentLocal" asp-antiforgery="true">
                                <input type="hidden" name="id" value="@Model.TheModel.Id" />
                                <div>
                                    <textarea id="resProfileLocal" name="ContentLocal" placeholder="Profile ..............." cols="65" rows="10" data-sample-short>
                                        @(Model.TheModel.ContentLocal)
                                    </textarea>
                                </div>
                                <div class="form-group ">
                                    <input type="submit" value="Save" class="btn btn-warning localize" data-key="Save">
                                    <input type="button" value="Cancel" class="btn btn-info localize " data-key="cancel" onclick="profileCancelLocal()">
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header-actions">
                    <form data-parsley-validate method="post" enctype="multipart/form-data"
                          asp-action="@("AddProfileImage")" asp-antiforgery="true">
                        <input type="hidden" name="id" value="@Model.TheModel.Id" />
                        <input type="hidden" name="module" value="@Model.CurrentModule" />
                        <input type="button" onclick="$('#selectfile').click()" id="selectFilebtn" class="btn btn-outline-success btn-sm" name="Select file" value="New" />
                        <input type="file" name="image" id="selectfile" hidden onchange="this.form.submit()" accept="image/png, image/gif, image/jpeg">
                    </form>
                </div>
                <table class="table table-bordered table-striped" id="datatblsetting">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Url</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.ProfileImages)
                        {
                            <tr>
                                <td> <img src="@r" width="30%" /> </td>
                                <td>@r</td>
                                <td>
                                    <div class="col-sm-2 btn-group" role="group" aria-label="Basic example">
                                        <a onclick="return confirmDelete($('#deleteProfileImage@(Model.ProfileImages.IndexOf(r))')[0]);"
                                       class=" btn btn-sm btn-outline-danger">
                                            <i class="fa fa-trash" aria-hidden="true"></i>
                                        </a>
                                        <form data-parsley-validate novalidate method="post" id="deleteProfileImage@(Model.ProfileImages.IndexOf(r))"
                                          asp-action="RemoveProfileImage" asp-antiforgery="true">
                                            <input type="hidden" name="id" value="@Model.TheModel.Id" />
                                            <input type="hidden" name="module" value="@Model.CurrentModule" />
                                            <input type="hidden" name="fileName" value="@(r)" />
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <hr />
    <h4>Comments</h4>
    @foreach (var comment in @Model.TheModel.Comments)
    {
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        @comment.AuthorName
                    </div>
                    <div class="card-body">
                        @comment.Text
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.IsUserOrAdmin)
{
    <div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="theModal">
        <div class="modal-dialog modal-md">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Edit Press Relese</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form data-parsley-validate method="post" enctype="multipart/form-data"
                      asp-action="Save" asp-antiforgery="true">
                        <input type="hidden" name="Id" value="@Model.TheModel.Id" />


                        <div class="row form-group"  style="margin-bottom:1px;">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Title
                            </label>
                            <input type="text" name="Title" asp-for="TheModel.Title" maxlength="100" class="form-control col-sm-9 col-md-8" required  placeholder="Title  "/>
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                
                            </label>
                            <input type="text" name="TitleLocal" asp-for="TheModel.TitleLocal" maxlength="100" class="form-control col-sm-9 col-md-8" required placeholder="ርዕስ  " />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Type
                            </label>
                            <select class="custom-select col-sm-7 col-md-8" id="statusId" asp-for="TheModel.MediaTypeId"
                                    asp-items="@(new SelectList(Model.MediaTypes,"Id", "Name", null,"GroupName"))"
                                name="MediaTypeId" required>
                            </select>
                        </div>
                        <div class="row form-group" style="margin-bottom:1px;">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Author
                            </label>
                            <input type="text" name="AuthorName" asp-for="TheModel.AuthorName" maxlength="100" class="form-control col-sm-9 col-md-8" placeholder="Author  "  />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                
                            </label>
                            <input type="text" name="AuthorNameLocal" asp-for="TheModel.AuthorNameLocal" maxlength="100" class="form-control col-sm-9 col-md-8" placeholder="ጸሐፊ  " />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Publication Date
                            </label>
                            <input type="date" name="DateCreated" asp-for="TheModel.DateCreated" class="form-control col-sm-9 col-md-8" id="startDateId" required />
                        </div>

                        <div class="row form-group">
                            <div class="col-sm-12">
                                <input type="submit" value="Save"
                                   class="btn btn-primary">

                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section script {
<script src="~/vendor/ckeditor/ckeditor.js"></script>
<script>
    CKEDITOR.replace('resProfile', {
        height: 260,
        width: '100%',
    });
        CKEDITOR.replace('resProfileLocal', {
            height: 260,
            width: '100%',
        });
    function editProfile() {
        document.getElementById('res_profile_info_editor').classList.remove('d-none');
        document.getElementById('res_profile_info_text').classList.add('d-none');
    }
        function editProfileLocal() {
            document.getElementById('res_profile_info_editor_local').classList.remove('d-none');
            document.getElementById('res_profile_info_text_local').classList.add('d-none');
        }

        function profileCancel() {
            document.getElementById('res_profile_info_editor').classList.add('d-none');
            document.getElementById('res_profile_info_text').classList.remove('d-none');
        }
    function profileCancelLocal() {
        document.getElementById('res_profile_info_editor_local').classList.add('d-none');
        document.getElementById('res_profile_info_text_local').classList.remove('d-none');
    }


    function confirmDelete(form) {
        $.confirm({
            icon: 'fa fa-exclamation-triangle',
            title: 'Confirm!',
            content: 'Are you sure want to Delete ?',
            buttons: {
                yes: function () {
                    form.submit();
                },
                no: function () {
                }
            }
        });
        return false;
    }

    function confirmation(form, text) {
        $.confirm({
            icon: 'fa fa-exclamation-triangle',
            title: 'Confirm!',
            content: 'Are you sure want to ' + text + ' ?',
            buttons: {
                yes: function () {
                    form.submit();
                },
                no: function () {
                }
            }
        });
        return false;
    }


</script>
}
