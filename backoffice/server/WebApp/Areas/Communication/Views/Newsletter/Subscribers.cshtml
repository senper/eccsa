@model ECCSA.BackOffice.Server.WebApp.Areas.Communication.Model.SubscribersViewModel
@using ECCSA.BackOffice.Server.Model.Common
@{
    ViewData["Title"] = "Newsletter ";
    Layout = Model.LayoutPage;
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4 edit">
         <div class="col-md-5" style="margin-left:15px;margin-bottom:2px;">
            <form method="get" asp-action="Subscribers">
                <div class="btn-group pull-left" role="group" aria-label="Basic example">
                    Search By &nbsp;&nbsp;<select name="TopicId" asp-for="@Model.TopicId"
                        asp-items="@(new SelectList(Model.Topics,"Id", "Name"))">
                                                  
                        <option value="@Guid.Empty"></option>
                    </select>
                    <button onclick="this.form.submit()" class=" d-none d-sm-inline-block btn btn-sm btn-outline-primary shadow-sm">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </form>

        </div>
        @if (Model.IsUserOrAdmin && Model.TopicId != Guid.Empty)
        {
            <button class="d-none d-sm-inline-block btn btn-sm btn-outline-primary shadow-sm"
                data-toggle="modal"
                data-target="#theModal"
                title="Add ECCSA Staff Subscriber "
                data-id="@Guid.Empty"
                data-status="@((int)StatusEnum.Active)"
                onclick="addEdit(this)">
                <i class="fas fa-plus fa-sm text-white-50"></i> Add Subscribers
            </button>
        }
    </div>
    <div class="row">
        <div class="col-12">

            <div class="card shadow mb-4">

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="dataTable" width="100%" cellpadding="0">
                            <thead>
                                <tr>
                                    <th>Full Name</th>
                                    
                                    <th>Email</th>
                                    <th>Mobile</th>
                                    <th>Date Subscribed</th>
                                    <th>Date Unsubscribed</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th>Full Name</th>
                                    
                                    <th>Email</th>
                                    <th>Mobile</th>
                                    <th>Date Subscribed</th>
                                    <th>Date Unsubscribed</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                            <tbody>
                                @foreach (var i in Model.TheList)
                                {


                                    <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => i.FullName)
                                        </td>
                                          <td>
                                            @i.Email
                                        </td>
                                        <td>
                                            @i.MobileNo
                                        </td>
                                        <td>
                                            @i.SubscriptionDate.ToString("yyyy-MM-dd")
                                        </td>
                                        <td>
                                            @if (i.UnsubscriptionDate.HasValue)
                                            {
                                                <text>@i.UnsubscriptionDate.Value.ToString("yyyy-MM-dd")</text>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group" aria-label="Basic example">
                                                @if (i.IsStaff)
                                                {
                                                    <a onclick="return confirmDelete($('#deleteLabel@(Model.Guid2String(i.Id))')[0]);"
                                                       class=" btn btn-sm btn-outline-danger">
                                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                                    </a>
                                                    <form data-parsley-validate novalidate method="post" id="deleteLabel@(Model.Guid2String(i.Id))"
                                                          asp-action="UnSubscribe" asp-antiforgery="true">
                                                        <input type="hidden" name="userId" value="@i.UserId" />
                                                        <input type="hidden" name="topicId" value="@i.TopicId" />
                                                    </form>
                                                }
                                               
                                            </div>


                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@if (Model.IsUserOrAdmin && Model.TopicId != Guid.Empty)
{
    <div class="modal fade" tabindex="-1"
     role="dialog" aria-hidden="true" id="theModal">
        <div class="modal-dialog modal-md">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Newsletter </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form data-parsley-validate method="post" 
                      asp-action="Subscribe" asp-antiforgery="true">
                      <input type="hidden" name="TopicId" value="@Model.TopicId" />

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                User
                            </label>
                            <select class="custom-select col-sm-8 col-md-9" name="UserId" 
                                    asp-items="@(new SelectList(Model.Users,"Id", "FullName"))"></select>
                        </div>
                        
                      
                        <div class="row form-group">
                            <div class="col-sm-12">
                                <input type="submit" value="Subscribe"
                                   class="btn btn-primary">

                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
}
@section script {
<script>

    function confirmDelete(form) {
        $.confirm({
            icon: 'fa fa-exclamation-triangle',
            title: 'Confirm!',
            content: 'Are you sure want to Delete ?',
            buttons: {
                yes: function () {
                    form.submit();
                },
                no: function () {
                }
            }
        });
        return false;
    }
</script>
}