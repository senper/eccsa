@using ECCSA.BackOffice.Server.Model.Common
@model ECCSA.BackOffice.Server.WebApp.Areas.Communication.Model.MediaAgencyViewModel

@{
    ViewData["Title"] = "Media Agencies";
    Layout = "~/Views/Shared/_CommunicationLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4 edit">
        @if (Model.IsUserOrAdmin)
        {
            <button class="d-none d-sm-inline-block btn btn-sm btn-outline-primary shadow-sm"
                data-toggle="modal"
                data-target="#theModal"
                title="Add New Media Agency"
                data-id="@Guid.Empty"
                data-name=""
                data-mediatype="0"
                data-ownership="0"
                data-repname=""
                data-pername=""
                data-email=""
                data-mobile=""
                data-telephone=""
                data-url=""
                data-description=""
                data-remark=""
                data-status="@((int)StatusEnum.Active)"
                onclick="addEdit(this)">
            <i class="fas fa-plus fa-sm text-white-50"></i> Create New
        </button>
        }
    </div>
    <div class="row">
        <div class="col-12">

            <div class="card shadow mb-4">
                @*<div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">DataTables Example</h6>
                    </div>*@
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="dataTable" width="100%" cellpadding="0">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Representative</th>
                                    <th>Person</th>
                                    <th>Email</th>
                                    <th>Mobile</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th>Name</th>
                                    <th>Representative</th>
                                    <th>Person</th>
                                    <th>Email</th>
                                    <th>Mobile</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                            <tbody>
                                @foreach (var i in Model.TheList)
                                {
                                    var statusClass = (i.Status == 0 ? "danger" : "");

                                    <tr class="@statusClass">
                                        <td>
                                            <a asp-controller="@Model.Controller" asp-action="Detail" asp-route-id="@i.Id" class="title @statusClass">@Html.DisplayFor(modelItem => i.Name)</a>
                                        </td>
                                        
                                        <td>
                                            @Html.DisplayFor(modelItem => i.RepresentativeName)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => i.ResponsiblePersonnel)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => i.Email)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => i.Mobile)
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group" aria-label="Basic example">
                                               
                                                <a class=" btn btn-sm  btn-outline-info" asp-controller="@Model.Controller" asp-action="Detail" asp-route-id="@i.Id">
                                                    <i class="fa fa-info" aria-hidden="true"></i>
                                                </a>

                                            </div>


                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@if (Model.IsUserOrAdmin)
{
    <div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="theModal">
        <div class="modal-dialog modal-md">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Create/Edit Media Agent</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form data-parsley-validate novalidate method="post"
                      asp-action="Save" asp-antiforgery="true" onsubmit="return validateMediaAgency()">
                        <input type="hidden" name="Id" id="id" />

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Name
                            </label>
                            <input type="text" name="Name" id="nameId" maxlength="100" class="form-control col-sm-8 col-md-9" required />
                        </div>
                         
                        <div class="row form-group" style="padding: 10px;">
                            <label class="col-sm-4 col-md-3 col-form-label" style="padding: 1px;">
                                Media Type
                            </label>
                            <div class="col col-md-3" style="padding-left: 20px;">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="idBroadcast" name="BroadcastMedia" asp-for="TheModel.BroadcastMedia" title="TV, Radio (FM/AM/SW)">
                                    <label class="form-check-label" for="idBroadcast">Broadcast</label>
                                </div>
                            </div>
                            <div class="col col-md-3" style="padding-left: 20px;">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="idPrint" name="PrintMedia" asp-for="TheModel.PrintMedia"/>
                                    <label class="form-check-label" for="idPrint">Print</label>
                                </div>
                            </div>
                            <div class="col col-md-3" style="padding-left: 20px;">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="idDigital" name="DigitalMedia" asp-for="TheModel.DigitalMedia" title="website, facebook, twitter,...">
                                    <label class="form-check-label" for="idDigital">Digital</label>
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="row form-group">

                            <label class="col-sm-5 col-md-4 col-form-label">
                                Ownership Type
                            </label>
                            <select class="custom-select col-sm-7 col-md-8" id="statusId"
                                asp-items="@(Html.GetEnumSelectList<ECCSA.BackOffice.Server.Model.Communication.MediaAgencyOwnershipType>())"
                                name="OwnershipType" required>

                            </select>
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Description
                            </label>
                            <textarea rows="4" name="Description" id="descriptionId" maxlength="800" class="form-control col-sm-8 col-md-9" required></textarea>
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Remark
                            </label>
                            <textarea rows="4" name="Remark" id="remarkId" maxlength="800" class="form-control col-sm-8 col-md-9" required></textarea>
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Rep. Name
                            </label>
                            <input type="text" maxlength="100" class="form-control col-sm-8 col-md-9" name="RepresentativeName" id="repNameId" required />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Contact Person
                            </label>
                            <input type="text" maxlength="100" class="form-control col-sm-8 col-md-9" name="ResponsiblePersonnel" id="idpername" required />
                        </div>

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Email
                            </label>
                            <input type="email" class="form-control col-sm-8 col-md-9" name="email" id="idemail"  required />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Mobile
                            </label>
                            <input type="tel" placeholder="09xxxx" class="form-control col-sm-8 col-md-9" name="Mobile" id="idmobile" required />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Telephone
                            </label>
                            <input type="tel" class="form-control col-sm-8 col-md-9" name="Telephone" id="idtelephone" required />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Url
                            </label>
                            <input type="url" placeholder="http[s]://www.xxx.yy" class="form-control col-sm-8 col-md-9" name="Url" id="idurl" required />
                        </div>

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Status
                            </label>
                            <select class="custom-select col-sm-8 col-md-9" id="statusId" name="Status" required>
                                <option value="1">Active</option>
                                <option value="0">In-active</option>
                            </select>
                        </div>

                        <div class="row form-group">
                            <div class="col-sm-12">
                                <input type="submit" value="Save"
                                   class="btn btn-primary">

                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section script {
     <script src="~/js/confirmation.js"></script>
     <script src="~/js/validation.js"></script>
    <script src="~/js/mediaAgencyValidation.js"></script>
    <script>

        function confirmDelete(form) {
            $.confirm({
                icon: 'fa fa-exclamation-triangle',
                title: 'Confirm!',
                content: 'Are you sure want to Delete ?',
                buttons: {
                    yes: function () {
                        form.submit();
                    },
                    no: function () {
                    }
                }
            });
            return false;
        }

        function addEdit(e) {
            const id = document.getElementById("id");
            const name = document.getElementById("nameId");
            const description = document.getElementById("descriptionId");
            const remark = document.getElementById("remarkId");

            const repname = document.getElementById("repNameId");


            const pername = document.getElementById("idpername");

            const email = document.getElementById("idemail");
            const mobile = document.getElementById("idmobile");

            const telephone = document.getElementById("idtelephone");
            const url = document.getElementById("idurl");


            const broadcast = document.getElementById("idBroadcast");

            const print = document.getElementById("idPrint");
            const digital = document.getElementById("idDigital");


            const idVal = $(e).attr('data-id');
            const nameVal = $(e).attr("data-name");
            const descriptionVal = $(e).attr("data-description");
            const mediatypeVal = Number($(e).attr("data-mediatype"));
            const ownershipVal = $(e).attr("data-ownership");
            const repnameVal = $(e).attr("data-repname");

            const pernameVal = $(e).attr("data-pername");

            const emailVal = $(e).attr("data-email");
            const mobileVal = $(e).attr("data-mobile");

            const telephoneVal = $(e).attr("data-telephone");
            const urlVal = $(e).attr("data-url");
            const remarkVal = $(e).attr("data-remark");
            const statusVal = $(e).attr("data-status");

            id.value = idVal;
            name.value = nameVal;
            description.value = descriptionVal;
            remark.value = remarkVal;
        
            repname.value = repnameVal;
            pername.value = pernameVal;
            email.value = emailVal;
            mobile.value = mobileVal;
            telephone.value = telephoneVal;
            url.value = urlVal;
            $('#ownershipId').val(ownershipVal).change();
            $('#statusId').val(statusVal).change();

            const digitalType = Number(@((int)ECCSA.BackOffice.Server.Model.Communication.MediaTypeFlag.Digital));
            const broadcastType = Number(@((int)ECCSA.BackOffice.Server.Model.Communication.MediaTypeFlag.Broadcast));
            const printType = Number(@((int)ECCSA.BackOffice.Server.Model.Communication.MediaTypeFlag.Print));

            broadcast.checked = (mediatypeVal & broadcastType) == broadcastType;
            print.checked = (mediatypeVal & printType) == printType;
            digital.checked = (mediatypeVal & digitalType) == digitalType;
        }
    </script>
}