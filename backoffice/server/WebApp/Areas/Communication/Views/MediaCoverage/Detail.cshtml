@model ECCSA.BackOffice.Server.WebApp.Areas.Communication.Model.MediaCoverageViewModel

@{
    ViewData["Title"] = "Media Coverage";
    Layout = "~/Views/Shared/_CommunicationLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <a href="@Url.Action("Index",Model.Controller,new { Area =Model.Area})" class="btn btn-outline-info"><i class="fa fa-angle-double-left" aria-hidden="true"></i>back</a>
    </div>
    <div class="row">

        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="row">

                        <div class="col-sm-11">

                            <h4>  @Model.TheModel.About </h4>
                        </div>
                        <div class="col-sm-1">
                            @if (Model.IsUserOrAdmin)
                            {
                                <button data-toggle="modal"
                                    data-target="#theModal"
                                    title="Edit"
                                    class=" float-right btn btn-outline-success btn-sm">
                                    <i class="fa fa-pen "></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-body">

                    <div class="row">
                        <div class="col-sm-4">
                            Agency:
                        </div>
                        <div class="col-sm-8">
                            @Model.TheModel.MediaAgency.Name
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4">
                            Covered In
                        </div>
                        <div class="col-sm-8">
                            @Model.TheModel.CoveredIn
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4">
                            Frequency
                        </div>
                        <div class="col-sm-8">
                            @Model.TheModel.Frequency
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4">
                            From
                        </div>
                        <div class="col-sm-8">
                            @Model.TheModel.StartDate.ToLongDateString()
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-4">
                            Until
                        </div>
                        <div class="col-sm-8">
                            @Model.TheModel.EndDate.ToLongDateString()
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4">
                            Remark
                        </div>
                        <div class="col-sm-8">
                            @Model.TheModel.Remark
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.AttachmentPath))
                    {
                        <div class="row">
                            <div class="col-sm-4">
                                Attachment
                            </div>
                            <div class="col-sm-8">
                                <a href="@Url.Action("DownLoadFile","MediaCoverage",new { Area ="Communication", id=@Model.TheModel.Id})" target="_blank">Download</a>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>

    </div>

</div>

@if (Model.IsUserOrAdmin)
{
    <div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="theModal">
        <div class="modal-dialog modal-md">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Media Coverage</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form data-parsley-validate novalidate method="post" enctype="multipart/form-data"
                      asp-action="Save" asp-antiforgery="true"  onsubmit="return valideCoverage()">
                        <input type="hidden" name="Id" value="@Model.TheModel.Id" />

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Media Agency
                            </label>
                            <select name="MediaAgencyId" class="custom-select col-sm-8 col-md-9" asp-for="TheModel.MediaAgencyId"
                                asp-items="@(new SelectList(Model.Agencies,"Id", "Name"))" required></select>
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Start Date
                            </label>
                            <input type="date" class="form-control col-sm-8 col-md-9" name="startDate" id="startDateId" asp-for="TheModel.StartDate" required />
                        </div>

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                End Date
                            </label>
                            <input type="date" class="form-control col-sm-8 col-md-9" name="endDate" id="endDateId"  asp-for="TheModel.EndDate" required />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Duration
                            </label>
                            <div class="input-group-append  col-sm-8 col-md-5" style="padding-left: 0px;">
                                <input type="number" min="0" title="Duration in minutes. For broadcast media. 0 for the others" max="3600" name="DurationMinutes" asp-for="TheModel.DurationMinutes" class="form-control col-sm-8 col-md-9" required />

                                <span class="input-group-text" id="basic-addon2">Min.</span>
                            </div>
                            
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Frequency
                            </label>
                            <input type="text" name="Frequency" title="Number of times during the specified period. E.g. Once per day, " asp-for="TheModel.Frequency" maxlength="50" class="form-control col-sm-8 col-md-9" required />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Covered In
                            </label>
                            <input type="text" name="CoveredIn" title="Website, news, documentary, blog,..." asp-for="TheModel.CoveredIn" maxlength="50" class="form-control col-sm-8 col-md-9" required />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                About
                            </label>
                            <textarea name="About"   asp-for="TheModel.About"  title="write the content that was covered" rows="4" maxlength="300" class="form-control col-sm-8 col-md-9" required></textarea>
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">Material</label>
                            <input accept="*/*" type="file" name="Material" class="form-control-file form-control col-sm-8 col-md-8" />
                            <input type="hidden" name="Extension" asp-for="TheModel.Extension" />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Remark
                            </label>
                            <textarea rows="4" name="Remark" asp-for="TheModel.Remark" maxlength="800" class="form-control col-sm-8 col-md-9" required></textarea>
                        </div>

                        <div class="row form-group">
                            <div class="col-sm-12">
                                <input type="submit" value="Save"
                                   class="btn btn-primary">

                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section script {
    <script>


        function confirmDelete(form) {
            $.confirm({
                icon: 'fa fa-exclamation-triangle',
                title: 'Confirm!',
                content: 'Are you sure want to Delete ?',
                buttons: {
                    yes: function () {
                        form.submit();
                    },
                    no: function () {
                    }
                }
            });
            return false;
        }

        function confirmation(form, text) {
            $.confirm({
                icon: 'fa fa-exclamation-triangle',
                title: 'Confirm!',
                content: 'Are you sure want to ' + text + ' ?',
                buttons: {
                    yes: function () {
                        form.submit();
                    },
                    no: function () {
                    }
                }
            });
            return false;
        }


    </script>
}
