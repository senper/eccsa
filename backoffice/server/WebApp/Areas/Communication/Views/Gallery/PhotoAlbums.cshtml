@model ECCSA.BackOffice.Server.WebApp.Areas.Communication.Model.PhotoAlbumViewModel
@using ECCSA.BackOffice.Server.Model.Common
@{
    ViewData["Title"] = "Photo Albums";
    Layout = Model.LayoutPage;
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4 edit">
       @* @if (Model.IsUserOrAdmin)
        {*@
            <button class="d-none d-sm-inline-block btn btn-sm btn-outline-primary shadow-sm"
                data-toggle="modal"
                data-target="#theModal"
                title="Add New Media Agency"
                data-id="@Guid.Empty"
                data-status="@((int)StatusEnum.Active)"
                onclick="addEdit(this)">
            <i class="fas fa-plus fa-sm text-white-50"></i> Create New
        </button>
        @*}*@
    </div>
    <div class="row">
        <div class="col-12">

            <div class="card shadow mb-4">
                @*<div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">DataTables Example</h6>
                    </div>*@
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="dataTable" width="100%" cellpadding="0">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Description</th>                                    
                                    <th></th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th>Title</th>
                                    <th>Description</th> 
                                    <th></th>
                                </tr>
                            </tfoot>
                            <tbody>
                                @foreach (var i in Model.TheList)
                                {
                                    

                                    <tr >
                                        <td>
                                            <a asp-controller="@Model.Controller" asp-action="PhotoAlbumDetail" 
                                            asp-route-id="@i.Id" class="title">@Html.DisplayFor(modelItem => i.Title)</a>
                                        </td>

                                        <td>
                                            @Html.DisplayFor(modelItem => i.Description)
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group" aria-label="Basic example">
                                               
                                                <a class=" btn btn-sm  btn-outline-info" asp-controller="@Model.Controller" asp-action="PhotoAlbumDetail" asp-route-id="@i.Id" >
                                                    <i class="fa fa-info" aria-hidden="true"></i>
                                                </a>
                                                @if (!i.HasFiles())
                                                {
                                                    <a onclick="return confirmDelete($('#deleteAlbum@(i.Id)')[0]);"
                                                                   class=" btn btn-sm btn-outline-danger">
                                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                                    </a>
                                                    <form data-parsley-validate novalidate method="post" id="deleteAlbum@(i.Id)"
                                                                      asp-action="DeleteAlbum" asp-antiforgery="true" asp-route-id="@i.Id">
                                                        <input type="hidden" name="id" value="@i.Id" />
                                                    </form>
                                                }
                                            </div>


                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@*@if (Model.IsUserOrAdmin)
{*@
    <div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="theModal">
        <div class="modal-dialog modal-md">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Photo Album</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form data-parsley-validate  method="post" enctype="multipart/form-data"
                      asp-action="SavePhotoAlbum" asp-antiforgery="true">
                        <input type="hidden" name="Id" value="@Guid.Empty" />
                        <input type="hidden" name="OwnerModule" value="@Model.CurrentModule" />

                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Title
                            </label>
                            <input type="text" name="Title" maxlength="50" class="form-control col-sm-9 col-md-8" required />
                        </div>
                        <div class="row form-group">
                            <label class="col-sm-4 col-md-3 col-form-label">
                                Description
                            </label>
                            <textarea rows="4" name="Description" id="descriptionId" maxlength="800" class="form-control col-sm-9 col-md-8" required></textarea>
                        </div>
                        <div class="row form-group">
                            <div class="col-sm-12">
                                <input type="submit" value="Save"
                                   class="btn btn-primary">

                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
@*}*@
@section script {
    <script>     
        function confirmDelete(form) {
            $.confirm({
                icon: 'fa fa-exclamation-triangle',
                title: 'Confirm!',
                content: 'Are you sure want to Delete ?',
                buttons: {
                    yes: function () {
                        form.submit();
                    },
                    no: function () {
                    }
                }
            });
            return false;
        }
    </script>
}