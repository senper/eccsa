@using ECCSA.BackOffice.Server.Model.Common
@model ECCSA.BackOffice.Server.WebApp.Areas.Administration.Model.UserAdministrationViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    Layout = Model.LayoutPage;
}

<div class="container-fluid">

    <div class="row d-sm-flex align-items-center justify-content-between" style="margin-left:15px;margin-bottom:2px;">
        <div class="col-md-5" style="margin-left:15px;margin-bottom:2px;">
        </div>
        <div class="col-md-6" role="group" aria-label="Basic example">
            @if (Model.RoleLevel == RoleLevelEnum.Admin)
            {
                <div class="btn-group  float-right" role="group" aria-label="Basic example">
                    <button class=" d-none d-sm-inline-block btn btn-sm btn-outline-primary shadow-sm"
                        data-toggle="modal"
                        data-target="#createUserModal"
                        title="Create Backoffice User">
                        <i class="fas fa-plus fa-sm "></i> Create User
                    </button>
                </div>
            }
        </div>
    </div>
    <div class="row">
        <div class="col-12">

            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Back Office Users</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="dataTable" width="100%" cellpadding="0">
                            <thead>
                                <tr>
                                    <th>User Name</th>
                                    <th>Full Name </th>
                                    <th>Default</th>
                                    <th>Fails</th>

                                    <th></th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th>User Name</th>
                                    <th>Full Name </th>
                                    <th>Default</th>
                                    <th>Fails</th>

                                    <th></th>
                                </tr>
                            </tfoot>
                            <tbody>
                                @foreach (var u in Model.TheList)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="UserAdministration" asp-action="Detail" asp-route-id="@u.Id" class="title ">
                                                @u.UserName
                                            </a>
                                        </td>
                                        <td>@u.FullName</td>
                                        <td>@u.DefaultModule.GetDisplayName()</td>
                                        <td>@u.AccessFailedCount</td>
                                        <td>
                                            <div class="btn-group" role="group" aria-label="Basic example">
                                                <a class=" btn btn-sm  btn-outline-info" asp-controller="UserAdministration" asp-action="Detail" asp-route-id="@u.Id">
                                                    <i class="fa fa-info" aria-hidden="true"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>



</div>


<div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" id="createUserModal">
    <div class="modal-dialog modal-md">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Create User</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form data-parsley-validate method="post"
                      asp-action="Create" asp-antiforgery="true" onsubmit="return validateUser()">
                    <input type="hidden" name="Id" value="@Guid.Empty" />

                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            User Name
                        </label>
                        <input type="text" maxlength="50" name="UserName" value="@Model.TheModel.UserName" class="form-control col-sm-8 col-md-9" required />
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Full Name
                        </label>
                        <input type="text" maxlength="150" id="fullNameId" name="FullName" value="@Model.TheModel.FullName" class="form-control col-sm-8 col-md-9" required />
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Title
                        </label>
                        <input type="text" maxlength="150" id="title" name="Title" value="@Model.TheModel.Title" class="form-control col-sm-8 col-md-9" required />
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Email
                        </label>
                        <input type="email" maxlength="50" id="emailId" name="Email" value="@Model.TheModel.Email" class="form-control col-sm-8 col-md-9" required />
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Mobile
                        </label>
                        <input type="tel" maxlength="50" id="mobileNoId" name="MobileNo" value="@Model.TheModel.MobileNo" class="form-control col-sm-8 col-md-9" required />
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Password
                        </label>
                        <input type="password" maxlength="50" id="passwordId" name="Password" value="@Model.TheModel.Password" class="form-control col-sm-8 col-md-9" required />
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Confirm Password
                        </label>
                        <input type="password" maxlength="50" id="confirmpasswordId" class="form-control col-sm-8 col-md-9" required />
                    </div>
                    <div class="row form-group">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Assigned To
                        </label>
                        <select class="custom-select col-sm-8 col-md-9" name="DefaultModule" asp-for="TheModel.DefaultModule"
                        onchange="defaultModuleChange(this)"
                                asp-items="@(new SelectList(Model.AllModules,"Id", "Name"))"></select>

                    </div>
                    <div class="row form-group d-none" id="forSupportRow">
                        <label class="col-sm-4 col-md-3 col-form-label">
                            Support Unit
                        </label>
                        <select class="custom-select col-sm-8 col-md-9" name="DepartmentId" asp-for="TheModel.DepartmentId"
                                id="departmentId"
                                asp-items="@(new SelectList(Model.SupportingUnits,"Value", "Name"))">
                            <option value="">Select Support Unit</option>
                            </select>

                    </div>

                    <div class="row form-group">
                        <div class="col-sm-12">
                            <input type="submit" value="Save" class="btn btn-primary">

                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section script {

<script src="~/js/confirmation.js"></script>
<script src="~/js/validation.js"></script>
<script>

        function defaultModuleChange(input) {
            if ($(input).val() == '@((int)ECCSAModuleFlag.Support)') {
                $("#forSupportRow").removeClass("d-none");
            } else {
                $("#forSupportRow").addClass("d-none");
                $("#departmentId").val("");
            }
        }

        function validateUser() {
            if($("#passwordId").val() != $("#confirmpasswordId").val())
            {
                $.alert({
                        icon: 'fa fa-bell',
                        title: 'Information!',
                        content: 'Password & Confirm Password are different'
                    });
                    return false;
            }
        const isValidPassword = isPassword("passwordId");
        const isValidFullName = is_validate_name("fullNameId");
        const isValidEmail = is_validate_email("emailId");
        const isValidMobile = is_validate_mobile("mobileNoId");

        return isValidPassword && isValidFullName && isValidEmail && isValidMobile;

    }

</script>
}
