@model ECCSA.BackOffice.Server.WebApp.Models.BaseViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = Model.LayoutPage;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">

            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Change Password</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <form id="changePasswordfrm" data-parsley-validate method="post" asp-action="SavePasswordChange">
                                <input type="hidden" name="module" value="@Model.CurrentModule" />
                                <div class="form-group">
                                    <label>Old Password</label>
                                    <input type="password" name="OldPassword" id="oldPassword" class="form-control" required />
                                </div>
                                <div class="form-group">
                                    <label>New Password</label>
                                    <input type="password" name="NewPassword" id="newPassword" class="form-control" required />
                                </div>
                                <div class="form-group">
                                    <label>Confirm Password</label>
                                    <input type="password" name="ConfirmPassword" id="confirmPassword" class="form-control" required />
                                </div>
                                <input type="submit"
                                        onclick="return validateForm();"
                                        class="btn btn-primary"
                                    value="Update password"
                                />
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section script {
<script src="~/js/confirmation.js"></script>
<script src="~/js/validation.js"></script>

<script type="text/javascript">
    function validateForm() {
        if(!isPassword("oldPassword") || !isPassword("newPassword") || !isPassword("confirmPassword")){
            return false;
        }
        if($("#newPassword").val() == $("#confirmPassword").val()){
            return confirmation($("#changePasswordfrm")[0], "change password");
        } else {
            $.alert({
                    icon: 'fa fa-bell',
                    title: 'Information!',
                    content: 'New Password & Confirm Password are different'
                });
                return false;
        }
    }
</script>
}